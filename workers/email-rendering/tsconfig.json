{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "worker-staging.d.ts",
    "worker-production.d.ts"
  ]
}
