{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "banner-engine-cloud-control",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "BANNER_ENGINE_CLOUD_ENABLED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "BANNER_ENGINE_CONTROL", "class_name": "CloudExecutionObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CloudExecutionObject"] }],
  "services": [{
    "binding": "BANNER_ENGINE_ADAPTER",
    "service": "banner-engine-cloud-control",
    "entrypoint": "UnconfiguredCloudAdapter"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
