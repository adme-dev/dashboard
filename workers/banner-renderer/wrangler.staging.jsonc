{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "banner-renderer-staging",
  "main": "dist/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "browser": {
    "binding": "BROWSER"
  },
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "BANNER_RENDER_ENVIRONMENT": "staging",
    "BANNER_RENDER_APP_ORIGINS": "[]",
    "BANNER_RENDER_ASSET_ORIGINS": "[]"
  },
  "account_id": "a5b299b3ad15c1b5b895dc66f9357b17"
}
