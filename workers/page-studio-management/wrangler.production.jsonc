{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xeroflow-page-studio-management-production",
  "account_id": "a5b299b3ad15c1b5b895dc66f9357b17",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PAGE_STUDIO_RELEASE_ENVIRONMENT": "production",
    "PAGE_STUDIO_CLOUDFLARE_ACCOUNT_ID": "a5b299b3ad15c1b5b895dc66f9357b17",
    "PAGE_STUDIO_CLOUDFLARE_ZONE_ID": "8e38cbf3910d291dd218710296661073",
    "PAGE_STUDIO_CUSTOM_HOSTNAME_TARGET": "sites.xeroflow.io",
    "PAGE_STUDIO_DOMAIN_IDENTITY_MODE": "standard",
    "PAGE_STUDIO_CMS_STAGING_ACTION_RUNTIME_DIGEST": "c67adbab33650675260b6acba1dfa7413207796cb2bc5f56dd24d6eeaf55075e",
    "PAGE_STUDIO_CMS_STAGING_OBJECT_TRANSPORT": "placed-fetch"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "90228af3e2cc461bbc09accc3b47bd9f"
    }
  ],
  "triggers": {
    "crons": []
  },
  "r2_buckets": [
    {
      "binding": "PAGE_STUDIO_CHECKPOINTS",
      "bucket_name": "xeroflow-page-studio-checkpoints"
    },
    {
      "binding": "PAGE_STUDIO_CMS_STAGING_CHECKPOINTS",
      "bucket_name": "xeroflow-page-studio-checkpoints-staging"
    }
  ],
  "services": [
    {
      "binding": "PAGE_STUDIO_CLIENT_STAGING",
      "service": "xeroflow-page-studio-client-staging"
    },
    {
      "binding": "PAGE_STUDIO_CONTENT_ROUTER",
      "service": "xeroflow-content-router-production"
    },
    {
      "binding": "PAGE_STUDIO_CMS_STAGING_CONTENT_ROUTER",
      "service": "xeroflow-content-router-staging"
    }
  ],
  "tsconfig": "tsconfig.json"
}
