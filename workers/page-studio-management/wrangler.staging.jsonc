{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xeroflow-page-studio-management-staging",
  "account_id": "a5b299b3ad15c1b5b895dc66f9357b17",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PAGE_STUDIO_RELEASE_ENVIRONMENT": "staging",
    "PAGE_STUDIO_CMS_OBJECT_TRANSPORT": "placed-fetch",
    "PAGE_STUDIO_ACTION_RUNTIME_DIGEST": "c67adbab33650675260b6acba1dfa7413207796cb2bc5f56dd24d6eeaf55075e"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "3865ea5568234fc7b0e9e3e595a30286"
    }
  ],
  "triggers": {
    "crons": []
  },
  "r2_buckets": [
    {
      "binding": "PAGE_STUDIO_CHECKPOINTS",
      "bucket_name": "xeroflow-page-studio-checkpoints-staging"
    }
  ],
  "tsconfig": "tsconfig.json",
  "services": [
    {
      "binding": "PAGE_STUDIO_CONTENT_ROUTER",
      "service": "xeroflow-content-router-staging"
    }
  ]
}
