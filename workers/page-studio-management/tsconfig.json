{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "~~/server/utils/db": [
        "workers/page-studio-management/src/cmsDatabase.ts"
      ],
      "~~/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "worker-staging.d.ts",
    "worker-production.d.ts"
  ]
}
