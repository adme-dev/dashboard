{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xeroflow-email-design-staging",
  "account_id": "a5b299b3ad15c1b5b895dc66f9357b17",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "vars": {
    "EMAIL_DESIGN_ENVIRONMENT": "staging",
    "PAGE_STUDIO_RELEASE_ENVIRONMENT": "staging",
    "FIGFLOW_EDM_DRAFT_SAVES_ENABLED": "false",
    "EMAIL_DESIGN_SESSION_AUTHORITY": "pages-auth-me-v1"
  },
  "services": [
    {
      "binding": "EMAIL_RENDERER",
      "service": "xeroflow-email-rendering-staging",
      "entrypoint": "EmailRenderer"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3865ea5568234fc7b0e9e3e595a30286"
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "3865ea5568234fc7b0e9e3e595a30286"
    }
  ],
  "kv_namespaces": []
}
