{
  "name": "@xeroflow/email-design",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "node ../../node_modules/nitropack/dist/cli/index.mjs build && node build.mjs",
    "test:admission": "node --import tsx test-admission.mjs",
