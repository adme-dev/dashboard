{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "search-authority-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "PUBLICATIONS",
      "bucket_name": "agency-search-authority-publications",
      "preview_bucket_name": "agency-search-authority-publications-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
