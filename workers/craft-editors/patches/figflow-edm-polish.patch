+//! EDM-only native chrome. The canonical bridge remains the final authority;
+//! this UI boundary prevents offering canvas operations it cannot round-trip.
+use egui::{Id, Ui};
+use serde_json::{Value, json};
+
+use crate::{FigApp, a11y, canvas, edm_panel, render_worker, shortcuts, theme::Tokens};
+
+const BLOCK: &str = "xeroflow.edm.blockId";
+const ROLE: &str = "xeroflow.edm.role";
+const NOTICE: &str = "Use the email controls for edits; return to XeroFlow to apply changes.";
+
+pub(crate) fn active(app: &FigApp) -> bool {
+    app.session.ds().is_ok_and(|ds| ds.edm.is_some() || ds.edm_designer.is_some())
+}
+
+/// No prefix wildcards: new generic commands must not become available by accident.
+pub(crate) fn allowed(app: &FigApp, id: &str, params: &Value) -> bool {
+    if !active(app) {
+        return true;
+    }
+    match id {
+        "edm_import" | "edm_snapshot" | "edm_required_snapshot_images" | "edm_designer_import" | "edm_designer_apply"
+        | "edm_designer_snapshot" | "edm_designer_context" | "edm_designer_undo" | "edm_designer_redo"
+        | "select.set" | "select.all" | "select.none" | "select.parent" | "select.children" | "select.next" | "select.previous"
+        | "view.pan" | "view.zoomIn" | "view.zoomOut" | "view.zoomAt" | "view.zoomFit" | "view.zoom100" | "view.zoomSelection"
+        | "edit.undo" | "edit.redo" => true,
+        "tool.set" => params.as_object().is_some_and(|p| {
+            p.len() == 1 && matches!(p.get("tool").and_then(Value::as_str), Some("move" | "hand"))
+        }),
+        "node.set" => content_edit_allowed(app, params),
+        _ => false,
+    }
+}
+
+fn content_edit_allowed(app: &FigApp, params: &Value) -> bool {
+    let Ok(ds) = app.session.ds() else { return false };
+    // Designer mutations must use its typed canonical operation log.
+    if ds.edm_designer.is_some() {
+        return false;
+    }
+    let Some(handoff) = ds.edm.as_ref() else { return false };
+    let Some(p) = params.as_object().filter(|p| p.len() == 2) else { return false };
+    let Some(ids) = p.get("ids").and_then(Value::as_array).filter(|ids| ids.len() == 1) else { return false };
+    let Some(id) = figcraft_engine::params::id_of(&ids[0]) else { return false };
+    let Some(node) = ds.doc.node(id) else { return false };
+    let Some(block) = node.plugin_data.get(BLOCK) else { return false };
+    let role = node.plugin_data.get(ROLE).map(String::as_str);
+    let Some(props) = p.get("props").and_then(Value::as_object).filter(|p| p.len() == 1) else { return false };
+    if let Some(text) = props.get("characters") {
+        return matches!(role, Some("text" | "button.text")) && !node.locked && text.is_string() && handoff.allows(block, "text");
+    }
+    let Some(metadata) = props.get("pluginData").and_then(Value::as_object).filter(|m| !m.is_empty()) else { return false };
+    metadata.iter().all(|(key, value)| {
+        let field = match (role, key.as_str()) {
+            (Some("image" | "button"), "xeroflow.edm.url") => "url",
+            (Some("image"), "xeroflow.edm.alt") => "alt",
+            (Some("image"), "xeroflow.edm.linkHref") => "linkHref",
+            _ => return false,
+        };
+        value.is_string() && handoff.allows(block, field)
+    })
+}
+
+pub(crate) fn refuse(app: &mut FigApp, id: &str, params: &Value) -> bool {
+    if allowed(app, id, params) {
+        return false;
+    }
+    app.show_error(NOTICE.to_owned());
+    true
+}
+
+/// The existing renderer and native property widgets, with only email navigation.
+pub(crate) fn frame(app: &mut FigApp, ui: &mut Ui, typing: bool, swallowed: shortcuts::Swallowed) {
+    let ctx = ui.ctx().clone();
+    let t = Tokens::get(&ctx);
+    crate::theme::set_doc_profile(&ctx, app.session.doc().map_or(figcraft_color::ColorProfile::Srgb, |d| d.color_profile));
+    crate::widgets::set_nudge(&ctx, app.session.prefs.nudge_small, app.session.prefs.nudge_big);
+    let uid = app.session.ds().map(|ds| ds.uid).unwrap_or_default();
+    let first = ctx.data_mut(|data| {
+        let key = Id::new(("edm-chrome", uid));
+        let first = !data.get_temp::<bool>(key).unwrap_or(false);
+        data.insert_temp(key, true);
+        first
+    });
+    if first {
+        let _ = app.session.drop_gesture();
+        app.ui.palette = None;
+        app.ui.home = false;
+        app.ui.context_menu = None;
+        app.ui.tool_flyout = None;
+        app.ui.main_menu = false;
+    }
+    // Reuse the engine's selection-only pointer behavior, without exposing Dev Mode.
+    app.session.tool.dev_mode = true;
+    if !matches!(app.session.tool.tool, figcraft_engine::ToolId::Move | figcraft_engine::ToolId::Hand) {
+        app.session.set_tool(figcraft_engine::ToolId::Move);
+    }
+    app.ui.right_tab = crate::RightTab::Design;
+    egui::Panel::top("edm_header").exact_size(42.0).show(ui, |ui| {
+        a11y::region(&mut app.ui.nav, ui, a11y::Region::Toolbar, egui::accesskit::Role::Toolbar, "Email navigation");
+        ui.horizontal(|ui| {
+            ui.strong("Email editor");
+            for (label, tool) in [("Select", "move"), ("Pan", "hand")] {
+                if ui.button(label).clicked() {
+                    app.run("tool.set", json!({"tool": tool}));
+                }
+            }
+            for (label, command) in [("Undo", "edit.undo"), ("Redo", "edit.redo")] {
+                if ui.button(label).clicked() {
+                    crate::menus::invoke(app, command);
+                }
+            }
+            ui.label("Return to XeroFlow to apply");
+        });
+    });
+    let (left, right) = crate::fit_panels(ui.available_width(), Some(200.0), Some(app.ui.right_width));
+    egui::Panel::left("edm_components").exact_size(left).resizable(false).show(ui, |ui| {
+        a11y::region(&mut app.ui.nav, ui, a11y::Region::Layers, egui::accesskit::Role::Pane, "Email components");
+        ui.heading("Components");
+        egui::ScrollArea::vertical().show(ui, |ui| components(app, ui));
+    });
+    egui::Panel::right("edm_properties").exact_size(right).resizable(false).show(ui, |ui| {
+        a11y::region(&mut app.ui.nav, ui, a11y::Region::Properties, egui::accesskit::Role::Pane, "Email controls");
+        egui::ScrollArea::vertical().show(ui, |ui| {
+            let Ok(ds) = app.session.ds() else { return };
+            let (doc, selected) = (ds.doc.clone(), ds.selection.clone());
+            if !edm_panel::section(app, ui, &doc, &selected) {
+                ui.label("Protected content — use compiled preview in XeroFlow.");
+            }
+        });
+    });
+    egui::CentralPanel::default().frame(egui::Frame::NONE.fill(t.canvas)).show(ui, |ui| {
+        let mut worker = app.worker.take().unwrap_or_else(|| render_worker::Worker::new(ctx.clone()));
+        canvas::show(app, ui, &mut worker);
+        app.worker = Some(worker);
+    });
+    shortcuts::handle(app, &ctx, typing, swallowed);
+    app.toast_ui(&ctx);
+    a11y::end(app, &ctx);
+    app.field_focus = a11y::field_focused(&ctx);
+}
+
+fn components(app: &mut FigApp, ui: &mut Ui) {
+    let Ok(ds) = app.session.ds() else { return };
+    let mut rows: Vec<(String, figcraft_doc::NodeId, String, bool)> = Vec::new();
+    for node in ds.doc.nodes() {
+        let Some(block) = node.plugin_data.get(BLOCK) else { continue };
+        let role = node.plugin_data.get(ROLE).map(String::as_str);
+        let useful = matches!(role, Some("text" | "image" | "button"));
+        if let Some(row) = rows.iter_mut().find(|row| row.0 == *block) {
+            if useful && !row.3 {
+                row.1 = node.id;
+                row.3 = true;
+            }
+        } else {
+            rows.push((block.clone(), node.id, node.name.clone(), useful));
+        }
+    }
+    let selection = ds.selection.clone();
+    for (block, node, name, _) in rows {
+        let selected = selection.iter().any(|id| app.session.doc().ok().and_then(|doc| doc.node(*id)).is_some_and(|n| n.plugin_data.get(BLOCK) == Some(&block)));
+        if ui.selectable_label(selected, name).clicked() {
+            app.run("select.set", json!({"ids": [node]}));
+        }
+    }
+}
