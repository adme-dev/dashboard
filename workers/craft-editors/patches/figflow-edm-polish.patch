+    #[test]
+    fn edm_emoji_font_has_real_rocket_outline_and_scalar_layout() {
+        assert!(figcraft_text::has_family("Noto Emoji"), "pinned outline emoji font must be embedded");
+        let face = figcraft_text::find_face("Noto Emoji", "Regular").unwrap();
+        for c in ['🚀', '😀', '❤'] {
+            assert!(face.has_char(c));
+            let gid = face.glyph_for(c);
+            assert_ne!(gid, 0);
+            assert!(!face.outline_at(gid, &figcraft_text::no_coords()).elements().is_empty());
+        }
+        let text = figcraft_doc::TextData { characters: "A🚀é".into(), ..Default::default() };
+        let layout = figcraft_text::layout(&text, None, None);
+        assert_eq!(layout.lines.last().unwrap().char_end, 3);
+        assert!(layout.glyphs.iter().any(|glyph| glyph.face.family == "Noto Emoji" && glyph.gid != 0 && !glyph.path().elements().is_empty()));
+    }
