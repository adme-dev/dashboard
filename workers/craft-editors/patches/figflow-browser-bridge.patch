+//! Narrow browser automation, independent of MCP transport and remote authority.
+//! The browser shell calls this on the real UI session at a frame boundary.
+use std::collections::BTreeMap;
+
+use figcraft_engine::Session;
+use serde_json::{Value, json};
+
+pub const MAX_REQUEST_BYTES: usize = 16 * 1024;
+pub const MAX_REPLY_BYTES: usize = 256 * 1024;
+pub const MAX_EDM_REQUEST_BYTES: usize = 48 * 1024 * 1024;
+pub const MAX_EDM_REPLY_BYTES: usize = 3 * 1024 * 1024;
+const MAX_MUTATIONS: usize = 128;
+const MAX_DOCUMENT_NODES: usize = 500;
+const MAX_RETAINED_BYTES: usize = 8 * 1024 * 1024;
+
+pub struct Bridge {
+    instance: String,
+    // Never evict mutation receipts: forgetting one would permit a repeated write.
+    completed: BTreeMap<String, (String, String)>,
+    retained_bytes: usize,
+}
+
+fn error(code: &str) -> Value {
+    json!({"ok": false, "error": {"code": code}})
+}
+fn keys(v: &Value, allowed: &[&str]) -> bool {
+    v.as_object().is_some_and(|o| o.keys().all(|k| allowed.contains(&k.as_str())))
+}
+fn token(v: &Value, key: &str) -> Option<String> {
+    v.get(key)?
+        .as_str()
+        .filter(|s| (8..=96).contains(&s.len()) && s.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_')))
+        .map(str::to_owned)
+}
+fn decimal(v: &Value) -> Option<u64> {
+    let s = v.as_str()?;
+    if s.is_empty() || s.len() > 20 || !s.bytes().all(|c| c.is_ascii_digit()) {
+        return None;
+    }
+    s.parse().ok()
+}
+fn small_text(v: &Value, max: usize) -> bool {
+    v.as_str().is_some_and(|s| s.len() <= max)
+}
+fn number(v: &Value, low: f64, high: f64) -> bool {
+    v.as_f64().is_some_and(|x| x.is_finite() && (low..=high).contains(&x))
+}
+fn colour(v: &Value) -> bool {
+    v.as_str().is_some_and(|s| s == "none" || ((s.len() == 7 || s.len() == 9) && s.starts_with('#') && s[1..].bytes().all(|c| c.is_ascii_hexdigit())))
+}
+fn properties(v: &Value) -> bool {
+    let Some(p) = v.as_object() else {
+        return false;
+    };
+    !p.is_empty()
+        && p.len() <= 20
+        && p.iter().all(|(k, v)| match k.as_str() {
+            "name" => small_text(v, 256),
+            "characters" => small_text(v, 8192),
+            "fontFamily" | "fontStyle" => small_text(v, 128),
+            "x" | "y" => number(v, -100_000., 100_000.),
+            "width" | "height" => number(v, 0.01, 10_000.),
+            "rotation" => number(v, -360., 360.),
+            "opacity" => number(v, 0., 1.),
+            "fontSize" => number(v, 1., 512.),
+            "cornerRadius" => number(v, 0., 5_000.),
+            "fill" | "stroke" => colour(v),
+            "strokeWeight" => number(v, 0., 512.),
+            "visible" => v.is_boolean(),
+            "textAlign" => v.as_str().is_some_and(|s| ["left", "center", "right"].contains(&s)),
+            _ => false,
+        })
+}
+/// Do not project paths or platform-sensitive document fields. Preserve u64 identifiers as text.
+fn project(v: &mut Value) {
+    match v {
+        Value::Object(o) => {
+            o.remove("path");
+            for (key, item) in o.iter_mut() {
+                if matches!(key.as_str(), "id" | "currentPage" | "parent") && item.is_u64() {
+                    *item = Value::String(item.to_string());
+                } else {
+                    project(item);
+                }
+            }
+        }
+        Value::Array(a) => {
+            for item in a {
+                project(item);
+            }
+        }
+        Value::Number(n) if n.as_u64().is_some_and(|n| n > 9_007_199_254_740_991) => {
+            *v = Value::String(n.to_string());
+        }
+        _ => {}
+    }
+}
+impl Bridge {
+    pub fn new(instance: String) -> Self {
+        Self { instance, completed: BTreeMap::new(), retained_bytes: 0 }
+    }
+
+    pub fn execute(&mut self, session: &mut Session, input: &str) -> String {
+        let result = self.execute_value(session, input);
+        let encoded = result.to_string();
+        if encoded.len() > MAX_EDM_REPLY_BYTES { error("reply_too_large").to_string() } else { encoded }
+    }
+    fn execute_value(&mut self, session: &mut Session, input: &str) -> Value {
+        if input.len() > MAX_EDM_REQUEST_BYTES
+            || (input.len() > MAX_REQUEST_BYTES && !input.contains("\"edm_import\"") && !input.contains("\"edm_snapshot\"") && !input.contains("\"edm_designer_import\""))
+        {
+            return error("request_too_large");
+        }
+        let Ok(request) = serde_json::from_str::<Value>(input) else {
+            return error("invalid_request");
+        };
+        if !keys(&request, &["requestId", "action", "instanceId", "documentId", "expectedRevision", "params"]) {
+            return error("invalid_request");
+        }
+        let Some(id) = token(&request, "requestId") else {
+            return error("invalid_request");
+        };
+        let Some(action) = request.get("action").and_then(Value::as_str) else {
+            return error("invalid_request");
+        };
+        let edm = matches!(action, "edm_import" | "edm_snapshot" | "edm_designer_import" | "edm_designer_snapshot" | "edm_designer_context");
+        let canonical = request.to_string();
+        if let Some((old, result)) = self.completed.get(&id) {
+            return if old == &canonical || (edm && old.len() == 64 && old == &figcraft_format::image_hash(canonical.as_bytes())) {
+                serde_json::from_str(result).unwrap_or_else(|_| error("receipt_unavailable"))
+            } else {
+                error("request_id_conflict")
+            };
+        }
+        if !edm && input.len() > MAX_REQUEST_BYTES {
+            return error("request_too_large");
+        }
+        let mutation = matches!(action, "create_node" | "update_node" | "edm_import" | "edm_snapshot" | "edm_designer_import" | "edm_designer_snapshot");
+        if !["status", "inspect", "get_node", "create_node", "update_node", "edm_import", "edm_required_snapshot_images", "edm_snapshot", "edm_designer_import", "edm_designer_snapshot", "edm_designer_context"].contains(&action) {
+            return error("unsupported_action");
+        }
+        let p = request.get("params").cloned().unwrap_or_else(|| json!({}));
+        if !p.is_object() {
+            return error("invalid_params");
+        }
+        let Ok(ds) = session.ds() else {
+            return error("document_unavailable");
+        };
+        let document = ds.uid.to_string();
+        let before = ds.revision;
+        if action != "status"
+            && (request.get("instanceId").and_then(Value::as_str) != Some(self.instance.as_str())
+                || request.get("documentId").and_then(Value::as_str) != Some(document.as_str()))
+        {
+            return error("document_conflict");
+        }
+        if (mutation || action == "edm_designer_context") && request.get("expectedRevision").and_then(decimal) != Some(before) {
+            return error("revision_conflict");
+        }
+        if (mutation || action == "edm_designer_context") && (ds.interaction.is_some() || ds.text_edit.is_some()) {
+            return error("editor_busy");
+        }
+        let request_retained = if edm { 64 } else { canonical.len() };
+        let reply_limit = if edm { MAX_EDM_REPLY_BYTES } else { MAX_REPLY_BYTES };
+        if mutation && (self.completed.len() >= MAX_MUTATIONS || self.retained_bytes + request_retained + reply_limit > MAX_RETAINED_BYTES) {
+            return error("receipt_capacity_reached");
+        }
+        if action != "status" && ds.doc.nodes().take(MAX_DOCUMENT_NODES + 1).count() > MAX_DOCUMENT_NODES {
+            return error("document_too_large");
+        }
+        let result = match action {
+            "status" if keys(&p, &[]) => Ok(
+                json!({"currentPage": ds.page.0.to_string(), "dirty": ds.is_dirty(), "supportedActions": ["inspect", "get_node", "create_node", "update_node", "edm_import", "edm_required_snapshot_images", "edm_snapshot", "edm_designer_import", "edm_designer_snapshot", "edm_designer_context"], "exports": false}),
+            ),
+            "inspect" if keys(&p, &["depth"]) => {
+                let depth = match p.get("depth") {
+                    None => Some(2),
+                    Some(v) => v.as_u64().filter(|n| *n <= 4).map(|n| n as usize),
+                };
+                depth.map(|d| figcraft_engine::inspect::document(session, d, false)).ok_or("invalid_params")
+            }
+            "get_node" if keys(&p, &["id"]) => match p.get("id").and_then(decimal) {
+                Some(n) => {
+                    let Some(node_id) = figcraft_engine::params::id_of(&json!(n)) else {
+                        return error("invalid_params");
+                    };
+                    let node = figcraft_engine::inspect::node_json(&ds.doc, node_id, 0);
+                    if node.is_null() { Err("node_unavailable") } else { Ok(node) }
+                }
+                None => Err("invalid_params"),
+            },
+            "create_node" if keys(&p, &["type", "parent", "name", "text", "x", "y", "width", "height", "props"]) => {
+                let valid = p.get("type").and_then(Value::as_str).is_some_and(|s| ["frame", "rectangle", "ellipse", "text"].contains(&s))
+                    && p.get("parent").and_then(decimal).is_some()
+                    && ["x", "y"].iter().all(|k| p.get(k).is_some_and(|v| number(v, -100_000., 100_000.)))
+                    && ["width", "height"].iter().all(|k| p.get(k).is_some_and(|v| number(v, 0.01, 10_000.)))
+                    && p.get("name").is_none_or(|v| small_text(v, 256))
+                    && p.get("text").is_none_or(|v| small_text(v, 8192))
+                    && p.get("props").is_none_or(properties);
+                if !valid { Err("invalid_params") } else { session.execute("node.create", &p).map_err(|_| "engine_refused") }
+            }
+            "update_node" if keys(&p, &["id", "props"]) => {
+                if p.get("id").and_then(decimal).is_none() || !p.get("props").is_some_and(properties) {
+                    Err("invalid_params")
+                } else {
+                    session.execute("node.set", &json!({"ids": [p["id"].clone()], "props": p["props"].clone()})).map_err(|_| "engine_refused")
+                }
+            }
+            "edm_import" if keys(&p, &["design", "images"]) => session.execute("edm_import", &p).map_err(|_| "engine_refused"),
+            "edm_required_snapshot_images" if keys(&p, &[]) => figcraft_engine::cmd::edm::required_snapshot_images(session).map(|images| json!({"images": images})).map_err(|_| "engine_refused"),
+            "edm_snapshot" if keys(&p, &["images"]) => session.execute("edm_snapshot", &p).map_err(|_| "engine_refused"),
+            "edm_designer_import" if keys(&p, &["design", "images", "operationId", "capabilities"]) => session.execute("edm_designer_import", &p).map_err(|_| "engine_refused"),
+            "edm_designer_context" if keys(&p, &[]) => session.execute("edm_designer_context", &p).map_err(|_| "engine_refused"),
+            "edm_designer_snapshot" if keys(&p, &[]) => session.execute("edm_designer_snapshot", &p).map_err(|_| "engine_refused"),
+            _ => Err("invalid_params"),
+        };
+        let after_state = session.ds().ok();
+        let after = after_state.as_ref().map(|d| d.revision).unwrap_or(before);
+        let response_document = if matches!(action, "edm_import" | "edm_designer_import") {
+            after_state.as_ref().map(|d| d.uid.to_string()).unwrap_or(document)
+        } else {
+            document
+        };
+        let mut response = match result {
+            Ok(value) => {
+                json!({"ok": true, "instanceId": self.instance, "documentId": response_document, "revisionBefore": before.to_string(), "revision": after.to_string(), "result": value})
+            }
+            Err(code) => error(code),
+        };
+        // EDM canonical JSON is not native inspection: removing a composer `path`
+        // property here would silently change locked source. Canonical IDs already strings.
+        if !edm {
+            project(&mut response);
+        }
+        if response.to_string().len() > reply_limit {
+            response = error("reply_too_large");
+        }
+        if mutation {
+            let encoded = response.to_string();
+            let receipt = if edm { figcraft_format::image_hash(canonical.as_bytes()) } else { canonical };
+            self.retained_bytes += request_retained + encoded.len();
+            self.completed.insert(id, (receipt, encoded));
+        }
+        response
+    }
+}
