+        let text = mapped(&second, "text-1", "text");
+        let button = mapped(&second, "button-1", "button");
+        assert!(!crate::tools::locked_in(second.doc().unwrap(), text), "text must remain reachable through structural containers");
+        assert!(!crate::tools::locked_in(second.doc().unwrap(), button), "button must remain reachable through structural containers");
+        let text_x = second.doc().unwrap().world_transform(text).as_coeffs()[4];
+        let button_x = second.doc().unwrap().world_transform(button).as_coeffs()[4];
+        assert!(text_x < button_x, "columns must preserve different world-space x positions");
+        let text_bottom = second.doc().unwrap().world_bounds(mapped(&second, "text-1", "block")).unwrap().y1;
+        // A Button root keeps role `button` (not `block`): the panel keys its URL field on it.
+        let button_bottom = second.doc().unwrap().world_bounds(button).unwrap().y1;
+        assert!((text_bottom - button_bottom).abs() < 1e-9, "bottom alignment uses the measured row height: {text_bottom} vs {button_bottom}");
+        assert!(second.doc().unwrap().nodes().all(|node| node.width.is_finite() && node.height.is_finite() && (node.is_page() || node.height > 0.0)));
