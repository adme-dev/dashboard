+fn designer_section(app: &mut FigApp, ui: &mut Ui, doc: &Document, selection: &[NodeId]) {
+    let selected_node = match selection {
+        [id] => Some(*id),
+        _ => None,
+    };
+    let block_id =
+        selected_node.and_then(|id| doc.node(id)).and_then(|node| node.plugin_data.get(BLOCK_ID)).cloned().unwrap_or_else(|| "root".into());
+    let Ok(ds) = app.session.ds() else { return };
+    let Some(designer) = ds.edm_designer.as_ref() else { return };
+    let Some(block) = designer.block(&block_id).cloned() else { return };
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default().to_owned();
+    let capability = designer.capability(&block_id);
+    let content_grants = ["text", "url", "alt", "linkHref"].into_iter().filter(|field| designer.allows(&block_id, field)).collect::<BTreeSet<_>>();
+    let allows = |field: &str| content_grants.contains(field);
+    let location = designer.location(&block_id);
+    let insertion = designer.insertion_target(Some(&block_id));
+    let operation_count = designer.operation_count();
+    let redo_count = designer.redo_count();
+    let list_len = location
+        .as_ref()
+        .and_then(|location| designer.block(&location.parent_id).map(|parent| children_len(parent, location.column_index)))
+        .unwrap_or(0);
+    let mobile_id = Id::new(("edm-designer-mobile-mode", &block_id));
+    let mut mobile = ui.data(|data| data.get_temp(mobile_id)).unwrap_or(false);
+    let t = Tokens::get(ui.ctx());
+
+    widgets::section_header(ui, "Email designer", &[], false);
+    row(ui, 26.0, |ui| {
+        widgets::label(ui, &format!("{kind} · {operation_count} canonical operations"), t.text_secondary);
+    });
+    row(ui, 32.0, |ui| {
+        if widgets::button(ui, "Undo", false, operation_count > 0).clicked() {
+            let _ = app.run("edm_designer_undo", json!({}));
+        }
+        if widgets::button(ui, "Redo", false, redo_count > 0).clicked() {
+            let _ = app.run("edm_designer_redo", json!({}));
+        }
+    });
+    if !capability.editable {
+        row(ui, 30.0, |ui| widgets::label(ui, "Locked by brand, legal, rich-content or module policy", t.text_secondary));
+    }
+
+    if capability.editable {
+        if kind == "EmailLayout" {
+            props_number(app, ui, &block_id, "contentWidth", "Canvas width", prop_number(&block, "contentWidth").or(Some(600.0)));
+            props_choice(app, ui, &block_id, "fontFamily", prop_text(&block, "fontFamily", "MODERN_SANS"), &FONT_FAMILIES);
+            for (key, label) in [
+                ("primaryColor", "Primary"),
+                ("backdropColor", "Backdrop"),
+                ("canvasColor", "Canvas"),
+                ("textColor", "Text"),
+                ("borderColor", "Border"),
+            ] {
+                props_text(app, ui, &block_id, key, label, prop_text(&block, key, ""));
+            }
+            props_number(app, ui, &block_id, "borderRadius", "Border radius", prop_number(&block, "borderRadius"));
+        } else {
+            if matches!(kind.as_str(), "Heading" | "Text") && allows("text") {
+                props_text(app, ui, &block_id, "text", "Text", prop_text(&block, "text", ""));
+            }
+            if kind == "Button" {
+                if allows("text") {
+                    props_text(app, ui, &block_id, "text", "CTA label", prop_text(&block, "text", "Click here"));
+                }
+                if allows("url") {
+                    props_text(app, ui, &block_id, "url", "CTA URL", prop_text(&block, "url", ""));
+                }
+                props_text(app, ui, &block_id, "buttonBackgroundColor", "CTA background", prop_text(&block, "buttonBackgroundColor", "#2F4574"));
+                props_text(app, ui, &block_id, "buttonTextColor", "CTA text colour", prop_text(&block, "buttonTextColor", "#FFFFFF"));
+                props_choice(app, ui, &block_id, "buttonStyle", prop_text(&block, "buttonStyle", "rounded"), &["rounded", "pill", "square"]);
+                props_choice(app, ui, &block_id, "size", prop_text(&block, "size", "medium"), &["x-small", "small", "medium", "large"]);
+                row(ui, 32.0, |ui| {
+                    if widgets::checkbox(ui, block["data"]["props"]["fullWidth"].as_bool().unwrap_or(false), "Full-width CTA") {
+                        let full_width = !block["data"]["props"]["fullWidth"].as_bool().unwrap_or(false);
+                        apply_props(app, &block_id, Map::from_iter([("fullWidth".into(), json!(full_width))]));
+                    }
+                });
+            }
+            if kind == "Image" {
+                if allows("alt") {
+                    props_text(app, ui, &block_id, "alt", "Alt text", prop_text(&block, "alt", ""));
+                }
+                if allows("linkHref") {
+                    props_text(app, ui, &block_id, "linkHref", "Image link", prop_text(&block, "linkHref", ""));
+                }
+                row(ui, 32.0, |ui| {
+                    let current = prop_number(&block, "width");
+                    if let Some(value) = widgets::number_field_or(ui, Id::new(("edm-designer-image-width", &block_id)), current, "Full", 90.0, 1.0)
+                        .and_then(|edit| match edit {
+                            FieldEdit::Set(value) => Some(value),
+                            FieldEdit::Scrub(value, true) => Some(value),
+                            _ => None,
+                        })
+                    {
+                        apply_props(app, &block_id, Map::from_iter([("width".into(), json!(value))]));
+                    }
+                });
+                props_choice(app, ui, &block_id, "contentAlignment", prop_text(&block, "contentAlignment", "left"), &["left", "center", "right"]);
+                if prop_text(&block, "url", "").is_empty() {
+                    row(ui, 30.0, |ui| widgets::label(ui, "Empty image: select a verified asset in XeroFlow", t.text_secondary));
+                }
+            }
+            if kind == "Spacer" {
+                props_number(app, ui, &block_id, "height", "Height", prop_number(&block, "height").or(Some(24.0)));
+            }
+            if kind == "Divider" {
+                props_number(app, ui, &block_id, "lineThickness", "Line thickness", prop_number(&block, "lineThickness").or(Some(1.0)));
+                props_text(app, ui, &block_id, "lineColor", "Line colour", prop_text(&block, "lineColor", "#E5E7EB"));
+            }
+            if kind == "ColumnsContainer" {
+                row(ui, 32.0, |ui| {
+                    let current = prop_number(&block, "columnsCount").unwrap_or(2.0).to_string();
+                    if let Some(value) =
+                        widgets::combo_field(ui, Id::new(("edm-designer-columns-count", &block_id)), &current, 90.0, &strings(&["1", "2", "3"]))
+                            .and_then(|value| value.parse::<f64>().ok())
+                    {
+                        apply_props(app, &block_id, Map::from_iter([("columnsCount".into(), json!(value))]));
+                    }
+                });
+                props_number(app, ui, &block_id, "columnsGap", "Column gap", prop_number(&block, "columnsGap").or(Some(16.0)));
+                props_choice(app, ui, &block_id, "contentAlignment", prop_text(&block, "contentAlignment", "top"), &["top", "middle", "bottom"]);
+            }
+
+            row(ui, 32.0, |ui| {
+                if widgets::checkbox(ui, mobile, "Edit mobile style overrides") {
+                    mobile = !mobile;
+                    ui.data_mut(|data| data.insert_temp(mobile_id, mobile));
+                }
+            });
+            padding_editor(app, ui, &block_id, &block, mobile);
+            if matches!(kind.as_str(), "Heading" | "Text" | "Button") {
+                style_choice(app, ui, &block_id, "fontFamily", mobile, style_text(&block, mobile, "fontFamily", "MODERN_SANS"), &FONT_FAMILIES);
+                style_number_field(app, ui, &block_id, "fontSize", "Font size", mobile, style_number(&block, mobile, "fontSize"));
+                style_choice(
+                    app,
+                    ui,
+                    &block_id,
+                    "fontWeight",
+                    mobile,
+                    style_text(&block, mobile, "fontWeight", "normal"),
+                    &["normal", "bold", "100", "200", "300", "400", "500", "600", "700", "800", "900"],
+                );
+                style_choice(app, ui, &block_id, "textAlign", mobile, style_text(&block, mobile, "textAlign", "left"), &["left", "center", "right"]);
+                style_number_field(app, ui, &block_id, "lineHeight", "Line height", mobile, style_number(&block, mobile, "lineHeight"));
+                style_number_field(app, ui, &block_id, "letterSpacing", "Letter spacing", mobile, style_number(&block, mobile, "letterSpacing"));
+                style_text_field(app, ui, &block_id, "color", mobile, style_text(&block, mobile, "color", ""));
+            }
+            style_text_field(app, ui, &block_id, "backgroundColor", mobile, style_text(&block, mobile, "backgroundColor", ""));
+        }
+    }
+
+    widgets::sublabels(ui, "Approved components", None);
+    row(ui, 32.0, |ui| {
+        let response = ui.add_enabled_ui(insertion.is_some(), |ui| widgets::dropdown(ui, "Add section", 120.0, None)).inner;
+        if let Some(target) = insertion {
+            menu_popup(&response).show(|ui| {
+                for section_type in SECTION_TYPES {
+                    if menu_item(ui, section_type, "") {
+                        apply_operation(app, add_section_operation(section_type, &target));
+                        ui.close();
+                    }
+                }
+            });
+        }
+    });
+    if let Some(location) = location {
+        row(ui, 32.0, |ui| {
+            if widgets::button(ui, "Move up", false, location.index > 0).clicked() {
+                apply_operation(app, move_section_operation(&block_id, &location, location.index - 1));
+            }
+            if widgets::button(ui, "Move down", false, location.index + 1 < list_len).clicked() {
+                apply_operation(app, move_section_operation(&block_id, &location, location.index + 1));
+            }
+        });
+        row(ui, 32.0, |ui| {
+            if widgets::button(ui, "Duplicate", false, capability.editable).clicked() {
+                apply_operation(app, duplicate_section_operation(&block_id, &location));
+            }
+            if widgets::button(ui, "Remove", false, capability.editable).clicked() {
+                apply_operation(app, json!({"op": "remove-section", "blockId": block_id}));
+            }
+        });
+    }
+    row(ui, 30.0, |ui| widgets::label(ui, "Canvas text and freeform transforms require explicit controls", t.text_secondary));
+}
+
+fn content_section(app: &mut FigApp, ui: &mut Ui, doc: &Document, selection: &[NodeId]) -> bool {
+    let [id] = selection else { return false };
+    let Ok(ds) = app.session.ds() else { return false };
+    let Some(handoff) = ds.edm.as_ref() else { return false };
+    let Some(node) = doc.node(*id) else { return false };
+    let Some(block_id) = node.plugin_data.get(BLOCK_ID).cloned() else { return false };
+    let role = node.plugin_data.get(ROLE).map(String::as_str);
+    let fields: Vec<(&str, &str, &str)> = match role {
+        Some("button") => vec![("Button URL", URL, "url")],
+        Some("image") => vec![("Image URL", URL, "url"), ("Image alt text", ALT, "alt"), ("Image link", LINK, "linkHref")],
+        _ => return false,
+    };
+    widgets::section_header(ui, "Email content", &[], false);
+    let t = Tokens::get(ui.ctx());
+    let mut updates = Map::new();
+    for (label, key, field) in fields {
+        let allowed = handoff.allows(&block_id, field);
+        let current = node.plugin_data.get(key).cloned().unwrap_or_default();
+        ui.add_enabled_ui(allowed, |ui| {
+            ui.horizontal(|ui| {
+                widgets::label(ui, label, t.text);
+                if let Some(value) = widgets::text_field(ui, Id::new(("xeroflow-edm", *id, key)), &current, ui.available_width().max(80.0), label) {
+                    updates.insert(key.to_owned(), Value::String(value));
+                }
+            });
+        });
+    }
+    if !updates.is_empty() {
+        app.set_props(&[*id], json!({"pluginData": updates}));
+    }
+    true
+}
+
+pub fn section(app: &mut FigApp, ui: &mut Ui, doc: &Document, selection: &[NodeId]) -> bool {
+    if app.session.ds().is_ok_and(|ds| ds.edm.is_some() || ds.edm_designer.is_some()) {
+        ui.horizontal(|ui| {
+            for (label, fit_width) in [("Fit width", true), ("100%", false)] {
+                if ui.button(label).clicked() {
+                    if let Ok(ds) = app.session.ds_mut() {
+                        fit_email_view(ds, fit_width);
+                    }
+                }
+            }
+        });
+        if selection.is_empty() && app.session.ds().is_ok_and(|ds| ds.edm.is_some()) {
+            ui.label("Select text, an image or a button");
+            return true;
+        }
+    }
+    if app.session.ds().is_ok_and(|ds| ds.edm_designer.is_some()) {
+        designer_section(app, ui, doc, selection);
+        return true;
+    }
+    content_section(app, ui, doc, selection)
+}
