+/// View-only state: never changes native nodes or canonical handoff authority.
+pub fn fit_email_view(ds: &mut figcraft_engine::DocState, fit_width: bool) -> bool {
+    if ds.edm.is_none() && ds.edm_designer.is_none() {
+        return false;
+    }
+    if !ds.view.vw.is_finite() || !ds.view.vh.is_finite() || ds.view.vw <= 48.0 || ds.view.vh <= 48.0 {
+        return false;
+    }
+    let Some(root) = ds.doc.nodes().find(|node| {
+        node.plugin_data.get(BLOCK_ID).map(String::as_str) == Some("root") && node.plugin_data.get(ROLE).map(String::as_str) == Some("block")
+    }) else {
+        return false;
+    };
+    let Some(bounds) = ds.doc.world_bounds(root.id) else { return false };
+    let width = bounds.x1 - bounds.x0;
+    if !width.is_finite() || width <= 0.0 {
+        return false;
+    }
+    ds.view.zoom = if fit_width { ((ds.view.vw - 48.0) / width).min(1.0) } else { 1.0 };
+    ds.view.cx = (bounds.x0 + bounds.x1) / 2.0;
+    ds.view.cy = bounds.y0 + (ds.view.vh / 2.0 - 24.0) / ds.view.zoom;
+    ds.edm_view_initialized = true;
+    true
+}
