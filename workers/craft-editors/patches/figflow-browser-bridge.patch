+    fn edm_cmd_z_in_a_panel_field_or_the_palette_leaves_the_log_alone() {
+        let mut u = designer();
+        apply(&mut u, "Hi {{firstName}}");
+        // A panel field had the keyboard when the frame began (how `FigApp::ui` reports one).
+        u.app.field_focus = true;
+        press(&mut u, Key::Z, cmd());
+        assert_eq!(counts(&u), (1, 0), "the field's own undo, not the canonical log");
+        assert_eq!(canonical_text(&u), "Hi {{firstName}}");
+        u.app.ui.palette = Some(String::new());
+        press(&mut u, Key::Z, cmd());
+        press(&mut u, Key::Z, cmd() | Modifiers::SHIFT);
+        assert_eq!(counts(&u), (1, 0), "the palette's query keeps its keys too");
+        u.app.ui.palette = None;
+        assert!(snapshot_ok(&mut u));
+    }
