+fn padding_editor(app: &mut FigApp, ui: &mut Ui, block_id: &str, block: &Value, mobile: bool) {
+    widgets::sublabels(ui, if mobile { "Mobile padding" } else { "Padding" }, None);
+    let mut padding = if mobile && block["data"]["mobile"]["style"]["padding"].is_object() {
+        block["data"]["mobile"]["style"]["padding"].clone()
+    } else {
+        block["data"]["style"]["padding"].clone()
+    };
+    if !padding.is_object() {
+        padding = json!({"top": 16, "right": 24, "bottom": 16, "left": 24});
+    }
+    for sides in [["top", "right"], ["bottom", "left"]] {
+        row(ui, 32.0, |ui| {
+            for side in sides {
+                let current = padding.get(side).and_then(Value::as_f64);
+                if let Some(value) = number_edit(ui, Id::new(("edm-designer-padding", block_id, side, mobile)), side, current) {
+                    padding[side] = json!(value);
+                    apply_style(app, block_id, Map::from_iter([("padding".into(), padding.clone())]), mobile);
+                }
+            }
+        });
+    }
+}
+
+fn children_len(block: &Value, column_index: Option<usize>) -> usize {
+    if let Some(index) = column_index {
+        return block["data"]["props"]["columns"]
+            .as_array()
+            .and_then(|columns| columns.get(index))
+            .and_then(|column| column["childrenIds"].as_array())
+            .map_or(0, Vec::len);
+    }
+    block["data"]["childrenIds"].as_array().map_or(0, Vec::len)
+}
