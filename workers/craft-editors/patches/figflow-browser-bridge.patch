+    fn designer_capabilities(design: &Value) -> Value {
+        let blocks = design["blocks"].as_object().unwrap();
+        let capabilities = blocks
+            .keys()
+            .map(|id| {
+                let (editable, can_insert, locked_style_fields) = designer_capability(design, id).unwrap();
+                json!({"blockId": id, "editable": editable, "canInsert": can_insert, "lockedStyleFields": locked_style_fields})
+            })
+            .collect::<Vec<_>>();
+        json!({"version": 1, "operations": DESIGNER_OPERATION_TYPES, "blocks": capabilities, "nativeSource": {"state": "canonical-only", "artifact": null, "reason": "PRIVATE_NATIVE_STAGING_UNAVAILABLE"}})
+    }
