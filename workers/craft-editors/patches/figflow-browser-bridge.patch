+/// Run after actual canvas sizing, including a first viewport exactly 1200×800.
+/// Later resizes update the viewport dimensions but retain the user's camera.
+pub fn size_viewport(ds: &mut figcraft_engine::DocState, width: f64, height: f64) {
+    if !width.is_finite() || !height.is_finite() || width <= 0.0 || height <= 0.0 {
+        return;
+    }
+    let changed = (ds.view.vw - width).abs() > 0.5 || (ds.view.vh - height).abs() > 0.5;
+    let first = ds.view.vw == 1200.0 && ds.view.vh == 800.0;
+    ds.view.vw = width;
+    ds.view.vh = height;
+    if ds.edm.is_some() || ds.edm_designer.is_some() {
+        if !ds.edm_view_initialized {
+            fit_email_view(ds, true);
+        }
+    } else if changed && first {
+        ds.zoom_to_fit();
+    }
+}
