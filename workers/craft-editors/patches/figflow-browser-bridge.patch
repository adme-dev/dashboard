+//! XeroFlow email metadata controls on the actual mapped native selection.
+use egui::{Id, Ui};
+use figcraft_doc::{Document, NodeId};
+use serde_json::{Map, Value, json};
+
+use crate::{FigApp, widgets};
+
+const BLOCK_ID: &str = "xeroflow.edm.blockId";
+const ROLE: &str = "xeroflow.edm.role";
+const URL: &str = "xeroflow.edm.url";
+const ALT: &str = "xeroflow.edm.alt";
+const LINK: &str = "xeroflow.edm.linkHref";
+
+/// Compact Design-panel fields for content native FigCraft does not otherwise
+/// model: email links and alternative text. Canvas text remains ordinary text.
+pub fn section(app: &mut FigApp, ui: &mut Ui, doc: &Document, selection: &[NodeId]) -> bool {
+    let [id] = selection else { return false };
+    let Ok(ds) = app.session.ds() else { return false };
+    let Some(handoff) = ds.edm.as_ref() else { return false };
+    let Some(node) = doc.node(*id) else { return false };
+    let Some(block_id) = node.plugin_data.get(BLOCK_ID).cloned() else { return false };
+    let role = node.plugin_data.get(ROLE).map(String::as_str);
+    let fields: Vec<(&str, &str, &str)> = match role {
+        Some("button") => vec![("Button URL", URL, "url")],
+        Some("image") => vec![("Image URL", URL, "url"), ("Image alt text", ALT, "alt"), ("Image link", LINK, "linkHref")],
+        _ => return false,
+    };
+    widgets::section_header(ui, "Email content", &[], false);
+    let mut updates = Map::new();
+    for (label, key, field) in fields {
+        let allowed = handoff.allows(&block_id, field);
+        let current = node.plugin_data.get(key).cloned().unwrap_or_default();
+        ui.add_enabled_ui(allowed, |ui| {
+            ui.horizontal(|ui| {
+                widgets::label(ui, label);
+                if let Some(value) = widgets::text_field(ui, Id::new(("xeroflow-edm", *id, key)), &current, ui.available_width().max(80.0), label) {
+                    updates.insert(key.to_owned(), Value::String(value));
+                }
+            });
+        });
+    }
+    if !updates.is_empty() {
+        app.set_props(&[*id], json!({"pluginData": updates}));
+    }
+    true
+}
