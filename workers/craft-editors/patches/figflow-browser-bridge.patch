+    #[test]
+    fn edm_font_stacks_resolve_registered_families_and_heading_weights() {
+        for (key, stack) in FONT_STACKS {
+            assert_eq!(stack.last(), Some(&"Inter"), "{key} must end in the browser's registered family");
+            assert_eq!(first_registered_family(stack, |_| false), "Inter", "{key} without its preferred fonts keeps Inter");
+            assert_eq!(first_registered_family(stack, |family| family == stack[0]), stack[0], "{key} keeps the canonical first family when present");
+        }
+        let geometric = FONT_STACKS.iter().find(|(key, _)| *key == "GEOMETRIC_SANS").unwrap().1;
+        assert_eq!(first_registered_family(geometric, |family| family == "Montserrat" || family == "Inter"), "Montserrat");
+        assert!(figcraft_text::has_family(&native_font_family("UNKNOWN_KEY")) || native_font_family("UNKNOWN_KEY") == "Inter");
+        for (value, fallback, expected) in [
+            (None, "Bold", "Bold"),
+            (None, "Semi Bold", "Semi Bold"),
+            (None, "Regular", "Regular"),
+            (Some("normal"), "Bold", "Regular"),
+            (Some("600"), "Bold", "Semi Bold"),
+            (Some("700"), "Regular", "Bold"),
+            (Some("bold"), "Regular", "Bold"),
+            (Some("unknown"), "Bold", "Regular"),
+        ] {
+            assert_eq!(native_font_weight(value, fallback), expected, "{value:?} with default {fallback}");
+        }
+        // Imported weights: (design edits, expected heading, copy, button styles).
+        let cases: [(Option<&str>, Option<&str>, Option<&str>, &str, &str, &str); 3] = [
+            (None, None, None, "Bold", "Regular", "Semi Bold"),
+            (Some("normal"), Some("600"), Some("700"), "Regular", "Semi Bold", "Bold"),
+            (Some("700"), Some("normal"), Some("normal"), "Bold", "Regular", "Regular"),
+        ];
+        for (heading, copy, cta, heading_style, copy_style, cta_style) in cases {
+            let mut design = modern_design();
+            for (block, weight) in [("heading", heading), ("copy", copy), ("cta", cta)] {
+                let style = design["blocks"][block]["data"]["style"].as_object_mut().unwrap();
+                match weight {
+                    Some(weight) => {
+                        style.insert("fontWeight".into(), json!(weight));
+                    }
+                    None => {
+                        style.remove("fontWeight");
+                    }
+                }
+            }
+            let mut session = Session::new();
+            session.execute("edm_import", &json!({"design": design, "images": {"hero": PNG}})).unwrap();
+            let style = |block: &str, role: &str| {
+                let node = session.doc().unwrap().node(mapped(&session, block, role)).unwrap();
+                let NodeKind::Text(data) = &node.kind else { panic!("{block} {role} must be native text") };
+                (data.style.font_family.clone(), data.style.font_style.clone())
+            };
+            let (heading_family, heading_weight) = style("heading", "text");
+            assert_eq!(heading_weight, heading_style, "heading weight {heading:?}");
+            assert!(figcraft_text::has_family(&heading_family), "unregistered heading family {heading_family}");
+            assert_eq!(style("copy", "text").1, copy_style, "copy weight {copy:?}");
+            assert_eq!(style("cta", "button.text").1, cta_style, "button weight {cta:?}");
+            let snapshot = session.execute("edm_snapshot", &json!({})).unwrap();
+            assert_eq!(snapshot, design, "font resolution must not change the canonical return");
+        }
+    }
