+mod edm_history_key_tests {
+    use egui::{Event, Key, Modifiers};
+    use figcraft_doc::NodeId;
+    use figcraft_engine::Session;
+    use figcraft_engine::keymap::Platform;
+    use serde_json::json;
+
+    use crate::layers_drag_tests::Ui;
+
+    /// One granted Text block. `capabilities` is what the shared `designerCapabilities` returns for
+    /// this design (generated with tsx on 2 November 2026), not this crate's own derivation.
+    fn designer() -> Ui {
+        let design = json!({
+            "schemaVersion": 1,
+            "kind": "template",
+            "scope": {"clientId": null},
+            "source": {"editor": "composer", "nativeArtifact": null},
+            "rootChildrenIds": ["root"],
+            "blocks": {
+                "root": {"type": "EmailLayout", "data": {"childrenIds": ["text-1"], "props": {"contentWidth": 600}}},
+                "text-1": {"type": "Text", "data": {"props": {"text": "Hello {{firstName}}"}}}
+            },
+            "lineage": [],
+            "dependencies": [],
+            "moduleInstances": [],
+            "assets": [],
+            "policy": {"version": 1, "editableFields": ["text-1.data.props.text"]}
+        });
+        let capabilities = json!({
+            "version": 1,
+            "operations": ["set-style", "set-props", "add-section", "move-section", "duplicate-section", "remove-section"],
+            "blocks": [
+                {"blockId": "root", "editable": true, "canInsert": true, "lockedStyleFields": []},
+                {"blockId": "text-1", "editable": true, "canInsert": false, "lockedStyleFields": []}
+            ],
+            "nativeSource": {"state": "canonical-only", "artifact": null, "reason": "PRIVATE_NATIVE_STAGING_UNAVAILABLE"}
+        });
+        let mut session = Session::new();
+        let params = json!({"design": design, "images": {}, "operationId": "123e4567-e89b-42d3-a456-426614174000", "capabilities": capabilities});
+        session.execute("edm_designer_import", &params).unwrap();
+        Ui::new(session)
+    }
