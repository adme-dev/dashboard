+    #[test]
+    fn edm_cmd_z_while_editing_canvas_text_ends_the_edit_and_undoes_the_typing_generically() {
+        let mut u = designer();
+        apply(&mut u, "Hi {{firstName}}");
+        let logged = native_text(&u);
