+        let logged = native_text(&u);
+        let node = text_node(&u);
+        u.app.run("node.set", json!({"ids": [node], "props": {"characters": "Unlogged"}})).unwrap();
+        assert!(!snapshot_ok(&mut u), "an unlogged native edit blocks the snapshot");
+        press(&mut u, Key::Z, cmd());
+        assert_eq!(native_text(&u), logged, "generic undo takes the unlogged edit back");
+        assert_eq!(counts(&u), (1, 0), "the canonical log is untouched");
+        assert!(snapshot_ok(&mut u));
+        press(&mut u, Key::Z, cmd());
+        assert_eq!(counts(&u), (0, 1), "with the canvas canonical again, the next press replays the log");
+        assert_eq!(canonical_text(&u), "Hello {{firstName}}");
+    }
