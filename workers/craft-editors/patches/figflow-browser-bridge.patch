+fn apply_operation(app: &mut FigApp, operation: Value) {
+    let _ = app.run("edm_designer_apply", json!({"operations": [operation]}));
+}
+
+/// A shared structural `Target`: `parentId`, `index` and `columnIndex` only for a column parent. The
+/// shared parser (`z.number().int().min(0).max(2).optional()`) refuses `null`, so "no column" is the
+/// absent key, never JSON `null`; a real column index, including 0, is always kept.
+fn structural_operation(op: &str, subject: (&str, &str), target: &DesignerLocation, index: usize) -> Value {
+    let mut operation = Map::new();
+    operation.insert("op".into(), json!(op));
+    operation.insert(subject.0.into(), json!(subject.1));
+    operation.insert("parentId".into(), json!(target.parent_id));
+    if let Some(column_index) = target.column_index {
+        operation.insert("columnIndex".into(), json!(column_index));
+    }
+    operation.insert("index".into(), json!(index));
+    Value::Object(operation)
+}
+
+fn add_section_operation(section_type: &str, target: &DesignerLocation) -> Value {
+    structural_operation("add-section", ("sectionType", section_type), target, target.index)
+}
+
+/// `index` is the destination within the block's current list (one up or one down).
+fn move_section_operation(block_id: &str, location: &DesignerLocation, index: usize) -> Value {
+    structural_operation("move-section", ("blockId", block_id), location, index)
+}
+
+/// The copy lands directly after its source, in the same list (and column).
+fn duplicate_section_operation(block_id: &str, location: &DesignerLocation) -> Value {
+    structural_operation("duplicate-section", ("blockId", block_id), location, location.index + 1)
+}
