+            widgets::text_field(ui, Id::new(("edm-designer-style", block_id, key, mobile)), &current, ui.available_width().max(80.0), key);
+        if let Some(value) = committed.and_then(|value| changed(value, &current)) {
+            apply_style(app, block_id, Map::from_iter([(key.to_owned(), Value::String(value))]), mobile);
+        }
+    });
+}
