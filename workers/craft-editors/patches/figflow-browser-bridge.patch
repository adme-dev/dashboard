+    fn import_designer_with(session: &mut Session, design: Value, images: Value) {
+        let capabilities = designer_capabilities(&design);
+        session
+            .execute(
+                "edm_designer_import",
+                &json!({"design": design, "images": images, "operationId": DESIGNER_OPERATION_ID, "capabilities": capabilities}),
+            )
+            .unwrap();
+    }
