+            {"childrenIds": ["text-1"]}, {"childrenIds": ["button-1"]}
+        ]}}});
+        columns["blocks"]["columns"]["data"]["props"]["contentAlignment"] = json!("bottom");
+        columns["blocks"]["root"]["data"]["childrenIds"] = json!(["columns", "image-1"]);
