+//! Bounded XeroFlow email handoffs on a real native document.
+//!
+//! The canonical document is retained verbatim. A snapshot patches only approved
+//! content fields after proving that every other native/document field is unchanged.
+use std::collections::{BTreeMap, BTreeSet};
+
+use base64::Engine as _;
+use figcraft_color::{Color, Paint, PaintKind};
+use figcraft_doc::{
+    Document, EffectKind, ImageData, LetterSpacing, LineHeight, Node, NodeId, NodeKind, TextAlignH, TextAutoResize, TextCase, TextData, TextStyle,
+};
+use serde_json::{Value, json};
+
+use super::CommandSpec;
+use crate::{DocState, Result, Session, bad, spec};
+
+const MAX_DESIGN_BYTES: usize = 2 * 1024 * 1024;
+const MAX_BLOCKS: usize = 300;
+const MAX_CONTENT: usize = 8192;
+const MAX_IMAGE_BYTES: usize = 10 * 1024 * 1024;
+const MAX_TOTAL_IMAGE_BYTES: usize = 32 * 1024 * 1024;
+const BLOCK_ID: &str = "xeroflow.edm.blockId";
+const ROLE: &str = "xeroflow.edm.role";
+const URL: &str = "xeroflow.edm.url";
+const ALT: &str = "xeroflow.edm.alt";
+const LINK: &str = "xeroflow.edm.linkHref";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Role {
+    Text,
+    Button,
+    ButtonText,
+    Image,
+    Other,
+}
+
+#[derive(Clone, Debug)]
+struct BlockMap {
+    root: NodeId,
+    content: Option<NodeId>,
+    role: Role,
+}
+
+/// The immutable canonical baseline and current native fingerprint retained on
+/// the actual document tab. This is never a JavaScript model or overlay editor.
+#[derive(Clone, Debug)]
+pub struct EdmHandoff {
+    canonical: Value,
+    native: Document,
+    blocks: BTreeMap<String, BlockMap>,
+    editable: BTreeSet<String>,
+}
+
+impl EdmHandoff {
+    pub fn allows(&self, block_id: &str, field: &str) -> bool {
+        self.editable.contains(&format!("{block_id}.data.props.{field}"))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize)]
+pub struct ImageRequest {
+    pub block_id: String,
+    pub url: String,
+}
+
+#[derive(Clone)]
+struct Replacement {
+    hash: String,
+    data: ImageData,
+}
+
+#[derive(Clone, Debug)]
+struct NativeImage {
+    hash: String,
+    data: ImageData,
+}
+
+#[derive(Clone, Copy)]
+struct Padding {
+    top: f64,
+    right: f64,
+    bottom: f64,
+    left: f64,
+}
+
+impl Padding {
+    const ZERO: Self = Self { top: 0.0, right: 0.0, bottom: 0.0, left: 0.0 };
+    const DEFAULT: Self = Self { top: 16.0, right: 24.0, bottom: 16.0, left: 24.0 };
+    fn horizontal(self) -> f64 {
+        self.left + self.right
+    }
+    fn vertical(self) -> f64 {
+        self.top + self.bottom
+    }
+}
+
+#[derive(Clone)]
+struct Theme {
+    font_family: String,
+    text_color: Option<Color>,
+    canvas_color: Color,
+}
+
+#[derive(Clone, Copy)]
+struct TextSpec {
+    size: f64,
+    weight: &'static str,
+    line_height: f64,
+    color: Color,
+    align: TextAlignH,
+    honor_text_style: bool,
+    honor_font_weight: bool,
+}
+
+fn prop<'a>(block: &'a Value, field: &str) -> Option<&'a Value> {
+    block.get("data")?.get("props")?.get(field)
+}
+
+fn string_prop(block: &Value, field: &str) -> Option<String> {
+    prop(block, field).and_then(Value::as_str).map(str::to_owned)
+}
+
+fn number_prop(block: &Value, field: &str) -> Option<f64> {
+    prop(block, field).and_then(Value::as_f64).filter(|v| v.is_finite())
+}
+
+fn bool_prop(block: &Value, field: &str, fallback: bool) -> bool {
+    prop(block, field).and_then(Value::as_bool).unwrap_or(fallback)
+}
+
+fn style_value<'a>(block: &'a Value, field: &str) -> Option<&'a Value> {
+    block.get("data")?.get("style")?.get(field)
+}
+
+fn style_number(block: &Value, field: &str) -> Option<f64> {
+    style_value(block, field).and_then(Value::as_f64).filter(|v| v.is_finite())
+}
+
+fn style_string<'a>(block: &'a Value, field: &str) -> Option<&'a str> {
+    style_value(block, field).and_then(Value::as_str)
+}
+
+fn css_color(value: Option<&Value>) -> Option<Color> {
+    value.and_then(Value::as_str).and_then(Color::parse_css)
+}
+
+fn style_color(block: &Value, field: &str, fallback: Option<Color>) -> Option<Color> {
+    css_color(style_value(block, field)).or(fallback)
+}
+
+fn padding(block: &Value, fallback: Padding) -> Padding {
+    let Some(value) = style_value(block, "padding") else { return fallback };
+    let side = |field: &str, default: f64| value.get(field).and_then(Value::as_f64).filter(|v| v.is_finite() && *v >= 0.0).unwrap_or(default);
+    Padding {
+        top: side("top", fallback.top),
+        right: side("right", fallback.right),
+        bottom: side("bottom", fallback.bottom),
+        left: side("left", fallback.left),
+    }
+}
+
+/// ECMAScript `\s` (WhiteSpace and LineTerminator), the class the shared validators use. Unlike
+/// [`char::is_whitespace`] it includes U+FEFF and excludes U+0085.
+fn js_whitespace(c: char) -> bool {
+    matches!(c, '\t' | '\n' | '\u{0B}' | '\u{0C}' | '\r' | ' ' | '\u{A0}' | '\u{FEFF}')
+        || matches!(c, '\u{1680}' | '\u{2000}'..='\u{200A}' | '\u{2028}' | '\u{2029}' | '\u{202F}' | '\u{205F}' | '\u{3000}')
+}
+
+fn valid_url(value: &str, image: bool) -> bool {
+    // Controls (U+0085 and the other C1 codes too) stay refused: stricter than shared, never looser.
+    if value.len() > MAX_CONTENT || value.chars().any(|c| js_whitespace(c) || c.is_control() || matches!(c, '<' | '>' | '"' | '\'')) {
+        return false;
+    }
+    if !image
+        && (value.is_empty()
+            || value
+                .strip_prefix('#')
+                .is_some_and(|fragment| fragment.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.' | b':' | b'-'))))
+    {
+        return true;
+    }
+    let Some(scheme_end) = value.find(':') else { return false };
+    let scheme = &value[..scheme_end];
+    if !scheme.bytes().next().is_some_and(|b| b.is_ascii_alphabetic())
+        || !scheme.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'+' | b'-' | b'.'))
+    {
+        return false;
+    }
+    let scheme = scheme.to_ascii_lowercase();
+    if (image && scheme != "https") || (!image && !matches!(scheme.as_str(), "https" | "http" | "mailto" | "tel")) {
+        return false;
+    }
+    // WHATWG parses an authority after `scheme://` for every scheme, `mailto:` and `tel:` included,
+    // and the shared `safeLink` refuses any username or password it finds there. HTTP(S) must have
+    // a non-empty authority; elsewhere it is optional (`mailto:team@example.invalid` has none).
+    let after_scheme = value.get(scheme_end + 1..).unwrap_or_default();
+    let authority = after_scheme.strip_prefix("//").map(|rest| rest.split(['/', '?', '#']).next().unwrap_or_default());
+    if matches!(scheme.as_str(), "https" | "http") {
+        authority.is_some_and(|authority| !authority.is_empty() && !authority.contains('@'))
+    } else {
+        authority.is_none_or(|authority| !authority.contains('@'))
+    }
+}
+
+fn has_rich_text_markup(value: &str) -> bool {
+    if value.bytes().any(|b| matches!(b, b'<' | b'>')) {
+        return true;
+    }
+    value.split('&').skip(1).any(|rest| {
+        let Some(end) = rest.find(';') else { return false };
+        let entity = &rest[..end];
+        if entity.is_empty() || entity.len() > 32 {
+            return false;
+        }
+        if let Some(hex) = entity.strip_prefix("#x").or_else(|| entity.strip_prefix("#X")) {
+            return !hex.is_empty() && hex.bytes().all(|b| b.is_ascii_hexdigit());
+        }
+        if let Some(decimal) = entity.strip_prefix('#') {
+            return !decimal.is_empty() && decimal.bytes().all(|b| b.is_ascii_digit());
+        }
+        entity.bytes().next().is_some_and(|b| b.is_ascii_alphabetic()) && entity.bytes().all(|b| b.is_ascii_alphanumeric())
+    })
+}
+
+fn child_ids(block: &Value) -> Result<Vec<String>> {
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    let mut result = Vec::new();
+    if let Some(children) = block.get("data").and_then(|d| d.get("childrenIds")) {
+        let Some(children) = children.as_array() else { return Err(bad("edm_import", "childrenIds must be an array")) };
+        if children.len() > 300 || (!matches!(kind, "EmailLayout" | "Container") && !children.is_empty()) {
+            return Err(bad("edm_import", "childrenIds are not valid for this block"));
+        }
+        for id in children {
+            let Some(id) = id.as_str().filter(|id| valid_id(id)) else { return Err(bad("edm_import", "invalid child id")) };
+            result.push(id.to_owned());
+        }
+    }
+    if kind != "ColumnsContainer" {
+        if prop(block, "columns")
+            .and_then(Value::as_array)
+            .is_some_and(|columns| columns.iter().any(|column| column.as_object().is_some_and(|column| column.contains_key("childrenIds"))))
+        {
+            return Err(bad("edm_import", "column childrenIds are not valid for this block"));
+        }
+        return Ok(result);
+    }
+    let count = match prop(block, "columnsCount") {
+        Some(_) => number_prop(block, "columnsCount")
+            .filter(|count| (1.0..=3.0).contains(count) && count.fract() == 0.0)
+            .ok_or_else(|| bad("edm_import", "invalid columnsCount"))?,
+        None => 2.0,
+    };
+    let Some(columns) = prop(block, "columns").and_then(Value::as_array) else {
+        return Err(bad("edm_import", "columns must be an array"));
+    };
+    if columns.len() != count as usize {
+        return Err(bad("edm_import", "column count mismatch"));
+    }
+    for column in columns {
+        let Some(column) = column.as_object() else { return Err(bad("edm_import", "column must be an object")) };
+        if let Some(children) = column.get("childrenIds") {
+            let Some(children) = children.as_array() else { return Err(bad("edm_import", "column childrenIds must be an array")) };
+            if children.len() > 300 {
+                return Err(bad("edm_import", "column child limit exceeded"));
+            }
+            for id in children {
+                let Some(id) = id.as_str().filter(|id| valid_id(id)) else { return Err(bad("edm_import", "invalid column child id")) };
+                result.push(id.to_owned());
+            }
+        }
+    }
+    Ok(result)
+}
+
+fn editable_paths(design: &Value) -> Result<BTreeSet<String>> {
+    let Some(paths) = design.get("policy").and_then(|p| p.get("editableFields")).and_then(Value::as_array) else {
+        return Err(bad("edm_import", "policy.editableFields must be an array"));
+    };
+    let mut result = BTreeSet::new();
+    for path in paths {
+        let Some(path) = path.as_str() else { return Err(bad("edm_import", "editable field must be a string")) };
+        let parts: Vec<_> = path.split('.').collect();
+        if parts.len() != 4 || parts[1] != "data" || parts[2] != "props" {
+            return Err(bad("edm_import", "unsupported editable field"));
+        }
+        let Some(block) = design.get("blocks").and_then(|b| b.get(parts[0])) else {
+            return Err(bad("edm_import", "editable block is missing"));
+        };
+        let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+        let supported = matches!((kind, parts[3]), ("Text" | "Heading", "text") | ("Button", "text" | "url") | ("Image", "url" | "alt" | "linkHref"));
+        let Some(value) = string_prop(block, parts[3]) else {
+            return Err(bad("edm_import", "editable value must be a string"));
+        };
+        if !supported || value.len() > MAX_CONTENT {
+            return Err(bad("edm_import", "unsupported editable field"));
+        }
+        if parts[3] == "text" && value.bytes().any(|b| matches!(b, b'<' | b'>' | b'&')) {
+            return Err(bad("edm_import", "rich text is locked"));
+        }
+        if matches!(parts[3], "url" | "linkHref") && !valid_url(&value, kind == "Image" && parts[3] == "url") {
+            return Err(bad("edm_import", "invalid content URL"));
+        }
+        result.insert(path.to_owned());
+    }
+    Ok(result)
+}
+
+fn validate_design(design: &Value) -> Result<BTreeSet<String>> {
+    if design.to_string().len() > MAX_DESIGN_BYTES
+        || design.get("schemaVersion").and_then(Value::as_u64) != Some(1)
+        || !matches!(design.get("kind").and_then(Value::as_str), Some("template" | "campaign-draft"))
+        || design.get("policy").and_then(|p| p.get("version")).and_then(Value::as_u64) != Some(1)
+        || design.get("source").and_then(|s| s.get("editor")).and_then(Value::as_str) != Some("composer")
+        || !design.get("source").and_then(|s| s.get("nativeArtifact")).is_some_and(Value::is_null)
+        || !design.get("assets").and_then(Value::as_array).is_some_and(Vec::is_empty)
+        || !design.get("dependencies").and_then(Value::as_array).is_some_and(Vec::is_empty)
+        || !design.get("moduleInstances").and_then(Value::as_array).is_some_and(Vec::is_empty)
+        || design.get("rootChildrenIds").and_then(Value::as_array).map(Vec::len) != Some(1)
+        || design.get("rootChildrenIds").and_then(Value::as_array).and_then(|r| r.first()).and_then(Value::as_str) != Some("root")
+        || design.get("blocks").and_then(|b| b.get("root")).and_then(|b| b.get("type")).and_then(Value::as_str) != Some("EmailLayout")
+    {
+        return Err(bad("edm_import", "unsupported canonical handoff"));
+    }
+    let Some(blocks) = design.get("blocks").and_then(Value::as_object) else {
+        return Err(bad("edm_import", "blocks must be an object"));
+    };
+    if blocks.is_empty() || blocks.len() > MAX_BLOCKS {
+        return Err(bad("edm_import", "block limit exceeded"));
+    }
+    let editable = editable_paths(design)?;
+    let mut visited = BTreeSet::new();
+    let mut pending = vec![("root".to_owned(), 1usize)];
+    while let Some((id, depth)) = pending.pop() {
+        if depth > 32 || !visited.insert(id.clone()) {
+            return Err(bad("edm_import", "invalid block graph"));
+        }
+        let Some(block) = blocks.get(&id) else { return Err(bad("edm_import", "missing block")) };
+        for child in child_ids(block)? {
+            pending.push((child, depth + 1));
+        }
+    }
+    if visited.len() != blocks.len() {
+        return Err(bad("edm_import", "orphan block"));
+    }
+    Ok(editable)
+}
+
+/// Image URLs the browser must resolve before import. No URL is fetched by the
+/// engine, and no Base64 is admitted into the canonical document.
+pub fn required_images(design: &Value) -> Result<Vec<ImageRequest>> {
+    validate_design(design)?;
+    let Some(blocks) = design.get("blocks").and_then(Value::as_object) else {
+        return Err(bad("edm_import", "blocks must be an object"));
+    };
+    let mut result = Vec::new();
+    for (id, block) in blocks {
+        if block.get("type").and_then(Value::as_str) == Some("Image") {
+            let Some(url) = string_prop(block, "url") else { return Err(bad("edm_import", "image URL is required")) };
+            if !valid_url(&url, true) {
+                return Err(bad("edm_import", "image URL must be public HTTPS"));
+            }
+            result.push(ImageRequest { block_id: id.clone(), url });
+        }
+    }
+    Ok(result)
+}
+
+fn content_id(block: &BlockMap) -> Result<NodeId> {
+    block.content.ok_or_else(|| bad("edm_snapshot", "mapped content missing"))
+}
+
+/// Changed image URLs whose new bytes the browser relay must resolve before a
+/// snapshot. Unchanged URLs reuse the current native content hash.
+pub fn required_snapshot_images(session: &Session) -> Result<Vec<ImageRequest>> {
+    let ds = session.ds()?;
+    let Some(handoff) = ds.edm.as_ref() else { return Err(bad("edm_snapshot", "handoff missing")) };
+    let mut result = Vec::new();
+    for (id, block) in &handoff.blocks {
+        if block.role != Role::Image {
+            continue;
+        }
+        let content = content_id(block)?;
+        let current = ds.doc.node(block.root).ok_or_else(|| bad("edm_snapshot", "image node missing"))?;
+        let before = handoff.native.node(block.root).ok_or_else(|| bad("edm_snapshot", "baseline image missing"))?;
+        let url = current.plugin_data.get(URL).cloned().unwrap_or_default();
+        let old = before.plugin_data.get(URL).cloned().unwrap_or_default();
+        if url != old {
+            if !valid_url(&url, true) {
+                return Err(bad("edm_snapshot", "image URL must be public HTTPS"));
+            }
+            result.push(ImageRequest { block_id: id.clone(), url });
+        }
+        if !ds.doc.contains(content) || !handoff.native.contains(content) {
+            return Err(bad("edm_snapshot", "image paint missing"));
+        }
+    }
+    Ok(result)
+}
+
+fn metadata(node: &mut Node, block_id: &str, role: &str) {
+    node.plugin_data.insert(BLOCK_ID.into(), block_id.into());
+    node.plugin_data.insert(ROLE.into(), role.into());
+}
+
+fn base_node(doc: &mut Document, parent: NodeId, kind: NodeKind, name: &str, x: f64, y: f64, width: f64, height: f64) -> Result<NodeId> {
+    if ![x, y, width, height].iter().all(|v| v.is_finite()) || width <= 0.0 || height <= 0.0 {
+        return Err(bad("edm_import", "invalid native geometry"));
+    }
+    let id = doc.create(parent, kind, name, 0.0, 0.0, width, height).map_err(|e| bad("edm_import", e.to_string()))?;
+    doc.set_world_transform(id, figcraft_geom::Affine::translate((x, y))).map_err(|e| bad("edm_import", e.to_string()))?;
+    Ok(id)
+}
+
+/// Canonical renderer stack order (`shared/emailRendering/fonts.ts`), then the
+/// metric-compatible OFL families craft-fonts registers, then Inter. The browser
+/// build registers only Inter for Latin text: a family the font database does
+/// not have renders with the default Regular face and silently drops the weight.
+const FONT_STACKS: &[(&str, &[&str])] = &[
+    ("MODERN_SANS", &["Helvetica Neue", "Arial Nova", "Nimbus Sans", "Arial", "Liberation Sans", "Inter"]),
+    ("BOOK_SANS", &["Optima", "Candara", "Noto Sans", "Source Sans 3", "Inter"]),
+    ("ORGANIC_SANS", &["Seravek", "Gill Sans Nova", "Ubuntu", "Calibri", "Carlito", "DejaVu Sans", "Source Sans 3", "Inter"]),
+    ("GEOMETRIC_SANS", &["Avenir", "Avenir Next LT Pro", "Montserrat", "Corbel", "URW Gothic", "Source Sans 3", "Inter"]),
+    ("HEAVY_SANS", &["Bahnschrift", "DIN Alternate", "Franklin Gothic Medium", "Nimbus Sans Narrow", "Inter"]),
+    (
+        "ROUNDED_SANS",
+        &["Hiragino Maru Gothic ProN", "Quicksand", "Comfortaa", "Manjari", "Arial Rounded MT Bold", "Calibri", "Carlito", "Nunito Sans", "Inter"],
+    ),
+    ("MODERN_SERIF", &["Charter", "Bitstream Charter", "Sitka Text", "Cambria", "Caladea", "Source Serif 4", "Liberation Serif", "Inter"]),
+    ("BOOK_SERIF", &["Iowan Old Style", "Palatino Linotype", "URW Palladio L", "P052", "Merriweather", "Liberation Serif", "Inter"]),
+    ("MONOSPACE", &["Nimbus Mono PS", "Courier New", "Cutive Mono", "Liberation Mono", "Inter"]),
+];
+
+fn first_registered_family(stack: &[&str], has_family: impl Fn(&str) -> bool) -> String {
+    stack.iter().copied().find(|family| has_family(family)).unwrap_or("Inter").into()
+}
+
+fn native_font_family(key: &str) -> String {
+    let stack = FONT_STACKS.iter().find(|(name, _)| *name == key).unwrap_or(&FONT_STACKS[0]).1;
+    first_registered_family(stack, figcraft_text::has_family)
+}
+
+fn native_font_weight(value: Option<&str>, fallback: &str) -> String {
+    // Canonical CSS weights and native style names normalise alike, so a
+    // block's own default ("Bold", "Semi Bold") is kept when no override exists.
+    let name = |raw: &str| -> Option<&'static str> {
+        match raw.trim().to_ascii_lowercase().replace([' ', '-', '_'], "").as_str() {
+            "100" | "thin" => Some("Thin"),
+            "200" | "extralight" => Some("Extra Light"),
+            "300" | "light" => Some("Light"),
+            "400" | "normal" | "regular" => Some("Regular"),
+            "500" | "medium" => Some("Medium"),
+            "600" | "semibold" => Some("Semi Bold"),
+            "700" | "bold" => Some("Bold"),
+            "800" | "extrabold" => Some("Extra Bold"),
+            "900" | "black" => Some("Black"),
+            _ => None,
+        }
+    };
+    match value {
+        // An explicit canonical weight wins; an unrecognised one stays Regular, as before.
+        Some(raw) => name(raw).unwrap_or("Regular"),
+        None => name(fallback).unwrap_or("Regular"),
+    }
+    .into()
+}
+
+fn text_align(block: &Value, fallback: TextAlignH) -> TextAlignH {
+    match style_string(block, "textAlign") {
+        Some("center") => TextAlignH::Center,
+        Some("right") => TextAlignH::Right,
+        Some("left") => TextAlignH::Left,
+        _ => fallback,
+    }
+}
+
+fn line_height(block: &Value, fallback: f64) -> LineHeight {
+    let Some(value) = style_value(block, "lineHeight") else { return LineHeight::Percent(fallback * 100.0) };
+    if let Some(number) = value.as_f64().filter(|v| v.is_finite()) {
+        return LineHeight::Percent(number * 100.0);
+    }
+    let Some(text) = value.as_str().map(str::trim) else { return LineHeight::Percent(fallback * 100.0) };
+    if let Some(number) = text.strip_suffix("px").and_then(|v| v.trim().parse::<f64>().ok()).filter(|v| v.is_finite()) {
+        return LineHeight::Pixels(number);
+    }
+    if let Some(number) = text.strip_suffix('%').and_then(|v| v.trim().parse::<f64>().ok()).filter(|v| v.is_finite()) {
+        return LineHeight::Percent(number);
+    }
+    if let Some(number) =
+        text.strip_suffix("rem").or_else(|| text.strip_suffix("em")).and_then(|v| v.trim().parse::<f64>().ok()).filter(|v| v.is_finite())
+    {
+        return LineHeight::Percent(number * 100.0);
+    }
+    text.parse::<f64>().ok().filter(|v| v.is_finite()).map_or(LineHeight::Percent(fallback * 100.0), |v| LineHeight::Percent(v * 100.0))
+}
+
+fn text_data(block: &Value, content: String, spec: TextSpec, theme: &Theme) -> TextData {
+    let family =
+        native_font_family(if spec.honor_text_style { style_string(block, "fontFamily").unwrap_or(&theme.font_family) } else { &theme.font_family });
+    let weight = if spec.honor_font_weight { native_font_weight(style_string(block, "fontWeight"), spec.weight) } else { spec.weight.into() };
+    let mut data = TextData::new(content);
+    data.style = TextStyle {
+        font_family: family,
+        font_style: weight,
+        font_size: if spec.honor_text_style { style_number(block, "fontSize").unwrap_or(spec.size) } else { spec.size },
+        line_height: if spec.honor_text_style { line_height(block, spec.line_height) } else { LineHeight::Percent(spec.line_height * 100.0) },
+        letter_spacing: if spec.honor_text_style {
+            style_number(block, "letterSpacing").map_or(LetterSpacing::Pixels(0.0), LetterSpacing::Pixels)
+        } else {
+            LetterSpacing::Pixels(0.0)
+        },
+        case: if spec.honor_text_style {
+            match style_string(block, "textTransform") {
+                Some("uppercase") => TextCase::Upper,
+                Some("lowercase") => TextCase::Lower,
+                Some("capitalize") => TextCase::Title,
+                _ => TextCase::Original,
+            }
+        } else {
+            TextCase::Original
+        },
+        fills: Some(vec![Paint::solid(spec.color)]),
+        ..TextStyle::default()
+    };
+    data.auto_resize = TextAutoResize::None;
+    data.align_h = if spec.honor_text_style { text_align(block, spec.align) } else { spec.align };
+    data
+}
+
+// Display-only strict inline grammar. Unknown syntax fails the entire projection;
+// canonical HTML is never passed back through this parser or reconstructed from runs.
+fn rich_entities(raw: &str) -> Option<String> {
+    let mut out = String::new();
+    let mut rest = raw;
+    while let Some(i) = rest.find('&') {
+        out.push_str(&rest[..i]);
+        rest = &rest[i + 1..];
+        let end = rest.find(';').filter(|n| *n <= 32)?;
+        let entity = &rest[..end];
+        let ch = match entity {
+            "amp" => '&',
+            "lt" => '<',
+            "gt" => '>',
+            "quot" => '"',
+            "apos" => '\'',
+            "nbsp" => '\u{a0}',
+            "copy" => '©',
+            "reg" => '®',
+            "trade" => '™',
+            "ndash" => '–',
+            "mdash" => '—',
+            "hellip" => '…',
+            "lsquo" => '‘',
+            "rsquo" => '’',
+            "ldquo" => '“',
+            "rdquo" => '”',
+            _ => {
+                let n = if let Some(h) = entity.strip_prefix("#x").or_else(|| entity.strip_prefix("#X")) {
+                    if h.is_empty() || !h.bytes().all(|b| b.is_ascii_hexdigit()) {
+                        return None;
+                    }
+                    u32::from_str_radix(h, 16).ok()?
+                } else {
+                    let d = entity.strip_prefix('#')?;
+                    if d.is_empty() || !d.bytes().all(|b| b.is_ascii_digit()) {
+                        return None;
+                    }
+                    d.parse::<u32>().ok()?
+                };
+                char::from_u32(n)?
+            }
+        };
+        if ch.is_control() && ch != '\n' && ch != '\t' {
+            return None;
+        }
+        out.push(ch);
+        rest = &rest[end + 1..];
+    }
+    out.push_str(rest);
+    Some(out)
+}
+
+fn rich_css(raw: &str, style: &mut TextStyle, align: &mut TextAlignH, outer: bool) -> Option<()> {
+    for declaration in raw.split(';').filter(|s| !s.trim().is_empty()) {
+        let (key, value) = declaration.split_once(':')?;
+        let value = value.trim();
+        let number = |s: &str| s.parse::<f64>().ok().filter(|n| n.is_finite() && *n > 0.0 && *n <= 512.0);
+        match key.trim().to_ascii_lowercase().as_str() {
+            "font-size" => style.font_size = number(value.strip_suffix("px")?)?,
+            "line-height" => {
+                style.line_height = if let Some(px) = value.strip_suffix("px") {
+                    LineHeight::Pixels(number(px)?)
+                } else {
+                    LineHeight::Percent(number(value)? * 100.0)
+                }
+            }
+            "color" => style.fills = Some(vec![Paint::solid(Color::parse_css(value)?)]),
+            "font-weight" => {
+                if !matches!(value, "normal" | "bold" | "100" | "200" | "300" | "400" | "500" | "600" | "700" | "800" | "900") {
+                    return None;
+                }
+                let italic = style.italic();
+                style.font_style = native_font_weight(Some(value), "Regular");
+                if italic {
+                    style.font_style.push_str(" Italic");
+                }
+            }
+            "font-style" => {
+                let base = style.font_style.trim_end_matches(" Italic").trim_end_matches("Italic").trim();
+                style.font_style = match value {
+                    "normal" => {
+                        if base.is_empty() {
+                            "Regular".into()
+                        } else {
+                            base.into()
+                        }
+                    }
+                    "italic" => format!("{} Italic", if base.is_empty() { "Regular" } else { base }),
+                    _ => return None,
+                };
+            }
+            "font-family" => {
+                let families = value.split(',').map(|s| s.trim().trim_matches(['\'', '"'])).collect::<Vec<_>>();
+                if families.iter().any(|s| s.is_empty()) {
+                    return None;
+                }
+                style.font_family = families.iter().find(|s| figcraft_text::has_family(s)).copied().unwrap_or("Inter").into();
+            }
+            "text-decoration" => {
+                style.decoration = match value {
+                    "underline" => figcraft_doc::TextDecoration::Underline,
+                    "line-through" => figcraft_doc::TextDecoration::Strikethrough,
+                    "none" => figcraft_doc::TextDecoration::None,
+                    _ => return None,
+                }
+            }
+            "text-align" if outer => {
+                *align = match value {
+                    "left" => TextAlignH::Left,
+                    "center" => TextAlignH::Center,
+                    "right" => TextAlignH::Right,
+                    _ => return None,
+                }
+            }
+            "margin" | "padding" if matches!(value, "0" | "0px") => {}
+            "display" if value == "inline" || (outer && value == "block") => {}
+            _ => return None,
+        }
+    }
+    Some(())
+}
+
+fn rich_projection(raw: &str, mut data: TextData) -> Option<TextData> {
+    if raw.len() > MAX_CONTENT || raw.chars().any(|c| c.is_control() && !matches!(c, '\n' | '\r' | '\t')) {
+        return None;
+    }
+    data.characters.clear();
+    data.runs.clear();
+    let mut stack: Vec<(String, TextStyle, usize)> = vec![(String::new(), data.style.clone(), 0)];
+    let mut rest = raw;
+    let mut count = 0;
+    let mut tokens = 0;
+    let mut paragraph_break = false;
+    let mut whole_wrapper = false;
+    while !rest.is_empty() {
+        tokens += 1;
+        if tokens > 1024 {
+            return None;
+        }
+        if !rest.starts_with('<') {
+            let end = rest.find('<').unwrap_or(rest.len());
+            let text = rich_entities(&rest[..end])?;
+            rest = &rest[end..];
+            let style = &stack.last()?.1;
+            if paragraph_break && !text.is_empty() {
+                data.characters.push('\n');
+                data.runs.push(figcraft_doc::StyleRun { start: count, end: count + 1, style: stack.last()?.1.clone() });
+                count += 1;
+                paragraph_break = false;
+            }
+            let start = count;
+            count += text.chars().count();
+            data.characters.push_str(&text);
+            data.runs.push(figcraft_doc::StyleRun { start, end: count, style: style.clone() });
+            continue;
+        }
+        // Quote-aware token boundary: '>' inside a destination is not a tag end.
+        let mut quote = None;
+        let mut end = None;
+        for (i, ch) in rest.char_indices().skip(1) {
+            match (quote, ch) {
+                (Some(q), c) if c == q => quote = None,
+                (None, '\'' | '"') => quote = Some(ch),
+                (None, '>') => {
+                    end = Some(i);
+                    break;
+                }
+                _ => {}
+            }
+        }
+        let end = end?;
+        let token = &rest[1..end];
+        rest = &rest[end + 1..];
+        if let Some(close) = token.strip_prefix('/') {
+            let name = close.trim().to_ascii_lowercase();
+            if stack.len() == 1 || stack.last()?.0 != name {
+                return None;
+            }
+            if matches!(name.as_str(), "p" | "div") && count == stack.last()?.2 {
+                return None;
+            }
+            stack.pop();
+            if whole_wrapper && stack.len() == 1 && !rest.is_empty() {
+                return None;
+            }
+            if matches!(name.as_str(), "p" | "div") {
+                paragraph_break = true;
+            }
+            continue;
+        }
+        let token = token.trim();
+        let name_end = token.find(|c: char| !c.is_ascii_alphanumeric()).unwrap_or(token.len());
+        let name = token[..name_end].to_ascii_lowercase();
+        if !matches!(name.as_str(), "a" | "span" | "b" | "strong" | "i" | "em" | "u" | "s" | "br" | "p" | "div") {
+            return None;
+        }
+        let mut attrs = token[name_end..].trim();
+        if name == "br" {
+            if !attrs.is_empty() && attrs != "/" {
+                return None;
+            }
+            data.characters.push('\n');
+            data.runs.push(figcraft_doc::StyleRun { start: count, end: count + 1, style: stack.last()?.1.clone() });
+            count += 1;
+            paragraph_break = false;
+            continue;
+        }
+        if stack.len() > 32 || (name == "a" && stack.iter().any(|s| s.0 == "a")) {
+            return None;
+        }
+        let outer = stack.len() == 1 && data.characters.is_empty() && rest.ends_with(&format!("</{name}>"));
+        let mut style = stack.last()?.1.clone();
+        match name.as_str() {
+            "b" | "strong" => style.font_style = if style.italic() { "Bold Italic" } else { "Bold" }.into(),
+            "i" | "em" if !style.italic() => style.font_style.push_str(" Italic"),
+            "u" | "a" => style.decoration = figcraft_doc::TextDecoration::Underline,
+            "s" => style.decoration = figcraft_doc::TextDecoration::Strikethrough,
+            _ => {}
+        }
+        let mut seen = BTreeSet::new();
+        while !attrs.is_empty() {
+            let n = attrs.find(|c: char| !c.is_ascii_alphanumeric() && c != '-').unwrap_or(attrs.len());
+            let key = attrs[..n].to_ascii_lowercase();
+            if key.is_empty() || !seen.insert(key.clone()) {
+                return None;
+            }
+            attrs = attrs[n..].trim_start().strip_prefix('=')?.trim_start();
+            let q = attrs.chars().next()?;
+            if q != '\'' && q != '"' {
+                return None;
+            }
+            attrs = &attrs[1..];
+            let n = attrs.find(q)?;
+            let value = rich_entities(&attrs[..n])?;
+            attrs = &attrs[n + 1..];
+            if !attrs.is_empty() && !attrs.starts_with(char::is_whitespace) {
+                return None;
+            }
+            attrs = attrs.trim_start();
+            match key.as_str() {
+                "style" => {
+                    rich_css(&value, &mut style, &mut data.align_h, outer)?;
+                    if outer
+                        && value.split(';').any(|d| {
+                            d.split_once(':').is_some_and(|(k, v)| {
+                                k.trim().eq_ignore_ascii_case("text-align") || (k.trim().eq_ignore_ascii_case("display") && v.trim() == "block")
+                            })
+                        })
+                    {
+                        whole_wrapper = true;
+                    }
+                }
+                "href" if name == "a" => {
+                    if !valid_url(&value, false) {
+                        return None;
+                    }
+                    style.link = Some(value);
+                }
+                "target" if name == "a" && matches!(value.as_str(), "_blank" | "_self") => {}
+                "rel" if name == "a" && value.split_whitespace().all(|v| matches!(v, "noopener" | "noreferrer" | "nofollow")) => {}
+                _ => return None,
+            }
+        }
+        if matches!(name.as_str(), "p" | "div") && !data.characters.is_empty() {
+            paragraph_break = true;
+        }
+        stack.push((name, style, count));
+    }
+    if stack.len() != 1 {
+        return None;
+    }
+    data.normalize();
+    Some(data)
+}
+
+fn measured_text_height(data: &TextData, width: f64) -> Result<f64> {
+    if !width.is_finite() || width <= 0.0 {
+        return Err(bad("edm_import", "text width must be positive"));
+    }
+    let height = figcraft_text::layout(data, Some(width), None).height;
+    if !height.is_finite() {
+        return Err(bad("edm_import", "text measurement failed"));
+    }
+    Ok(height.max(1.0))
+}
+
+fn natural_text_width(data: &TextData) -> f64 {
+    figcraft_text::layout(data, None, None).width.ceil().max(1.0)
+}
+
+fn apply_frame_style(node: &mut Node, block: &Value, background: Option<Color>) {
+    node.fills = background.map_or_else(Vec::new, |color| vec![Paint::solid(color)]);
+    if let Some(opacity) = style_number(block, "opacity") {
+        node.opacity = opacity.clamp(0.0, 1.0) as f32;
+    }
+    if let Some(radius) = style_number(block, "borderRadius").filter(|v| *v > 0.0) {
+        node.corners.radii = [radius; 4];
+    }
+    let border_style = style_string(block, "borderStyle");
+    if let Some(width) = style_number(block, "borderWidth").filter(|v| *v > 0.0)
+        && matches!(border_style, Some("solid" | "dashed" | "dotted" | "double"))
+    {
+        let color = style_color(block, "borderColor", Some(Color::BLACK)).unwrap_or(Color::BLACK);
+        node.strokes = vec![Paint::solid(color)];
+        node.stroke.weight = width;
+        node.stroke.dashes = match border_style {
+            Some("dashed") => vec![width * 3.0, width * 2.0],
+            Some("dotted") => vec![width, width],
+            _ => Vec::new(),
+        };
+    }
+    let shadow = match style_string(block, "boxShadow") {
+        Some("sm") => Some((1.0, 2.0, 0.06)),
+        Some("md") => Some((4.0, 8.0, 0.10)),
+        Some("lg") => Some((10.0, 24.0, 0.15)),
+        _ => None,
+    };
+    if let Some((y, blur, alpha)) = shadow {
+        let mut effect = figcraft_doc::Effect::drop_shadow();
+        if let EffectKind::DropShadow(value) = &mut effect.kind {
+            value.color = Color::new(0.0, 0.0, 0.0, alpha);
+            value.offset = (0.0, y);
+            value.radius = blur;
+        }
+        node.effects.push(effect);
+    }
+}
+
+fn wrapper(
+    doc: &mut Document,
+    parent: NodeId,
+    id: &str,
+    name: &str,
+    x: f64,
+    y: f64,
+    width: f64,
+    block: &Value,
+    background: Option<Color>,
+) -> Result<NodeId> {
+    let root = base_node(doc, parent, NodeKind::Frame, name, x, y, width, 1.0)?;
+    let node = doc.get_mut(root).map_err(|e| bad("edm_import", e.to_string()))?;
+    metadata(node, id, "block");
+    node.locked = false;
+    apply_frame_style(node, block, background);
+    Ok(root)
+}
+
+fn add_text(
+    doc: &mut Document,
+    parent: NodeId,
+    id: &str,
+    role: &str,
+    x: f64,
+    y: f64,
+    width: f64,
+    data: TextData,
+    color: Color,
+) -> Result<(NodeId, f64)> {
+    let height = measured_text_height(&data, width)?;
+    let node_id = base_node(doc, parent, NodeKind::Text(data), "Email text", x, y, width, height)?;
+    let node = doc.get_mut(node_id).map_err(|e| bad("edm_import", e.to_string()))?;
+    metadata(node, id, role);
+    node.locked = true;
+    node.fills = vec![Paint::solid(color)];
+    Ok((node_id, height))
+}
+
+fn set_height(doc: &mut Document, id: NodeId, height: f64) -> Result<()> {
+    if !height.is_finite() || height <= 0.0 {
+        return Err(bad("edm_import", "invalid block height"));
+    }
+    doc.get_mut(id).map_err(|e| bad("edm_import", e.to_string()))?.height = height;
+    Ok(())
+}
+
+fn root_theme(block: &Value) -> Theme {
+    Theme {
+        font_family: string_prop(block, "fontFamily").unwrap_or_else(|| "MODERN_SANS".into()),
+        text_color: css_color(prop(block, "textColor")),
+        canvas_color: css_color(prop(block, "canvasColor")).unwrap_or(Color::WHITE),
+    }
+}
+
+fn canvas_width(block: &Value) -> f64 {
+    number_prop(block, "contentWidth").filter(|v| *v != 0.0).unwrap_or(600.0).clamp(320.0, 960.0)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn import_block(
+    doc: &mut Document,
+    blocks: &serde_json::Map<String, Value>,
+    id: &str,
+    parent: NodeId,
+    x: f64,
+    y: f64,
+    width: f64,
+    images: &BTreeMap<String, NativeImage>,
+    editable: &BTreeSet<String>,
+    mapping: &mut BTreeMap<String, BlockMap>,
+    inherited: &Theme,
+) -> Result<(NodeId, f64)> {
+    let Some(block) = blocks.get(id) else { return Err(bad("edm_import", "missing block")) };
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    let mut content = None;
+    let role = match kind {
+        "Text" | "Heading" if string_prop(block, "text").is_some_and(|text| has_rich_text_markup(&text)) => Role::Other,
+        "Text" | "Heading" => Role::Text,
+        "Button" => Role::Button,
+        "Image" => Role::Image,
+        _ => Role::Other,
+    };
+    let theme = if kind == "EmailLayout" { root_theme(block) } else { inherited.clone() };
+    let (root, height) = match kind {
+        "EmailLayout" | "Container" => {
+            let pad = if kind == "EmailLayout" { Padding::ZERO } else { padding(block, Padding::DEFAULT) };
+            let background = if kind == "EmailLayout" {
+                Some(theme.canvas_color)
+            } else {
+                style_color(block, "backgroundColor", css_color(prop(block, "backgroundColor")))
+            };
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, background)?;
+            if kind == "EmailLayout" {
+                let backdrop = css_color(prop(block, "backdropColor")).unwrap_or(Color::from_rgb8_const(0xF5, 0xF5, 0xF5));
+                if let NodeKind::Page { background, .. } = &mut doc.get_mut(parent).map_err(|e| bad("edm_import", e.to_string()))?.kind {
+                    *background = backdrop;
+                }
+                let radius = number_prop(block, "borderRadius").filter(|v| *v > 0.0).unwrap_or(0.0);
+                let border = css_color(prop(block, "borderColor"));
+                let node = doc.get_mut(root).map_err(|e| bad("edm_import", e.to_string()))?;
+                node.corners.radii = [radius; 4];
+                if let Some(color) = border {
+                    node.strokes = vec![Paint::solid(color)];
+                    node.stroke.weight = 1.0;
+                }
+            }
+            let mut child_y = y + pad.top;
+            for child_id in child_ids(block)? {
+                let (_, child_height) =
+                    import_block(doc, blocks, &child_id, root, x + pad.left, child_y, width - pad.horizontal(), images, editable, mapping, &theme)?;
+                child_y += child_height;
+            }
+            (root, (child_y - y + pad.bottom).max(1.0))
+        }
+        "ColumnsContainer" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let background = style_color(block, "backgroundColor", None);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, background)?;
+            let columns = prop(block, "columns").and_then(Value::as_array).cloned().unwrap_or_default();
+            let count = columns.len();
+            if count == 0 {
+                return Err(bad("edm_import", "columns must not be empty"));
+            }
+            let gap = number_prop(block, "columnsGap").unwrap_or(16.0).max(0.0);
+            let fixed = prop(block, "fixedWidths").and_then(Value::as_array).cloned().unwrap_or_default();
+            let inner = width - pad.horizontal();
+            if !inner.is_finite() || inner <= 0.0 {
+                return Err(bad("edm_import", "column content width must be positive"));
+            }
+            let mut widths = (0..count)
+                .map(|index| fixed.get(index).and_then(Value::as_f64).filter(|v| v.is_finite() && *v > 0.0).unwrap_or(0.0))
+                .collect::<Vec<_>>();
+            let fixed_total: f64 = widths.iter().sum();
+            let automatic = widths.iter().filter(|v| **v == 0.0).count();
+            if automatic == 0 && fixed_total > inner {
+                for column_width in &mut widths {
+                    *column_width *= inner / fixed_total;
+                }
+            } else if automatic > 0 {
+                if fixed_total >= inner {
+                    widths.fill(inner / count as f64);
+                } else {
+                    let automatic_width = (inner - fixed_total) / automatic as f64;
+                    for column_width in &mut widths {
+                        if *column_width == 0.0 {
+                            *column_width = automatic_width;
+                        }
+                    }
+                }
+            }
+            let mut offset = 0.0;
+            let mut tallest: f64 = 0.0;
+            let mut frames = Vec::new();
+            for (index, column) in columns.iter().enumerate() {
+                let Some(column_width) = widths.get(index).copied() else { return Err(bad("edm_import", "column width missing")) };
+                let frame = base_node(doc, root, NodeKind::Frame, "Email column", x + pad.left + offset, y + pad.top, column_width, 40.0)?;
+                metadata(doc.get_mut(frame).map_err(|e| bad("edm_import", e.to_string()))?, id, "column");
+                let inset = gap.min((column_width - 1.0).max(0.0)) / 2.0;
+                let mut child_y = y + pad.top;
+                if let Some(children) = column.get("childrenIds").and_then(Value::as_array) {
+                    for child in children {
+                        let Some(child_id) = child.as_str() else { return Err(bad("edm_import", "child id must be a string")) };
+                        let (_, child_height) = import_block(
+                            doc,
+                            blocks,
+                            child_id,
+                            frame,
+                            x + pad.left + offset + inset,
+                            child_y,
+                            column_width - inset * 2.0,
+                            images,
+                            editable,
+                            mapping,
+                            &theme,
+                        )?;
+                        child_y += child_height;
+                    }
+                }
+                let column_height = (child_y - (y + pad.top)).max(40.0);
+                tallest = tallest.max(column_height);
+                frames.push((frame, column_height));
+                offset += column_width;
+            }
+            let alignment = string_prop(block, "contentAlignment").unwrap_or_else(|| "top".into());
+            for (frame, content_height) in frames {
+                let remaining = (tallest - content_height).max(0.0);
+                let offset_y = if alignment == "middle" {
+                    remaining / 2.0
+                } else if alignment == "bottom" {
+                    remaining
+                } else {
+                    0.0
+                };
+                if offset_y > 0.0 {
+                    let children = doc.node(frame).map(|node| node.children.clone()).ok_or_else(|| bad("edm_import", "column frame missing"))?;
+                    for child in children {
+                        let bounds = doc.world_bounds(child).ok_or_else(|| bad("edm_import", "column child bounds missing"))?;
+                        doc.set_world_transform(child, figcraft_geom::Affine::translate((bounds.x0, bounds.y0 + offset_y)))
+                            .map_err(|e| bad("edm_import", e.to_string()))?;
+                    }
+                }
+                set_height(doc, frame, tallest)?;
+            }
+            (root, pad.vertical() + tallest)
+        }
+        "Text" | "Heading" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            let default_size = if kind == "Text" {
+                16.0
+            } else {
+                match string_prop(block, "level").as_deref() {
+                    Some("h1") => 32.0,
+                    Some("h3") => 20.0,
+                    Some("h4") => 18.0,
+                    Some("h5") => 16.0,
+                    Some("h6") => 14.0,
+                    _ => 24.0,
+                }
+            };
+            let fallback = if kind == "Text" { Color::from_rgb8_const(0x37, 0x41, 0x51) } else { Color::from_rgb8_const(0x11, 0x18, 0x27) };
+            let color = style_color(block, "color", theme.text_color).unwrap_or(fallback);
+            let content_text = if role == Role::Other {
+                format!("Rich {kind} block — unsupported markup preserved in XeroFlow")
+            } else {
+                string_prop(block, "text").unwrap_or_default()
+            };
+            let mut data = text_data(
+                block,
+                content_text,
+                TextSpec {
+                    size: default_size,
+                    weight: if kind == "Heading" { "Bold" } else { "Regular" },
+                    line_height: if kind == "Heading" { 1.3 } else { 1.6 },
+                    color,
+                    align: TextAlignH::Left,
+                    honor_text_style: true,
+                    honor_font_weight: true,
+                },
+                &theme,
+            );
+            if role == Role::Other {
+                let original = string_prop(block, "text").unwrap_or_default();
+                data = rich_projection(&original, data.clone()).unwrap_or_else(|| {
+                    data.characters = format!("Rich {kind} (protected) — open compiled preview");
+                    data
+                });
+            }
+            let (text, text_height) = add_text(doc, root, id, "text", x + pad.left, y + pad.top, width - pad.horizontal(), data, color)?;
+            doc.get_mut(text).map_err(|e| bad("edm_import", e.to_string()))?.locked =
+                role == Role::Other || !editable.contains(&format!("{id}.data.props.text"));
+            if role == Role::Other {
+                doc.get_mut(text).map_err(|e| bad("edm_import", e.to_string()))?.name = "Rich text (protected)".into();
+            }
+            content = Some(text);
+            (root, pad.vertical() + text_height)
+        }
+        "Button" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            if let Some(value) = string_prop(block, "url") {
+                doc.get_mut(root).map_err(|e| bad("edm_import", e.to_string()))?.plugin_data.insert(URL.into(), value);
+            }
+            metadata(doc.get_mut(root).map_err(|e| bad("edm_import", e.to_string()))?, id, "button");
+            let text_color = css_color(prop(block, "buttonTextColor")).unwrap_or(Color::WHITE);
+            let data = text_data(
+                block,
+                string_prop(block, "text").unwrap_or_else(|| "Click here".into()),
+                TextSpec {
+                    size: 16.0,
+                    weight: "Semi Bold",
+                    line_height: 1.0,
+                    color: text_color,
+                    align: TextAlignH::Center,
+                    honor_text_style: true,
+                    honor_font_weight: true,
+                },
+                &theme,
+            );
+            let (inner_y, inner_x) = match string_prop(block, "size").as_deref() {
+                Some("x-small") => (6.0, 12.0),
+                Some("small") => (8.0, 16.0),
+                Some("large") => (16.0, 32.0),
+                _ => (12.0, 24.0),
+            };
+            let available = width - pad.horizontal();
+            let full_width = bool_prop(block, "fullWidth", false);
+            let body_width = if full_width { available } else { (natural_text_width(&data) + inner_x * 2.0).min(available) };
+            let text_height = measured_text_height(&data, (body_width - inner_x * 2.0).max(1.0))?;
+            let body_height = text_height + inner_y * 2.0;
+            let align = style_string(block, "textAlign").unwrap_or("left");
+            let remaining = (available - body_width).max(0.0);
+            let body_x = x
+                + pad.left
+                + if align == "center" {
+                    remaining / 2.0
+                } else if align == "right" {
+                    remaining
+                } else {
+                    0.0
+                };
+            let body = base_node(doc, root, NodeKind::Frame, "Button body", body_x, y + pad.top, body_width, body_height)?;
+            metadata(doc.get_mut(body).map_err(|e| bad("edm_import", e.to_string()))?, id, "button.body");
+            let button_color = css_color(prop(block, "buttonBackgroundColor")).unwrap_or(Color::from_rgb8_const(0x2f, 0x45, 0x74));
+            let radius =
+                style_number(block, "borderRadius").filter(|v| *v > 0.0).unwrap_or_else(|| match string_prop(block, "buttonStyle").as_deref() {
+                    Some("pill") => 9999.0,
+                    Some("square") => 0.0,
+                    _ => 8.0,
+                });
+            {
+                let node = doc.get_mut(body).map_err(|e| bad("edm_import", e.to_string()))?;
+                node.fills = vec![Paint::solid(button_color)];
+                node.corners.radii = [radius; 4];
+                node.locked = false;
+            }
+            let (text, _) = add_text(
+                doc,
+                body,
+                id,
+                "button.text",
+                body_x + inner_x,
+                y + pad.top + inner_y,
+                (body_width - inner_x * 2.0).max(1.0),
+                data,
+                text_color,
+            )?;
+            doc.get_mut(text).map_err(|e| bad("edm_import", e.to_string()))?.locked = !editable.contains(&format!("{id}.data.props.text"));
+            content = Some(text);
+            (root, pad.vertical() + body_height)
+        }
+        "Image" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            {
+                let node = doc.get_mut(root).map_err(|e| bad("edm_import", e.to_string()))?;
+                metadata(node, id, "image");
+                node.locked = false;
+                if let Some(value) = string_prop(block, "url") {
+                    node.plugin_data.insert(URL.into(), value);
+                }
+                if let Some(value) = string_prop(block, "alt") {
+                    node.plugin_data.insert(ALT.into(), value);
+                }
+                if let Some(value) = string_prop(block, "linkHref") {
+                    node.plugin_data.insert(LINK.into(), value);
+                }
+            }
+            if string_prop(block, "url").is_some_and(|url| url.is_empty()) {
+                let color = Color::from_rgb8_const(0x9C, 0xA3, 0xAF);
+                let data = text_data(
+                    block,
+                    "No image selected — image asset required".into(),
+                    TextSpec {
+                        size: 14.0,
+                        weight: "Regular",
+                        line_height: 1.4,
+                        color,
+                        align: TextAlignH::Center,
+                        honor_text_style: false,
+                        honor_font_weight: false,
+                    },
+                    &theme,
+                );
+                let (_, text_height) = add_text(doc, root, id, "compound.text", x + pad.left, y + pad.top, width - pad.horizontal(), data, color)?;
+                (root, pad.vertical() + text_height)
+            } else {
+                let Some(image) = images.get(id) else { return Err(bad("edm_import", "image bytes are required")) };
+                if image.data.width == 0 || image.data.height == 0 {
+                    return Err(bad("edm_import", "invalid image dimensions"));
+                }
+                let available = width - pad.horizontal();
+                let image_width = number_prop(block, "width").filter(|v| *v > 0.0).unwrap_or(available).min(available);
+                let image_height = image_width * f64::from(image.data.height) / f64::from(image.data.width);
+                let align = string_prop(block, "contentAlignment")
+                    .or_else(|| style_string(block, "textAlign").map(str::to_owned))
+                    .unwrap_or_else(|| "left".into());
+                let remaining = (available - image_width).max(0.0);
+                let image_x = x
+                    + pad.left
+                    + if align == "center" {
+                        remaining / 2.0
+                    } else if align == "right" {
+                        remaining
+                    } else {
+                        0.0
+                    };
+                let paint = base_node(doc, root, NodeKind::Rectangle, "Email image", image_x, y + pad.top, image_width, image_height)?;
+                {
+                    let node = doc.get_mut(paint).map_err(|e| bad("edm_import", e.to_string()))?;
+                    metadata(node, id, "image.paint");
+                    node.locked = true;
+                    node.fills = vec![Paint::image(image.hash.clone(), figcraft_color::ImageScaleMode::Fit)];
+                }
+                content = Some(paint);
+                (root, pad.vertical() + image_height)
+            }
+        }
+        "Divider" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            let thickness = number_prop(block, "lineThickness").or_else(|| number_prop(block, "lineHeight")).filter(|v| *v > 0.0).unwrap_or(1.0);
+            let line = base_node(doc, root, NodeKind::Rectangle, "Email divider", x + pad.left, y + pad.top, width - pad.horizontal(), thickness)?;
+            let color = css_color(prop(block, "lineColor")).unwrap_or(Color::from_rgb8_const(0xE5, 0xE7, 0xEB));
+            doc.get_mut(line).map_err(|e| bad("edm_import", e.to_string()))?.fills = vec![Paint::solid(color)];
+            (root, pad.vertical() + thickness)
+        }
+        "Spacer" => {
+            let height = number_prop(block, "height").filter(|v| *v > 0.0).unwrap_or(24.0);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            (root, height)
+        }
+        "menu" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            let separator = string_prop(block, "separator").unwrap_or_else(|| "|".into());
+            let items = prop(block, "items").and_then(Value::as_array).cloned().unwrap_or_default();
+            let labels = items
+                .iter()
+                .filter_map(|item| {
+                    let label = item.get("label").and_then(Value::as_str).unwrap_or_default();
+                    let url = item.get("url").and_then(Value::as_str).unwrap_or_default();
+                    (!label.is_empty() && !url.is_empty()).then_some(label.to_owned())
+                })
+                .collect::<Vec<_>>();
+            let color = style_color(block, "color", theme.text_color).unwrap_or(Color::from_rgb8_const(0x11, 0x18, 0x27));
+            let data = text_data(
+                block,
+                labels.join(&format!(" {separator} ")),
+                TextSpec {
+                    size: 14.0,
+                    weight: "Regular",
+                    line_height: 1.3,
+                    color,
+                    align: TextAlignH::Center,
+                    honor_text_style: false,
+                    honor_font_weight: false,
+                },
+                &theme,
+            );
+            let (_, text_height) = add_text(doc, root, id, "compound.text", x + pad.left, y + pad.top, width - pad.horizontal(), data, color)?;
+            (root, pad.vertical() + text_height)
+        }
+        "feature-grid" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, style_color(block, "backgroundColor", None))?;
+            let features = prop(block, "features").and_then(Value::as_array).cloned().unwrap_or_default();
+            if features.is_empty() {
+                let color = style_color(block, "color", theme.text_color).unwrap_or(Color::from_rgb8_const(0x6B, 0x72, 0x80));
+                let data = text_data(
+                    block,
+                    "No features".into(),
+                    TextSpec {
+                        size: 14.0,
+                        weight: "Regular",
+                        line_height: 1.3,
+                        color,
+                        align: TextAlignH::Center,
+                        honor_text_style: false,
+                        honor_font_weight: false,
+                    },
+                    &theme,
+                );
+                let (_, text_height) = add_text(doc, root, id, "compound.text", x + pad.left, y + pad.top, width - pad.horizontal(), data, color)?;
+                (root, pad.vertical() + text_height)
+            } else {
+                let count = number_prop(block, "columns").unwrap_or(3.0).max(1.0).min(features.len() as f64) as usize;
+                let column_width = (width - pad.horizontal()) / count as f64;
+                let icon_color = css_color(prop(block, "iconColor")).unwrap_or(Color::from_rgb8_const(0x3B, 0x82, 0xF6));
+                let heading_color = Color::from_rgb8_const(0x11, 0x18, 0x27);
+                let description_color = Color::from_rgb8_const(0x6B, 0x72, 0x80);
+                let mut total_height: f64 = 0.0;
+                let mut row_height: f64 = 0.0;
+                for (index, feature) in features.iter().enumerate() {
+                    if index > 0 && index % count == 0 {
+                        total_height += row_height;
+                        row_height = 0.0;
+                    }
+                    let feature_x = x + pad.left + (index % count) as f64 * column_width;
+                    let feature_y = y + pad.top + total_height;
+                    let column = base_node(doc, root, NodeKind::Frame, "Email feature", feature_x, feature_y, column_width, 40.0)?;
+                    metadata(doc.get_mut(column).map_err(|e| bad("edm_import", e.to_string()))?, id, "feature.column");
+                    let text_width = (column_width - 16.0).max(1.0);
+                    let icon = feature.get("icon").and_then(Value::as_str).unwrap_or_default().to_owned();
+                    let heading = feature.get("heading").and_then(Value::as_str).unwrap_or_default().to_owned();
+                    let description = feature.get("description").and_then(Value::as_str).unwrap_or_default().to_owned();
+                    let icon_data = text_data(
+                        block,
+                        icon,
+                        TextSpec {
+                            size: 32.0,
+                            weight: "Regular",
+                            line_height: 1.2,
+                            color: icon_color,
+                            align: TextAlignH::Center,
+                            honor_text_style: false,
+                            honor_font_weight: false,
+                        },
+                        &theme,
+                    );
+                    let heading_data = text_data(
+                        block,
+                        heading,
+                        TextSpec {
+                            size: 16.0,
+                            weight: "Bold",
+                            line_height: 1.3,
+                            color: heading_color,
+                            align: TextAlignH::Center,
+                            honor_text_style: false,
+                            honor_font_weight: false,
+                        },
+                        &theme,
+                    );
+                    let description_data = text_data(
+                        block,
+                        description,
+                        TextSpec {
+                            size: 14.0,
+                            weight: "Regular",
+                            line_height: 1.3,
+                            color: description_color,
+                            align: TextAlignH::Center,
+                            honor_text_style: false,
+                            honor_font_weight: false,
+                        },
+                        &theme,
+                    );
+                    let (_, icon_height) =
+                        add_text(doc, column, id, "compound.text", feature_x + 8.0, feature_y + 8.0, text_width, icon_data, icon_color)?;
+                    let (_, heading_height) = add_text(
+                        doc,
+                        column,
+                        id,
+                        "compound.text",
+                        feature_x + 8.0,
+                        feature_y + 8.0 + icon_height + 8.0,
+                        text_width,
+                        heading_data,
+                        heading_color,
+                    )?;
+                    let (_, description_height) = add_text(
+                        doc,
+                        column,
+                        id,
+                        "compound.text",
+                        feature_x + 8.0,
+                        feature_y + 8.0 + icon_height + 8.0 + heading_height + 4.0,
+                        text_width,
+                        description_data,
+                        description_color,
+                    )?;
+                    let feature_height = 16.0 + icon_height + 8.0 + heading_height + 4.0 + description_height;
+                    set_height(doc, column, feature_height)?;
+                    row_height = row_height.max(feature_height);
+                }
+                (root, pad.vertical() + total_height + row_height)
+            }
+        }
+        "footer" => {
+            let pad = padding(block, Padding::DEFAULT);
+            let background = css_color(prop(block, "backgroundColor"))
+                .or_else(|| style_color(block, "backgroundColor", None))
+                .or(Some(Color::from_rgb8_const(0xF5, 0xF5, 0xF5)));
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, background)?;
+            let color =
+                css_color(prop(block, "textColor")).or_else(|| style_color(block, "color", None)).unwrap_or(Color::from_rgb8_const(0x6B, 0x72, 0x80));
+            let mut lines = Vec::new();
+            if let Some(text) = string_prop(block, "additionalText").filter(|v| !v.is_empty()) {
+                lines.push(text);
+            }
+            if bool_prop(block, "showUnsubscribe", true) {
+                lines.push("Unsubscribe".into());
+            }
+            if lines.is_empty() {
+                lines.push(String::new());
+            }
+            let mut line_y = y + pad.top;
+            for line in lines {
+                let data = text_data(
+                    block,
+                    line,
+                    TextSpec {
+                        size: 12.0,
+                        weight: "Regular",
+                        line_height: 1.3,
+                        color,
+                        align: TextAlignH::Center,
+                        honor_text_style: false,
+                        honor_font_weight: false,
+                    },
+                    &theme,
+                );
+                let (_, line_height) = add_text(doc, root, id, "compound.text", x + pad.left, line_y, width - pad.horizontal(), data, color)?;
+                line_y += line_height + 8.0;
+            }
+            (root, line_y - y + pad.bottom)
+        }
+        _ => {
+            let pad = padding(block, Padding::DEFAULT);
+            let background = style_color(block, "backgroundColor", Some(Color::from_rgb8_const(0xF3, 0xF4, 0xF6)));
+            let root = wrapper(doc, parent, id, kind, x, y, width, block, background)?;
+            let color = Color::from_rgb8_const(0x6B, 0x72, 0x80);
+            let message = format!("Unsupported {kind} block — open compiled preview (protected)");
+            let data = text_data(
+                block,
+                message,
+                TextSpec {
+                    size: 14.0,
+                    weight: "Regular",
+                    line_height: 1.4,
+                    color,
+                    align: TextAlignH::Center,
+                    honor_text_style: false,
+                    honor_font_weight: false,
+                },
+                &theme,
+            );
+            let (_, text_height) = add_text(doc, root, id, "compound.text", x + pad.left, y + pad.top, width - pad.horizontal(), data, color)?;
+            (root, pad.vertical() + text_height)
+        }
+    };
+    set_height(doc, root, height)?;
+    mapping.insert(id.to_owned(), BlockMap { root, content, role });
+    Ok((root, height))
+}
+
+fn build_native(
+    blocks: &serde_json::Map<String, Value>,
+    images: &BTreeMap<String, NativeImage>,
+    editable: &BTreeSet<String>,
+) -> Result<(Document, BTreeMap<String, BlockMap>)> {
+    let mut doc = Document::new("XeroFlow email");
+    let page = doc.first_page().ok_or_else(|| bad("edm_import", "page unavailable"))?;
+    let root = blocks.get("root").ok_or_else(|| bad("edm_import", "root missing"))?;
+    let theme = root_theme(root);
+    let mut mapping = BTreeMap::new();
+    import_block(&mut doc, blocks, "root", page, 0.0, 0.0, canvas_width(root), images, editable, &mut mapping, &theme)?;
+    if doc.nodes().count() > 500 {
+        return Err(bad("edm_import", "native node limit exceeded"));
+    }
+    doc.images = images.values().map(|image| (image.hash.clone(), image.data.clone())).collect();
+    Ok((doc, mapping))
+}
+
+fn import(s: &mut Session, p: &Value) -> Result<Value> {
+    if s.docs.iter().any(|d| d.edm.is_some() || d.edm_designer.is_some()) {
+        return Err(bad("edm_import", "an EDM handoff already exists"));
+    }
+    let Some(design) = p.get("design") else { return Err(bad("edm_import", "design is required")) };
+    let editable = validate_design(design)?;
+    let required = required_images(design)?;
+    let supplied = p.get("images").and_then(Value::as_object).cloned().unwrap_or_default();
+    let Some(blocks) = design.get("blocks").and_then(Value::as_object) else {
+        return Err(bad("edm_import", "blocks must be an object"));
+    };
+    let mut doc = Document::new("XeroFlow email");
+    let mut images = BTreeMap::new();
+    let mut total = 0usize;
+    for request in required {
+        let Some(encoded) = supplied.get(&request.block_id).and_then(Value::as_str) else {
+            return Err(bad("edm_import", "image bytes are required"));
+        };
+        let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(encoded) else {
+            return Err(bad("edm_import", "invalid image Base64"));
+        };
+        if bytes.is_empty() || bytes.len() > MAX_IMAGE_BYTES || total + bytes.len() > MAX_TOTAL_IMAGE_BYTES {
+            return Err(bad("edm_import", "image byte limit exceeded"));
+        }
+        total += bytes.len();
+        let (hash, width, height) = figcraft_format::add_image(&mut doc, bytes).map_err(|_| bad("edm_import", "unsupported image bytes"))?;
+        if width > 8192 || height > 8192 || u64::from(width) * u64::from(height) > 16_777_216 {
+            return Err(bad("edm_import", "image dimension limit exceeded"));
+        }
+        let data = doc.images.get(&hash).cloned().ok_or_else(|| bad("edm_import", "image store missing"))?;
+        images.insert(request.block_id, NativeImage { hash, data });
+    }
+    if supplied.len() != images.len() {
+        return Err(bad("edm_import", "unexpected image envelope"));
+    }
+    let page = doc.first_page().ok_or_else(|| bad("edm_import", "page unavailable"))?;
+    let root = blocks.get("root").ok_or_else(|| bad("edm_import", "root missing"))?;
+    let theme = root_theme(root);
+    let mut mapping = BTreeMap::new();
+    import_block(&mut doc, blocks, "root", page, 0.0, 0.0, canvas_width(root), &images, &editable, &mut mapping, &theme)?;
+    if doc.nodes().count() > 500 {
+        return Err(bad("edm_import", "native node limit exceeded"));
+    }
+    let mut state = DocState::new(doc, None);
+    let native = state.doc.as_ref().clone();
+    state.edm = Some(EdmHandoff { canonical: design.clone(), native, blocks: mapping, editable });
+    s.docs.push(state);
+    s.active = s.docs.len() - 1;
+    Ok(json!({"imported": true}))
+}
+
+fn structural_node(node: &Node, role: &Role, replaced_image: bool) -> Result<Value> {
+    let mut copy = node.clone();
+    match role {
+        Role::Text | Role::ButtonText => {
+            if let NodeKind::Text(text) = &mut copy.kind {
+                text.characters.clear();
+            }
+            // node.set characters also records this content-derived override.
+            copy.overrides.remove("characters");
+        }
+        Role::Button => {
+            copy.plugin_data.remove(URL);
+        }
+        Role::Image => {
+            copy.plugin_data.remove(URL);
+            copy.plugin_data.remove(ALT);
+            copy.plugin_data.remove(LINK);
+            if replaced_image {
+                copy.fills.clear();
+            }
+        }
+        Role::Other => {}
+    }
+    serde_json::to_value(copy).map_err(|_| bad("edm_snapshot", "native projection failed"))
+}
+
+fn document_shell(doc: &Document) -> Result<Value> {
+    let mut value = serde_json::to_value(doc).map_err(|_| bad("edm_snapshot", "document projection failed"))?;
+    if let Some(shell) = value.as_object_mut() {
+        shell.remove("nodes");
+        shell.remove("current_page");
+        shell.remove("next_id");
+    }
+    Ok(value)
+}
+
+fn assert_structure(handoff: &EdmHandoff, current: &Document, replacements: &BTreeMap<String, Replacement>) -> Result<()> {
+    let mut expected_images = handoff.native.images.clone();
+    for replacement in replacements.values() {
+        expected_images.insert(replacement.hash.clone(), replacement.data.clone());
+    }
+    if handoff.native.pages != current.pages || expected_images != current.images || document_shell(&handoff.native)? != document_shell(current)? {
+        return Err(bad("edm_snapshot", "native structure changed"));
+    }
+    let before: BTreeMap<_, _> = handoff.native.nodes().map(|n| (n.id, n)).collect();
+    let after: BTreeMap<_, _> = current.nodes().map(|n| (n.id, n)).collect();
+    if before.len() != after.len() || before.keys().ne(after.keys()) {
+        return Err(bad("edm_snapshot", "native nodes changed"));
+    }
+    for (id, block) in &handoff.blocks {
+        let Some(before_node) = before.get(&block.root) else { return Err(bad("edm_snapshot", "mapped node missing")) };
+        let Some(after_node) = after.get(&block.root) else { return Err(bad("edm_snapshot", "mapped node missing")) };
+        let replaced = replacements.contains_key(id);
+        if before_node.plugin_data.get(BLOCK_ID) != Some(id)
+            || after_node.plugin_data.get(BLOCK_ID) != Some(id)
+            || structural_node(before_node, &block.role, replaced)? != structural_node(after_node, &block.role, replaced)?
+        {
+            return Err(bad("edm_snapshot", "unsupported native change"));
+        }
+        if let Some(content) = block.content {
+            let content_role = match block.role {
+                Role::Image => Role::Image,
+                Role::Text | Role::Button => Role::ButtonText,
+                Role::Other | Role::ButtonText => Role::Other,
+            };
+            let Some(before_content) = before.get(&content) else { return Err(bad("edm_snapshot", "mapped content missing")) };
+            let Some(after_content) = after.get(&content) else { return Err(bad("edm_snapshot", "mapped content missing")) };
+            if before_content.plugin_data.get(BLOCK_ID) != Some(id)
+                || after_content.plugin_data.get(BLOCK_ID) != Some(id)
+                || structural_node(before_content, &content_role, replaced)? != structural_node(after_content, &content_role, replaced)?
+            {
+                return Err(bad("edm_snapshot", "unsupported native content change"));
+            }
+        }
+    }
+    let mapped: BTreeSet<NodeId> = handoff.blocks.values().flat_map(|block| [Some(block.root), block.content].into_iter().flatten()).collect();
+    for (id, before_node) in &before {
+        if mapped.contains(id) {
+            continue;
+        }
+        let Some(after_node) = after.get(id) else { return Err(bad("edm_snapshot", "native node missing")) };
+        if structural_node(before_node, &Role::Other, false)? != structural_node(after_node, &Role::Other, false)? {
+            return Err(bad("edm_snapshot", "unsupported native change"));
+        }
+    }
+    Ok(())
+}
+
+fn set_content(handoff: &EdmHandoff, proposal: &mut Value, id: &str, field: &str, after: String) -> Result<()> {
+    let Some(block) = handoff.canonical.get("blocks").and_then(|b| b.get(id)) else {
+        return Err(bad("edm_snapshot", "canonical block missing"));
+    };
+    let before = string_prop(block, field);
+    if before.as_deref() == Some(after.as_str()) {
+        return Ok(());
+    }
+    if !handoff.allows(id, field) || before.is_none() {
+        return Err(bad("edm_snapshot", "content is not editable"));
+    }
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    if after.len() > MAX_CONTENT
+        || (field == "text" && after.bytes().any(|b| matches!(b, b'<' | b'>' | b'&')))
+        || (matches!(field, "url" | "linkHref") && !valid_url(&after, kind == "Image" && field == "url"))
+    {
+        return Err(bad("edm_snapshot", "invalid content"));
+    }
+    let Some(props) = proposal
+        .get_mut("blocks")
+        .and_then(|b| b.get_mut(id))
+        .and_then(|b| b.get_mut("data"))
+        .and_then(|d| d.get_mut("props"))
+        .and_then(Value::as_object_mut)
+    else {
+        return Err(bad("edm_snapshot", "canonical props missing"));
+    };
+    props.insert(field.into(), Value::String(after));
+    Ok(())
+}
+
+fn native_text(node: &Node) -> Result<String> {
+    let NodeKind::Text(text) = &node.kind else { return Err(bad("edm_snapshot", "text kind changed")) };
+    Ok(text.characters.clone())
+}
+
+fn image_hash(node: &Node) -> Option<String> {
+    node.fills.iter().find_map(|paint| match &paint.kind {
+        PaintKind::Image(image) => Some(image.image.clone()),
+        _ => None,
+    })
+}
+
+fn snapshot(s: &mut Session, p: &Value) -> Result<Value> {
+    let supplied = p.get("images").and_then(Value::as_object).cloned().unwrap_or_default();
+    let required = required_snapshot_images(s)?;
+    if supplied.len() != required.len() || required.iter().any(|request| !supplied.contains_key(&request.block_id)) {
+        return Err(bad("edm_snapshot", "changed image bytes are required"));
+    }
+    let ds = s.ds_mut()?;
+    if ds.interaction.is_some() || ds.text_edit.is_some() {
+        return Err(bad("edm_snapshot", "editor busy"));
+    }
+    let Some(handoff) = ds.edm.clone() else { return Err(bad("edm_snapshot", "handoff missing")) };
+    let mut replacements = BTreeMap::new();
+    let mut total = 0usize;
+    for request in required {
+        let Some(encoded) = supplied.get(&request.block_id).and_then(Value::as_str) else {
+            return Err(bad("edm_snapshot", "changed image bytes are required"));
+        };
+        let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(encoded) else {
+            return Err(bad("edm_snapshot", "invalid image Base64"));
+        };
+        if bytes.is_empty() || bytes.len() > MAX_IMAGE_BYTES || total + bytes.len() > MAX_TOTAL_IMAGE_BYTES {
+            return Err(bad("edm_snapshot", "image byte limit exceeded"));
+        }
+        total += bytes.len();
+        let block = handoff.blocks.get(&request.block_id).ok_or_else(|| bad("edm_snapshot", "image mapping missing"))?;
+        let content = content_id(block)?;
+        let baseline_node = handoff.native.node(content).ok_or_else(|| bad("edm_snapshot", "baseline image missing"))?;
+        let current_node = ds.doc.node(content).ok_or_else(|| bad("edm_snapshot", "image node missing"))?;
+        if current_node.fills != baseline_node.fills {
+            return Err(bad("edm_snapshot", "image fills changed before URL replacement"));
+        }
+        let (hash, width, height) =
+            figcraft_format::add_image(ds.doc_mut(), bytes.clone()).map_err(|_| bad("edm_snapshot", "unsupported image bytes"))?;
+        if width > 8192 || height > 8192 || u64::from(width) * u64::from(height) > 16_777_216 {
+            return Err(bad("edm_snapshot", "image dimension limit exceeded"));
+        }
+        let node = ds.doc_mut().get_mut(content).map_err(|e| bad("edm_snapshot", e.to_string()))?;
+        node.fills = vec![Paint::image(hash.clone(), figcraft_color::ImageScaleMode::Fit)];
+        replacements.insert(request.block_id, Replacement { hash, data: ImageData { bytes: std::sync::Arc::new(bytes), width, height } });
+    }
+    assert_structure(&handoff, &ds.doc, &replacements)?;
+    let mut proposal = handoff.canonical.clone();
+    // `build_native` (like `import`) keys image bytes by block ID. Each entry is the paint hash
+    // proven below (the verified replacement, else the unchanged native paint), never a guess.
+    let mut block_images = BTreeMap::new();
+    for (id, block) in &handoff.blocks {
+        let node = ds.doc.node(block.root).ok_or_else(|| bad("edm_snapshot", "mapped node missing"))?;
+        match block.role {
+            Role::Text => {
+                let text = ds.doc.node(content_id(block)?).ok_or_else(|| bad("edm_snapshot", "text missing"))?;
+                set_content(&handoff, &mut proposal, id, "text", native_text(text)?)?;
+            }
+            Role::Button => {
+                let url = node.plugin_data.get(URL).cloned().unwrap_or_default();
+                set_content(&handoff, &mut proposal, id, "url", url)?;
+                let text_node = ds.doc.node(content_id(block)?).ok_or_else(|| bad("edm_snapshot", "button text missing"))?;
+                set_content(&handoff, &mut proposal, id, "text", native_text(text_node)?)?;
+            }
+            Role::Image => {
+                let content = content_id(block)?;
+                let paint = ds.doc.node(content).ok_or_else(|| bad("edm_snapshot", "image paint missing"))?;
+                let url = node.plugin_data.get(URL).cloned().unwrap_or_default();
+                let expected_hash = replacements.get(id).map(|r| r.hash.clone()).or_else(|| handoff.native.node(content).and_then(image_hash));
+                let Some(hash) = expected_hash.filter(|hash| image_hash(paint).as_ref() == Some(hash)) else {
+                    return Err(bad("edm_snapshot", "image paint has no matching durable URL"));
+                };
+                let data = ds.doc.images.get(&hash).cloned().ok_or_else(|| bad("edm_snapshot", "image store missing"))?;
+                block_images.insert(id.clone(), NativeImage { hash, data });
+                set_content(&handoff, &mut proposal, id, "url", url)?;
+                if let Some(alt) = node.plugin_data.get(ALT) {
+                    set_content(&handoff, &mut proposal, id, "alt", alt.clone())?;
+                } else if string_prop(handoff.canonical["blocks"].get(id).ok_or_else(|| bad("edm_snapshot", "canonical block missing"))?, "alt")
+                    .is_some()
+                {
+                    return Err(bad("edm_snapshot", "image alt removed"));
+                }
+                if let Some(link) = node.plugin_data.get(LINK) {
+                    set_content(&handoff, &mut proposal, id, "linkHref", link.clone())?;
+                } else if string_prop(handoff.canonical["blocks"].get(id).ok_or_else(|| bad("edm_snapshot", "canonical block missing"))?, "linkHref")
+                    .is_some()
+                {
+                    return Err(bad("edm_snapshot", "image link removed"));
+                }
+            }
+            Role::Other | Role::ButtonText => {}
+        }
+    }
+    let blocks = proposal.get("blocks").and_then(Value::as_object).ok_or_else(|| bad("edm_snapshot", "canonical blocks missing"))?;
+    let (native, blocks) = build_native(blocks, &block_images, &handoff.editable).map_err(|error| bad("edm_snapshot", error.to_string()))?;
+    ds.doc = std::sync::Arc::new(native);
+    let mut current = handoff;
+    current.native = ds.doc.as_ref().clone();
+    current.blocks = blocks;
+    ds.edm = Some(current);
+    Ok(proposal)
+}
+
+const DESIGNER_OPERATION_TYPES: [&str; 6] = ["set-style", "set-props", "add-section", "move-section", "duplicate-section", "remove-section"];
+const DESIGNER_SECTION_TYPES: [&str; 8] = ["Heading", "Text", "Button", "Image", "Spacer", "Divider", "Container", "ColumnsContainer"];
+
+#[derive(Clone, Debug)]
+pub struct EdmDesigner {
+    baseline: Value,
+    current: Value,
+    native: Document,
+    blocks: BTreeMap<String, BlockMap>,
+    images: BTreeMap<String, NativeImage>,
+    baseline_block_images: BTreeMap<String, NativeImage>,
+    baseline_url_images: BTreeMap<String, NativeImage>,
+    operation_id: String,
+    operations: Vec<Value>,
+    redo_operations: Vec<Value>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct DesignerBlockCapability {
+    pub editable: bool,
+    pub can_insert: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DesignerLocation {
+    pub parent_id: String,
+    pub column_index: Option<usize>,
+    pub index: usize,
+}
+
+impl EdmDesigner {
+    pub fn block(&self, block_id: &str) -> Option<&Value> {
+        self.current.get("blocks")?.get(block_id)
+    }
+
+    pub fn capability(&self, block_id: &str) -> DesignerBlockCapability {
+        designer_capability(&self.current, block_id)
+            .map(|(editable, can_insert, _)| DesignerBlockCapability { editable, can_insert })
+            .unwrap_or_default()
+    }
+
+    pub fn allows(&self, block_id: &str, field: &str) -> bool {
+        let expected = format!("{block_id}.data.props.{field}");
+        self.current
+            .get("policy")
+            .and_then(|p| p.get("editableFields"))
+            .and_then(Value::as_array)
+            .is_some_and(|fields| fields.iter().any(|path| path.as_str() == Some(expected.as_str())))
+    }
+
+    pub fn location(&self, block_id: &str) -> Option<DesignerLocation> {
+        locate_designer_block(&self.current, block_id).ok()
+    }
+
+    pub fn insertion_target(&self, block_id: Option<&str>) -> Option<DesignerLocation> {
+        let selected = block_id.unwrap_or("root");
+        let block = self.block(selected)?;
+        let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+        if matches!(kind, "EmailLayout" | "Container" | "ColumnsContainer") && self.capability(selected).can_insert {
+            let column_index = (kind == "ColumnsContainer").then_some(0);
+            let index = designer_child_ids_at(block, column_index).ok()?.len();
+            return Some(DesignerLocation { parent_id: selected.into(), column_index, index });
+        }
+        let location = self.location(selected)?;
+        self.capability(&location.parent_id).can_insert.then_some(DesignerLocation { index: location.index + 1, ..location })
+    }
+
+    /// Whether `current` is still exactly the canvas the canonical log built: no unlogged native edit
+    /// is pending, so keyboard history can replay the log instead of generic undo.
+    pub fn native_matches(&self, current: &Document) -> bool {
+        designer_native_matches(self, current)
+    }
+
+    pub fn operation_count(&self) -> usize {
+        self.operations.len()
+    }
+
+    pub fn redo_count(&self) -> usize {
+        self.redo_operations.len()
+    }
+}
+
+fn designer_bad(message: impl Into<String>) -> crate::EngineError {
+    bad("edm_designer", message)
+}
+
+fn valid_id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
+        && !matches!(value, "__proto__" | "prototype" | "constructor")
+}
+
+fn valid_operation_id(value: &str) -> bool {
+    let parts = value.split('-').collect::<Vec<_>>();
+    matches!(parts.as_slice(), [a, b, c, d, e] if a.len() == 8 && b.len() == 4 && c.len() == 4 && d.len() == 4 && e.len() == 12)
+        && value.bytes().all(|b| b.is_ascii_hexdigit() || b == b'-')
+}
+
+fn only_keys(value: &Value, allowed: &[&str]) -> bool {
+    value.as_object().is_some_and(|object| object.keys().all(|key| allowed.contains(&key.as_str())))
+}
+
+fn designer_block_id(operation_id: &str, operation_index: usize, child_index: usize) -> String {
+    format!("designer-{operation_id}-{operation_index}-{child_index}")
+}
+
+fn designer_descendants(design: &Value, block_id: &str) -> Result<Vec<String>> {
+    let blocks = design.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    fn visit(blocks: &serde_json::Map<String, Value>, id: &str, out: &mut Vec<String>) -> Result<()> {
+        let block = blocks.get(id).ok_or_else(|| designer_bad("descendant missing"))?;
+        out.push(id.into());
+        for child in child_ids(block)? {
+            visit(blocks, &child, out)?;
+        }
+        Ok(())
+    }
+    let mut result = Vec::new();
+    visit(blocks, block_id, &mut result)?;
+    Ok(result)
+}
+
+fn designer_linked_blocks(design: &Value) -> Result<BTreeSet<String>> {
+    let mut linked = BTreeSet::new();
+    for instance in design.get("moduleInstances").and_then(Value::as_array).into_iter().flatten() {
+        for root in instance.get("rootBlockIds").and_then(Value::as_array).into_iter().flatten().filter_map(Value::as_str) {
+            linked.extend(designer_descendants(design, root)?);
+        }
+    }
+    Ok(linked)
+}
+
+fn content_fields(kind: &str) -> &'static [&'static str] {
+    match kind {
+        "Heading" | "Text" => &["text"],
+        "Button" => &["text", "url"],
+        "Image" => &["url", "alt", "linkHref"],
+        _ => &[],
+    }
+}
+
+/// Every byte offset where `needle` starts, overlapping ones included, as a regex tries each
+/// offset (`{{{address}}` matches at the second brace). `needle` starts with an ASCII byte, so each
+/// next offset is a char boundary; `get` keeps a wrong one from panicking anyway.
+fn match_offsets<'a>(haystack: &'a str, needle: &'a str) -> impl Iterator<Item = usize> + 'a {
+    let mut from = 0;
+    std::iter::from_fn(move || {
+        let found = from + haystack.get(from..)?.find(needle)?;
+        from = found + 1;
+        Some(found)
+    })
+}
+
+/// The shared lock: `JSON.stringify(props)` tested against
+/// `/unsubscribe|email[_ -]?preferences|postal[_ -]?address|mailing[_ -]?address|\{\{\s*(?:address|business_address|company_address)\s*\}\}/i`.
+/// Without the `u` flag only ASCII letters fold case, so ASCII lowercasing is the exact `i`; `\s` is
+/// [`js_whitespace`].
+fn legal_props_locked(props: &serde_json::Map<String, Value>) -> bool {
+    let legal = Value::Object(props.clone()).to_string().to_ascii_lowercase();
+    if legal.contains("unsubscribe") {
+        return true;
+    }
+    let separated = [("email", "preferences"), ("postal", "address"), ("mailing", "address")].into_iter().any(|(head, tail)| {
+        match_offsets(&legal, head)
+            .any(|index| legal.get(index + head.len()..).is_some_and(|rest| rest.strip_prefix(['_', ' ', '-']).unwrap_or(rest).starts_with(tail)))
+    });
+    separated
+        || match_offsets(&legal, "{{").any(|index| {
+            legal.get(index + 2..).is_some_and(|rest| {
+                let candidate = rest.trim_start_matches(js_whitespace);
+                ["address", "business_address", "company_address"]
+                    .into_iter()
+                    .any(|marker| candidate.strip_prefix(marker).is_some_and(|rest| rest.trim_start_matches(js_whitespace).starts_with("}}")))
+            })
+        })
+}
+
+fn own_locked(design: &Value, block_id: &str) -> bool {
+    let Some(block) = design.get("blocks").and_then(|b| b.get(block_id)) else { return true };
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    if kind != "EmailLayout" && !DESIGNER_SECTION_TYPES.contains(&kind) {
+        return true;
+    }
+    if design
+        .get("policy")
+        .and_then(|p| p.get("designerLocks"))
+        .and_then(|l| l.get("blockIds"))
+        .and_then(Value::as_array)
+        .is_some_and(|ids| ids.iter().any(|id| id.as_str() == Some(block_id)))
+    {
+        return true;
+    }
+    let Some(data) = block.get("data").and_then(Value::as_object) else { return true };
+    if data.keys().any(|key| !["props", "style", "childrenIds", "mobile", "hideOnMobile", "hideOnDesktop"].contains(&key.as_str())) {
+        return true;
+    }
+    let empty = serde_json::Map::new();
+    let props = data.get("props").and_then(Value::as_object).unwrap_or(&empty);
+    if props.keys().any(|key| {
+        let key = key.to_ascii_lowercase();
+        key.contains("lock") || key.contains("legal") || key.contains("required") || key.contains("brand")
+    }) {
+        return true;
+    }
+    if legal_props_locked(props) {
+        return true;
+    }
+    content_fields(kind).iter().any(|field| {
+        props.contains_key(*field)
+            && !design.get("policy").and_then(|p| p.get("editableFields")).and_then(Value::as_array).is_some_and(|fields| {
+                let path = format!("{block_id}.data.props.{field}");
+                fields.iter().any(|value| value.as_str() == Some(path.as_str()))
+            })
+    })
+}
+
+fn designer_locked(design: &Value, block_id: &str) -> bool {
+    designer_descendants(design, block_id).is_ok_and(|ids| ids.iter().any(|id| own_locked(design, id)))
+}
+
+fn designer_inherited_lock(design: &Value, block_id: &str) -> bool {
+    design.get("blocks").and_then(Value::as_object).is_some_and(|blocks| {
+        blocks.keys().any(|parent| {
+            parent != block_id
+                && own_locked(design, parent)
+                && designer_descendants(design, parent).is_ok_and(|ids| ids.iter().any(|id| id == block_id))
+        })
+    })
+}
+
+fn design_structure_locked(design: &Value, block_id: &str, include_descendants: bool) -> bool {
+    let mut owners = design
+        .get("policy")
+        .and_then(|p| p.get("designerLocks"))
+        .and_then(|locks| locks.get("blockIds"))
+        .and_then(Value::as_array)
+        .map(|ids| ids.iter().filter_map(Value::as_str).collect::<Vec<_>>())
+        .unwrap_or_default();
+    owners.extend(
+        design
+            .get("policy")
+            .and_then(|p| p.get("designerLocks"))
+            .and_then(|locks| locks.get("styleFields"))
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(Value::as_str)
+            .filter_map(|path| path.split('.').next()),
+    );
+    owners.into_iter().any(|owner| {
+        designer_descendants(design, owner).is_ok_and(|ids| ids.iter().any(|id| id == block_id))
+            || (include_descendants && designer_descendants(design, block_id).is_ok_and(|ids| ids.iter().any(|id| id == owner)))
+    })
+}
+
+fn designer_capability(design: &Value, block_id: &str) -> Option<(bool, bool, Vec<String>)> {
+    let block = design.get("blocks")?.get(block_id)?;
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    let linked = designer_linked_blocks(design).ok()?;
+    let descendants = designer_descendants(design, block_id).ok()?;
+    let linked_overlap = linked.iter().any(|id| descendants.contains(id)) || descendants.iter().any(|id| linked.contains(id));
+    let inherited = designer_inherited_lock(design, block_id);
+    let editable = !inherited && !designer_locked(design, block_id) && !linked_overlap;
+    let can_insert = matches!(kind, "EmailLayout" | "Container" | "ColumnsContainer")
+        && !design_structure_locked(design, block_id, false)
+        && !own_locked(design, block_id)
+        && !inherited
+        // Shared: no module root's subtree contains this block. A container holding a linked
+        // module still accepts new siblings of it (shared `add-section` checks only the parent).
+        && !linked.contains(block_id);
+    let locked_style_fields = design
+        .get("policy")
+        .and_then(|p| p.get("designerLocks"))
+        .and_then(|locks| locks.get("styleFields"))
+        .and_then(Value::as_array)
+        .map(|fields| fields.iter().filter_map(Value::as_str).filter(|path| path.starts_with(&format!("{block_id}."))).map(str::to_owned).collect())
+        .unwrap_or_default();
+    Some((editable, can_insert, locked_style_fields))
+}
+
+fn assert_designer_mutable(design: &Value, block_id: &str) -> Result<()> {
+    if !designer_capability(design, block_id).is_some_and(|(editable, _, _)| editable) {
+        return Err(designer_bad("block is locked"));
+    }
+    Ok(())
+}
+
+fn validate_designer_editable_fields(design: &Value) -> Result<()> {
+    for path in design.get("policy").and_then(|p| p.get("editableFields")).and_then(Value::as_array).into_iter().flatten() {
+        let Some(path) = path.as_str() else { return Err(designer_bad("editable field must be a string")) };
+        let parts = path.split('.').collect::<Vec<_>>();
+        if parts.len() != 4 || parts[1] != "data" || parts[2] != "props" || !valid_id(parts[0]) {
+            return Err(designer_bad("unsupported editable field"));
+        }
+        let Some(block) = design.get("blocks").and_then(|b| b.get(parts[0])) else { return Err(designer_bad("editable block missing")) };
+        let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+        if !content_fields(kind).contains(&parts[3]) {
+            return Err(designer_bad("unsupported editable field"));
+        }
+        let Some(value) = string_prop(block, parts[3]) else { return Err(designer_bad("editable value must be a string")) };
+        if value.len() > MAX_CONTENT
+            || (matches!(parts[3], "url" | "linkHref")
+                && !(value.is_empty() && parts[3] == "url")
+                && !valid_url(&value, kind == "Image" && parts[3] == "url"))
+        {
+            return Err(designer_bad("invalid editable value"));
+        }
+    }
+    Ok(())
+}
+
+fn validate_designer_brand(design: &Value) -> Result<()> {
+    let Some(brand) = design.get("source").and_then(|source| source.get("brand")) else { return Ok(()) };
+    if !only_keys(brand, &["kitId", "versionId", "version", "name", "defaults"])
+        || !brand.get("kitId").and_then(Value::as_str).is_some_and(valid_operation_id)
+        || !brand.get("versionId").and_then(Value::as_str).is_some_and(valid_operation_id)
+        || !brand.get("version").and_then(Value::as_u64).is_some_and(|version| version > 0)
+        || !brand.get("name").and_then(Value::as_str).is_some_and(|name| !name.is_empty() && name.len() <= 255)
+    {
+        return Err(designer_bad("invalid source.brand"));
+    }
+    let defaults = brand.get("defaults").ok_or_else(|| designer_bad("brand defaults missing"))?;
+    if !only_keys(defaults, &["primaryColor", "fontFamily", "contentWidth", "fontFallback", "requestedFont"])
+        || !defaults.get("primaryColor").is_some_and(valid_hex_colour)
+        || !defaults.get("fontFamily").is_some_and(valid_font)
+        || !defaults.get("contentWidth").is_some_and(|width| bounded_number(width, 320.0, 960.0, true))
+        || !defaults.get("fontFallback").is_some_and(Value::is_boolean)
+        || !defaults.get("requestedFont").is_some_and(|font| font.is_null() || font.as_str().is_some_and(|font| font.len() <= 120))
+    {
+        return Err(designer_bad("invalid brand defaults"));
+    }
+    Ok(())
+}
+
+fn validate_designer_design(design: &Value) -> Result<()> {
+    if design.to_string().len() > MAX_DESIGN_BYTES
+        || design.get("schemaVersion").and_then(Value::as_u64) != Some(1)
+        || !matches!(design.get("kind").and_then(Value::as_str), Some("template" | "campaign-draft"))
+        || design.get("policy").and_then(|p| p.get("version")).and_then(Value::as_u64) != Some(1)
+        || !design.get("policy").and_then(|p| p.get("editableFields")).is_some_and(Value::is_array)
+        || !design.get("source").and_then(|s| s.get("nativeArtifact")).is_some_and(Value::is_null)
+        || !design.get("assets").is_some_and(Value::is_array)
+        || !design.get("dependencies").is_some_and(Value::is_array)
+        || !design.get("moduleInstances").is_some_and(Value::is_array)
+        || !design.get("lineage").is_some_and(Value::is_array)
+        || design.get("rootChildrenIds").and_then(Value::as_array).map(Vec::len) != Some(1)
+        || design.get("rootChildrenIds").and_then(Value::as_array).and_then(|roots| roots.first()).and_then(Value::as_str) != Some("root")
+        || design.get("blocks").and_then(|b| b.get("root")).and_then(|b| b.get("type")).and_then(Value::as_str) != Some("EmailLayout")
+    {
+        return Err(designer_bad("unsupported canonical designer handoff"));
+    }
+    let Some(blocks) = design.get("blocks").and_then(Value::as_object) else { return Err(designer_bad("blocks must be an object")) };
+    if blocks.is_empty() || blocks.len() > MAX_BLOCKS || blocks.keys().any(|id| !valid_id(id)) {
+        return Err(designer_bad("invalid block set"));
+    }
+    let mut visited = BTreeSet::new();
+    let mut pending = vec![("root".to_owned(), 1usize)];
+    while let Some((id, depth)) = pending.pop() {
+        if depth > 32 || !visited.insert(id.clone()) {
+            return Err(designer_bad("invalid block graph"));
+        }
+        let Some(block) = blocks.get(&id) else { return Err(designer_bad("missing block")) };
+        if block.get("type").and_then(Value::as_str) == Some("ColumnsContainer") {
+            let columns = prop(block, "columns").and_then(Value::as_array).ok_or_else(|| designer_bad("columns must be an array"))?;
+            let count = number_prop(block, "columnsCount").unwrap_or(2.0);
+            if count < 1.0 || count > 3.0 || count.fract() != 0.0 || columns.len() != count as usize {
+                return Err(designer_bad("column count mismatch"));
+            }
+        }
+        for child in child_ids(block)? {
+            pending.push((child, depth + 1));
+        }
+    }
+    if visited.len() != blocks.len() {
+        return Err(designer_bad("orphan block"));
+    }
+    validate_designer_editable_fields(design)?;
+    validate_designer_brand(design)
+}
+
+fn validate_designer_capabilities(design: &Value, capabilities: &Value) -> Result<()> {
+    if !only_keys(capabilities, &["version", "operations", "blocks", "nativeSource"])
+        || capabilities.get("version").and_then(Value::as_u64) != Some(1)
+        || capabilities.get("operations").and_then(Value::as_array).map(|ops| ops.iter().filter_map(Value::as_str).collect::<Vec<_>>())
+            != Some(DESIGNER_OPERATION_TYPES.to_vec())
+        || capabilities.get("nativeSource").and_then(|s| s.get("state")).and_then(Value::as_str) != Some("canonical-only")
+        || !capabilities.get("nativeSource").and_then(|s| s.get("artifact")).is_some_and(Value::is_null)
+    {
+        return Err(designer_bad("unsupported designer capabilities"));
+    }
+    let blocks = design.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    let advertised = capabilities.get("blocks").and_then(Value::as_array).ok_or_else(|| designer_bad("capability blocks missing"))?;
+    if advertised.len() != blocks.len() {
+        return Err(designer_bad("capability block mismatch"));
+    }
+    let mut seen = BTreeSet::new();
+    for capability in advertised {
+        if !only_keys(capability, &["blockId", "editable", "canInsert", "lockedStyleFields"]) {
+            return Err(designer_bad("invalid designer capability"));
+        }
+        let Some(id) = capability.get("blockId").and_then(Value::as_str) else { return Err(designer_bad("capability block missing")) };
+        let Some((editable, can_insert, locked_fields)) = designer_capability(design, id) else {
+            return Err(designer_bad("unknown capability block"));
+        };
+        if !seen.insert(id.to_owned())
+            || capability.get("editable").and_then(Value::as_bool) != Some(editable)
+            || capability.get("canInsert").and_then(Value::as_bool) != Some(can_insert)
+            || capability
+                .get("lockedStyleFields")
+                .and_then(Value::as_array)
+                .map(|fields| fields.iter().filter_map(Value::as_str).map(str::to_owned).collect::<Vec<_>>())
+                != Some(locked_fields)
+        {
+            return Err(designer_bad("capability block mismatch"));
+        }
+    }
+    Ok(())
+}
+
+fn decode_designer_images(design: &Value, doc: &mut Document, supplied: &serde_json::Map<String, Value>) -> Result<BTreeMap<String, NativeImage>> {
+    let blocks = design.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    let mut images = BTreeMap::new();
+    let mut total = 0usize;
+    for (id, block) in blocks {
+        if block.get("type").and_then(Value::as_str) != Some("Image") {
+            continue;
+        }
+        let url = string_prop(block, "url").ok_or_else(|| designer_bad("image URL is required"))?;
+        if url.is_empty() {
+            continue;
+        }
+        if !valid_url(&url, true) {
+            return Err(designer_bad("image URL must be public HTTPS"));
+        }
+        let Some(encoded) = supplied.get(id).and_then(Value::as_str) else { return Err(designer_bad("image bytes are required")) };
+        let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(encoded) else { return Err(designer_bad("invalid image Base64")) };
+        if bytes.is_empty() || bytes.len() > MAX_IMAGE_BYTES || total + bytes.len() > MAX_TOTAL_IMAGE_BYTES {
+            return Err(designer_bad("image byte limit exceeded"));
+        }
+        total += bytes.len();
+        let (hash, width, height) = figcraft_format::add_image(doc, bytes).map_err(|_| designer_bad("unsupported image bytes"))?;
+        if width > 8192 || height > 8192 || u64::from(width) * u64::from(height) > 16_777_216 {
+            return Err(designer_bad("image dimension limit exceeded"));
+        }
+        let data = doc.images.get(&hash).cloned().ok_or_else(|| designer_bad("image store missing"))?;
+        images.insert(id.clone(), NativeImage { hash, data });
+    }
+    if supplied.len() != images.len() {
+        return Err(designer_bad("unexpected image envelope"));
+    }
+    Ok(images)
+}
+
+fn designer_import(s: &mut Session, p: &Value) -> Result<Value> {
+    if s.docs.iter().any(|doc| doc.edm.is_some() || doc.edm_designer.is_some()) {
+        return Err(designer_bad("an EDM handoff already exists"));
+    }
+    if !only_keys(p, &["design", "images", "operationId", "capabilities"]) {
+        return Err(designer_bad("invalid designer import parameters"));
+    }
+    let design = p.get("design").ok_or_else(|| designer_bad("design is required"))?;
+    validate_designer_design(design)?;
+    validate_designer_capabilities(design, p.get("capabilities").ok_or_else(|| designer_bad("capabilities are required"))?)?;
+    let operation_id = p
+        .get("operationId")
+        .and_then(Value::as_str)
+        .filter(|id| valid_operation_id(id))
+        .ok_or_else(|| designer_bad("invalid operationId"))?
+        .to_owned();
+    let supplied = p.get("images").and_then(Value::as_object).cloned().ok_or_else(|| designer_bad("images envelope is required"))?;
+    let mut doc = Document::new("XeroFlow email designer");
+    let images = decode_designer_images(design, &mut doc, &supplied)?;
+    let blocks = design.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    let (native, mapping) = build_native(blocks, &images, &BTreeSet::new()).map_err(|error| designer_bad(error.to_string()))?;
+    let mut baseline_url_images = BTreeMap::new();
+    for (id, image) in &images {
+        let url = design.get("blocks").and_then(|blocks| blocks.get(id)).and_then(|block| string_prop(block, "url")).unwrap_or_default();
+        if !url.is_empty() {
+            baseline_url_images.entry(url).or_insert_with(|| image.clone());
+        }
+    }
+    let mut state = DocState::new(native, None);
+    let native = state.doc.as_ref().clone();
+    state.edm_designer = Some(EdmDesigner {
+        baseline: design.clone(),
+        current: design.clone(),
+        native,
+        blocks: mapping,
+        baseline_block_images: images.clone(),
+        baseline_url_images,
+        images,
+        operation_id,
+        operations: Vec::new(),
+        redo_operations: Vec::new(),
+    });
+    s.docs.push(state);
+    s.active = s.docs.len() - 1;
+    Ok(json!({"imported": true}))
+}
+
+fn designer_native_matches(designer: &EdmDesigner, current: &Document) -> bool {
+    match (serde_json::to_value(&designer.native), serde_json::to_value(current)) {
+        (Ok(before), Ok(after)) => before == after && designer.native.images == current.images,
+        _ => false,
+    }
+}
+
+fn designer_snapshot(s: &mut Session) -> Result<Value> {
+    let ds = s.ds()?;
+    if ds.interaction.is_some() || ds.text_edit.is_some() {
+        return Err(designer_bad("editor busy"));
+    }
+    let designer = ds.edm_designer.as_ref().ok_or_else(|| designer_bad("designer handoff missing"))?;
+    if !designer_native_matches(designer, ds.doc.as_ref()) {
+        return Err(designer_bad("unsupported native change"));
+    }
+    if designer.operations.len() > 300 {
+        return Err(designer_bad("operation limit exceeded"));
+    }
+    Ok(json!({"operationId": designer.operation_id, "operations": designer.operations}))
+}
+
+/// Read-only, checked against the actual native selection and canonical log.
+fn designer_context(s: &mut Session) -> Result<Value> {
+    let snapshot = designer_snapshot(s)?;
+    let ds = s.ds()?;
+    let designer = ds.edm_designer.as_ref().ok_or_else(|| designer_bad("designer handoff missing"))?;
+    let mut selected = BTreeSet::new();
+    for node_id in &ds.selection {
+        let node = ds.doc.node(*node_id).ok_or_else(|| designer_bad("selection missing"))?;
+        let block_id = node.plugin_data.get(BLOCK_ID).ok_or_else(|| designer_bad("unmapped selection"))?;
+        if designer.block(block_id).is_none() {
+            return Err(designer_bad("unmapped selection"));
+        }
+        selected.insert(block_id.clone());
+    }
+    let selected: Vec<String> = selected.into_iter().collect();
+    let mut result = snapshot;
+    result["selectedBlockIds"] = json!(selected);
+    if selected.len() == 1 {
+        if let Some(target) = designer.insertion_target(Some(&selected[0])) {
+            let mut value = json!({"parentId": target.parent_id, "index": target.index});
+            if let Some(column) = target.column_index {
+                value["columnIndex"] = json!(column);
+            }
+            result["insertionTarget"] = value;
+        }
+    }
+    Ok(result)
+}
+
+fn designer_child_ids_at(block: &Value, column_index: Option<usize>) -> Result<Vec<String>> {
+    if let Some(column_index) = column_index {
+        let column = prop(block, "columns")
+            .and_then(Value::as_array)
+            .and_then(|columns| columns.get(column_index))
+            .ok_or_else(|| designer_bad("column index missing"))?;
+        return column
+            .get("childrenIds")
+            .and_then(Value::as_array)
+            .map(|ids| ids.iter().map(|id| id.as_str().map(str::to_owned).ok_or_else(|| designer_bad("child id must be a string"))).collect())
+            .unwrap_or_else(|| Ok(Vec::new()));
+    }
+    block
+        .get("data")
+        .and_then(|data| data.get("childrenIds"))
+        .and_then(Value::as_array)
+        .map(|ids| ids.iter().map(|id| id.as_str().map(str::to_owned).ok_or_else(|| designer_bad("child id must be a string"))).collect())
+        .unwrap_or_else(|| Ok(Vec::new()))
+}
+
+fn locate_designer_block(design: &Value, block_id: &str) -> Result<DesignerLocation> {
+    let blocks = design.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    for (parent_id, parent) in blocks {
+        let kind = parent.get("type").and_then(Value::as_str).unwrap_or_default();
+        let column_indices: Vec<Option<usize>> = if kind == "ColumnsContainer" {
+            (0..prop(parent, "columns").and_then(Value::as_array).map_or(0, Vec::len)).map(Some).collect()
+        } else {
+            vec![None]
+        };
+        for column_index in column_indices {
+            if let Some(index) = designer_child_ids_at(parent, column_index)?.iter().position(|id| id == block_id) {
+                return Ok(DesignerLocation { parent_id: parent_id.clone(), column_index, index });
+            }
+        }
+    }
+    Err(designer_bad("block parent missing"))
+}
+
+/// Shared `Target.columnIndex`: `z.number().int().min(0).max(2).optional()`. Only an absent key is
+/// "no column"; an explicit `null`, a string, a boolean, a fraction or a value outside 0..=2 is refused
+/// rather than read as absent. `1.0` is admitted because `JSON.parse` yields the integer 1. Whether the
+/// parent then requires (ColumnsContainer) or forbids (EmailLayout, Container) a column is
+/// [`assert_designer_target`]'s decision.
+fn designer_column_index(operation: &Value) -> Result<Option<usize>> {
+    match operation.get("columnIndex") {
+        None => Ok(None),
+        Some(value) if bounded_number(value, 0.0, 2.0, true) => Ok(value.as_f64().map(|index| index as usize)),
+        Some(_) => Err(designer_bad("invalid columnIndex")),
+    }
+}
+
+fn assert_designer_target(design: &Value, parent_id: &str, column_index: Option<usize>) -> Result<()> {
+    if !designer_capability(design, parent_id).is_some_and(|(_, can_insert, _)| can_insert) {
+        return Err(designer_bad("insert parent is locked"));
+    }
+    let block = design.get("blocks").and_then(|b| b.get(parent_id)).ok_or_else(|| designer_bad("insert parent missing"))?;
+    let kind = block.get("type").and_then(Value::as_str).unwrap_or_default();
+    if kind == "ColumnsContainer" {
+        designer_child_ids_at(block, Some(column_index.ok_or_else(|| designer_bad("columnIndex is required"))?))?;
+        return Ok(());
+    }
+    if !matches!(kind, "EmailLayout" | "Container") || column_index.is_some() {
+        return Err(designer_bad("invalid insert parent"));
+    }
+    Ok(())
+}
+
+fn designer_child_list_mut<'a>(design: &'a mut Value, parent_id: &str, column_index: Option<usize>) -> Result<&'a mut Vec<Value>> {
+    let parent = design.get_mut("blocks").and_then(|blocks| blocks.get_mut(parent_id)).ok_or_else(|| designer_bad("insert parent missing"))?;
+    let is_columns = parent.get("type").and_then(Value::as_str) == Some("ColumnsContainer");
+    let data = parent.get_mut("data").and_then(Value::as_object_mut).ok_or_else(|| designer_bad("parent data missing"))?;
+    if is_columns {
+        let column_index = column_index.ok_or_else(|| designer_bad("columnIndex is required"))?;
+        let column = data
+            .get_mut("props")
+            .and_then(|props| props.get_mut("columns"))
+            .and_then(Value::as_array_mut)
+            .and_then(|columns| columns.get_mut(column_index))
+            .ok_or_else(|| designer_bad("column index missing"))?;
+        if !column.get("childrenIds").is_some_and(Value::is_array) {
+            column["childrenIds"] = json!([]);
+        }
+        return column.get_mut("childrenIds").and_then(Value::as_array_mut).ok_or_else(|| designer_bad("column children missing"));
+    }
+    if !data.get("childrenIds").is_some_and(Value::is_array) {
+        data.insert("childrenIds".into(), json!([]));
+    }
+    data.get_mut("childrenIds").and_then(Value::as_array_mut).ok_or_else(|| designer_bad("parent children missing"))
+}
+
+fn insert_designer_child(list: &mut Vec<Value>, index: usize, block_id: String) -> Result<()> {
+    if index > list.len() {
+        return Err(designer_bad("insert index out of bounds"));
+    }
+    list.insert(index, Value::String(block_id));
+    Ok(())
+}
+
+fn valid_hex_colour(value: &Value) -> bool {
+    value.as_str().is_some_and(|colour| colour.len() == 7 && colour.starts_with('#') && colour[1..].bytes().all(|b| b.is_ascii_hexdigit()))
+}
+
+fn bounded_number(value: &Value, minimum: f64, maximum: f64, integer: bool) -> bool {
+    value.as_f64().is_some_and(|number| number.is_finite() && (minimum..=maximum).contains(&number) && (!integer || number.fract() == 0.0))
+}
+
+fn valid_font(value: &Value) -> bool {
+    value.as_str().is_some_and(|font| {
+        ["MODERN_SANS", "BOOK_SANS", "ORGANIC_SANS", "GEOMETRIC_SANS", "HEAVY_SANS", "ROUNDED_SANS", "MODERN_SERIF", "BOOK_SERIF", "MONOSPACE"]
+            .contains(&font)
+    })
+}
+
+fn validate_designer_style(style: &Value) -> Result<()> {
+    let Some(style) = style.as_object() else { return Err(designer_bad("style must be an object")) };
+    for (key, value) in style {
+        let valid = match key.as_str() {
+            "color" | "backgroundColor" | "borderColor" => valid_hex_colour(value),
+            "fontFamily" => valid_font(value),
+            "fontSize" => bounded_number(value, 8.0, 96.0, false),
+            "fontWeight" => value
+                .as_str()
+                .is_some_and(|weight| ["normal", "bold", "100", "200", "300", "400", "500", "600", "700", "800", "900"].contains(&weight)),
+            "textAlign" => value.as_str().is_some_and(|align| ["left", "center", "right"].contains(&align)),
+            "padding" => {
+                only_keys(value, &["top", "right", "bottom", "left"])
+                    && value
+                        .as_object()
+                        .is_some_and(|padding| padding.len() == 4 && padding.values().all(|side| bounded_number(side, 0.0, 600.0, false)))
+            }
+            "lineHeight" => bounded_number(value, 0.8, 3.0, false),
+            "letterSpacing" => bounded_number(value, -2.0, 20.0, false),
+            "borderWidth" => bounded_number(value, 0.0, 20.0, false),
+            "borderStyle" => value.as_str().is_some_and(|style| ["solid", "dashed", "dotted"].contains(&style)),
+            "borderRadius" => bounded_number(value, 0.0, 100.0, false),
+            _ => false,
+        };
+        if !valid {
+            return Err(designer_bad(format!("invalid style field {key}")));
+        }
+    }
+    Ok(())
+}
+
+fn validate_designer_props(kind: &str, props: &Value) -> Result<()> {
+    let Some(props) = props.as_object() else { return Err(designer_bad("props must be an object")) };
+    for (key, value) in props {
+        let valid = match (kind, key.as_str()) {
+            ("EmailLayout", "contentWidth") => bounded_number(value, 320.0, 960.0, true),
+            ("EmailLayout", "primaryColor" | "backdropColor" | "canvasColor" | "textColor" | "borderColor") => valid_hex_colour(value),
+            ("EmailLayout", "fontFamily") => valid_font(value),
+            ("EmailLayout", "borderRadius") => bounded_number(value, 0.0, 100.0, true),
+            ("Heading", "text") | ("Text", "text") => value.as_str().is_some_and(|text| text.len() <= MAX_CONTENT),
+            ("Heading", "level") => value.as_str().is_some_and(|level| ["h1", "h2", "h3"].contains(&level)),
+            ("Button", "text" | "url") => value.as_str().is_some_and(|text| text.len() <= MAX_CONTENT),
+            ("Button", "buttonBackgroundColor" | "buttonTextColor") => valid_hex_colour(value),
+            ("Button", "buttonStyle") => value.as_str().is_some_and(|style| ["rounded", "pill", "square"].contains(&style)),
+            ("Button", "size") => value.as_str().is_some_and(|size| ["x-small", "small", "medium", "large"].contains(&size)),
+            ("Button", "fullWidth") => value.is_boolean(),
+            ("Image", "url" | "alt" | "linkHref") => value.as_str().is_some_and(|text| text.len() <= MAX_CONTENT),
+            ("Image", "width") => bounded_number(value, 1.0, 800.0, true) || value.as_str() == Some("100%"),
+            ("Image", "contentAlignment") => value.as_str().is_some_and(|align| ["left", "center", "right"].contains(&align)),
+            ("Spacer", "height") => bounded_number(value, 0.0, 600.0, false),
+            ("Divider", "lineColor") => valid_hex_colour(value),
+            ("Divider", "lineThickness") => bounded_number(value, 1.0, 20.0, true),
+            ("ColumnsContainer", "columnsGap") => bounded_number(value, 0.0, 600.0, false),
+            ("ColumnsContainer", "contentAlignment") => value.as_str().is_some_and(|align| ["top", "middle", "bottom"].contains(&align)),
+            ("ColumnsContainer", "columnsCount") => bounded_number(value, 1.0, 3.0, true),
+            ("Container", _) => false,
+            _ => false,
+        };
+        if !valid {
+            return Err(designer_bad(format!("invalid {kind} prop {key}")));
+        }
+    }
+    Ok(())
+}
+
+fn merge_tokens(value: &str) -> Vec<String> {
+    let bytes = value.as_bytes();
+    let mut tokens = Vec::new();
+    let mut cursor = 0usize;
+    while cursor + 1 < bytes.len() {
+        if bytes[cursor] != b'{' || bytes[cursor + 1] != b'{' {
+            cursor += 1;
+            continue;
+        }
+        let mut end = cursor + 2;
+        while end < bytes.len() && !matches!(bytes[end], b'{' | b'}') {
+            end += 1;
+        }
+        if end > cursor + 2 && end + 1 < bytes.len() && bytes[end] == b'}' && bytes[end + 1] == b'}' {
+            tokens.push(value[cursor..end + 2].to_owned());
+            cursor = end + 2;
+        } else {
+            cursor += 1;
+        }
+    }
+    tokens.sort();
+    tokens
+}
+
+fn related_path(left: &str, right: &str) -> bool {
+    left == right || left.starts_with(&format!("{right}.")) || right.starts_with(&format!("{left}."))
+}
+
+fn semantic_suffix(suffix: &str) -> String {
+    match suffix {
+        ".data.props.fontFamily" => ".data.style.fontFamily".into(),
+        ".data.props.textColor" | ".data.props.buttonTextColor" => ".data.style.color".into(),
+        ".data.props.canvasColor" | ".data.props.backdropColor" | ".data.props.buttonBackgroundColor" => ".data.style.backgroundColor".into(),
+        _ => suffix.into(),
+    }
+}
+
+fn locked_style_path(design: &Value, block_id: &str, path: &str) -> bool {
+    let canonical = path.replace(".data.mobile.", ".data.");
+    design.get("policy").and_then(|p| p.get("designerLocks")).and_then(|locks| locks.get("styleFields")).and_then(Value::as_array).is_some_and(
+        |fields| {
+            fields.iter().filter_map(Value::as_str).any(|field| {
+                let field = field.replace(".data.mobile.", ".data.");
+                let Some(owner) = field.split('.').next() else { return false };
+                if owner == block_id {
+                    return related_path(&canonical, &field) || related_path(path, &field);
+                }
+                if !designer_descendants(design, owner).is_ok_and(|ids| ids.iter().any(|id| id == block_id)) {
+                    if !designer_descendants(design, block_id).is_ok_and(|ids| ids.iter().any(|id| id == owner)) {
+                        return false;
+                    }
+                    let before = semantic_suffix(&field[owner.len()..]);
+                    let candidate = semantic_suffix(&canonical[block_id.len()..]);
+                    return related_path(&before, &candidate);
+                }
+                let suffix = &field[owner.len()..];
+                if suffix == ".data.props.textColor" || suffix == ".data.style.color" {
+                    return canonical.ends_with(".data.style.color") || canonical.ends_with(".data.props.buttonTextColor");
+                }
+                if matches!(suffix, ".data.props.canvasColor" | ".data.props.backdropColor" | ".data.style.backgroundColor") {
+                    return canonical.ends_with(".data.style.backgroundColor") || canonical.ends_with(".data.props.buttonBackgroundColor");
+                }
+                if suffix == ".data.props.primaryColor" {
+                    return canonical.ends_with(".data.style.color")
+                        || canonical.ends_with(".data.props.buttonBackgroundColor")
+                        || canonical.ends_with(".data.props.lineColor");
+                }
+                related_path(&canonical, &format!("{block_id}{}", semantic_suffix(suffix)))
+            })
+        },
+    )
+}
+
+fn assert_style_lock(design: &Value, block_id: &str, key: &str, mobile: bool, props: bool) -> Result<()> {
+    // Shared: `${blockId}.data.${mobile ? 'mobile.' : ''}${style|props}.${key}`. The mobile prefix
+    // carries its own dot; a second separator produced `.data..style.` and no lock ever matched.
+    let path = format!("{block_id}.data.{}{}.{key}", if mobile { "mobile." } else { "" }, if props { "props" } else { "style" });
+    if locked_style_path(design, block_id, &path) {
+        return Err(designer_bad("style field is locked"));
+    }
+    Ok(())
+}
+
+fn validate_content_change(design: &Value, baseline: &Value, block_id: &str, kind: &str, key: &str, value: &Value) -> Result<()> {
+    let block = design.get("blocks").and_then(|b| b.get(block_id)).ok_or_else(|| designer_bad("block missing"))?;
+    if content_fields(kind).contains(&key) {
+        if !design.get("policy").and_then(|p| p.get("editableFields")).and_then(Value::as_array).is_some_and(|fields| {
+            let path = format!("{block_id}.data.props.{key}");
+            fields.iter().any(|field| field.as_str() == Some(path.as_str()))
+        }) {
+            return Err(designer_bad("content is not editable"));
+        }
+        let Some(after) = value.as_str() else { return Err(designer_bad("content must be a string")) };
+        if after.bytes().any(|b| b <= 0x08 || matches!(b, 0x0b | 0x0c) || (0x0e..=0x1f).contains(&b)) {
+            return Err(designer_bad("content contains control bytes"));
+        }
+        let before = string_prop(block, key).unwrap_or_default();
+        if merge_tokens(&before) != merge_tokens(after) {
+            return Err(designer_bad("merge tokens must be preserved"));
+        }
+        if key == "text" && (has_rich_text_markup(&before) || has_rich_text_markup(after)) {
+            return Err(designer_bad("rich text is locked"));
+        }
+    }
+    if matches!(key, "url" | "linkHref") {
+        let Some(after) = value.as_str() else { return Err(designer_bad("URL must be a string")) };
+        let image = kind == "Image" && key == "url";
+        if !valid_url(after, image) {
+            return Err(designer_bad("invalid URL"));
+        }
+        if image && string_prop(block, key).as_deref() != Some(after) {
+            let reused = baseline.get("blocks").and_then(Value::as_object).is_some_and(|blocks| {
+                blocks
+                    .values()
+                    .any(|block| block.get("type").and_then(Value::as_str) == Some("Image") && string_prop(block, "url").as_deref() == Some(after))
+            });
+            if !reused {
+                return Err(designer_bad("new image assets require server-owned selection"));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn new_designer_block_theme(design: &Value, section_type: &str) -> (serde_json::Map<String, Value>, serde_json::Map<String, Value>) {
+    let brand = design.get("source").and_then(|source| source.get("brand")).and_then(|brand| brand.get("defaults"));
+    let root = design.get("blocks").and_then(|blocks| blocks.get("root")).and_then(|root| root.get("data")).and_then(|data| data.get("props"));
+    let font = brand
+        .and_then(|defaults| defaults.get("fontFamily"))
+        .filter(|font| valid_font(font))
+        .or_else(|| root.and_then(|props| props.get("fontFamily")).filter(|font| valid_font(font)));
+    let primary = root
+        .and_then(|props| props.get("primaryColor"))
+        .filter(|colour| valid_hex_colour(colour))
+        .or_else(|| brand.and_then(|defaults| defaults.get("primaryColor")).filter(|colour| valid_hex_colour(colour)));
+    let mut props = serde_json::Map::new();
+    let mut style = serde_json::Map::new();
+    if let Some(font) = font.filter(|_| matches!(section_type, "Heading" | "Text" | "Button")) {
+        style.insert("fontFamily".into(), font.clone());
+    }
+    if let Some(primary) = primary {
+        match section_type {
+            "Heading" => {
+                style.insert("color".into(), primary.clone());
+            }
+            "Button" => {
+                props.insert("buttonBackgroundColor".into(), primary.clone());
+            }
+            "Divider" => {
+                props.insert("lineColor".into(), primary.clone());
+            }
+            _ => {}
+        }
+    }
+    (props, style)
+}
+
+fn apply_designer_operation(state: &mut EdmDesigner, operation: &Value) -> Result<()> {
+    let operation_index = state.operations.len();
+    let operation_id = state.operation_id.clone();
+    let op = operation.get("op").and_then(Value::as_str).ok_or_else(|| designer_bad("operation discriminant missing"))?;
+    if !DESIGNER_OPERATION_TYPES.contains(&op) {
+        return Err(designer_bad("unsupported designer operation"));
+    }
+    let block_id = operation.get("blockId").and_then(Value::as_str);
+    match op {
+        "set-style" | "set-props" => {
+            let expected: &[&str] = if op == "set-props" { &["op", "blockId", "props", "mobile"] } else { &["op", "blockId", "style", "mobile"] };
+            if !only_keys(operation, expected) {
+                return Err(designer_bad("invalid property operation"));
+            }
+            let block_id = block_id.ok_or_else(|| designer_bad("blockId is required"))?;
+            if !valid_id(block_id) {
+                return Err(designer_bad("invalid blockId"));
+            }
+            assert_designer_mutable(&state.current, block_id)?;
+            if operation.get("mobile").is_some_and(|mobile| !mobile.is_boolean()) {
+                return Err(designer_bad("mobile must be a boolean"));
+            }
+            let mobile = operation.get("mobile").and_then(Value::as_bool).unwrap_or(false);
+            let block = state.current.get("blocks").and_then(|b| b.get(block_id)).ok_or_else(|| designer_bad("block missing"))?.clone();
+            let kind = block.get("type").and_then(Value::as_str).unwrap_or_default().to_owned();
+            let is_props = op == "set-props";
+            if kind == "EmailLayout" && !is_props {
+                return Err(designer_bad("root theme uses semantic props"));
+            }
+            if mobile && is_props {
+                return Err(designer_bad("mobile props are not supported"));
+            }
+            let patch =
+                if is_props { operation.get("props") } else { operation.get("style") }.ok_or_else(|| designer_bad("property patch missing"))?;
+            if is_props {
+                validate_designer_props(&kind, patch)?
+            } else {
+                validate_designer_style(patch)?
+            };
+            let patch = patch.as_object().ok_or_else(|| designer_bad("property patch must be an object"))?;
+            for (key, value) in patch {
+                assert_style_lock(&state.current, block_id, key, mobile, is_props)?;
+                if is_props {
+                    validate_content_change(&state.current, &state.baseline, block_id, &kind, key, value)?;
+                }
+            }
+            if is_props && kind == "ColumnsContainer" && patch.contains_key("columnsCount") {
+                let count = patch.get("columnsCount").and_then(Value::as_u64).ok_or_else(|| designer_bad("invalid columnsCount"))? as usize;
+                let columns = prop(&block, "columns").and_then(Value::as_array).cloned().unwrap_or_default();
+                if columns
+                    .iter()
+                    .skip(count)
+                    .any(|column| column.get("childrenIds").and_then(Value::as_array).is_some_and(|children| !children.is_empty()))
+                {
+                    return Err(designer_bad("cannot remove occupied columns"));
+                }
+                let next = (0..count).map(|index| columns.get(index).cloned().unwrap_or_else(|| json!({"childrenIds": []}))).collect::<Vec<_>>();
+                let target = state.current.get_mut("blocks").and_then(|b| b.get_mut(block_id)).ok_or_else(|| designer_bad("block missing"))?;
+                target["data"]["props"]["columns"] = Value::Array(next);
+            }
+            let target = state.current.get_mut("blocks").and_then(|b| b.get_mut(block_id)).ok_or_else(|| designer_bad("block missing"))?;
+            let holder = if mobile {
+                if !target["data"].get("mobile").is_some_and(Value::is_object) {
+                    target["data"]["mobile"] = json!({});
+                }
+                &mut target["data"]["mobile"]
+            } else {
+                &mut target["data"]
+            };
+            let key = if is_props { "props" } else { "style" };
+            if !holder.get(key).is_some_and(Value::is_object) {
+                holder[key] = json!({});
+            }
+            let target_patch = holder.get_mut(key).and_then(Value::as_object_mut).ok_or_else(|| designer_bad("property target missing"))?;
+            for (key, value) in patch {
+                target_patch.insert(key.clone(), value.clone());
+            }
+            if is_props && kind == "Image" && patch.contains_key("url") {
+                let url = string_prop(target, "url").unwrap_or_default();
+                if !url.is_empty() {
+                    let image = state.baseline_url_images.get(&url).cloned().ok_or_else(|| designer_bad("verified image bytes missing"))?;
+                    state.images.insert(block_id.into(), image);
+                }
+            }
+        }
+        "add-section" => {
+            if !only_keys(operation, &["op", "sectionType", "parentId", "columnIndex", "index"]) {
+                return Err(designer_bad("invalid add-section"));
+            }
+            let section_type = operation
+                .get("sectionType")
+                .and_then(Value::as_str)
+                .filter(|kind| DESIGNER_SECTION_TYPES.contains(kind))
+                .ok_or_else(|| designer_bad("invalid sectionType"))?;
+            let parent_id =
+                operation.get("parentId").and_then(Value::as_str).filter(|id| valid_id(id)).ok_or_else(|| designer_bad("invalid parentId"))?;
+            let column_index = designer_column_index(operation)?;
+            let index =
+                operation.get("index").and_then(Value::as_u64).filter(|index| *index <= 300).ok_or_else(|| designer_bad("invalid index"))? as usize;
+            assert_designer_target(&state.current, parent_id, column_index)?;
+            let new_id = designer_block_id(&operation_id, operation_index, 0);
+            if state.current.get("blocks").and_then(|b| b.get(&new_id)).is_some() {
+                return Err(designer_bad("generated block ID already exists"));
+            }
+            let defaults = match section_type {
+                "Heading" => json!({"text": "Heading"}),
+                "Text" => json!({"text": "Text"}),
+                "Button" => json!({"text": "Button", "url": "#"}),
+                "Image" => json!({"url": "", "alt": "", "linkHref": ""}),
+                "Spacer" => json!({"height": 24}),
+                "ColumnsContainer" => json!({"columnsCount": 2, "columns": [{"childrenIds": []}, {"childrenIds": []}]}),
+                _ => json!({}),
+            };
+            let (theme_props, theme_style) = new_designer_block_theme(&state.current, section_type);
+            let mut props = defaults.as_object().cloned().unwrap_or_default();
+            props.extend(theme_props);
+            let mut data = json!({"props": props, "style": theme_style});
+            if section_type == "Container" {
+                data["childrenIds"] = json!([]);
+            }
+            let block = json!({"type": section_type, "data": data});
+            let list = designer_child_list_mut(&mut state.current, parent_id, column_index)?;
+            insert_designer_child(list, index, new_id.clone())?;
+            state.current["blocks"][&new_id] = block;
+            for field in content_fields(section_type) {
+                state.current["policy"]["editableFields"]
+                    .as_array_mut()
+                    .ok_or_else(|| designer_bad("editableFields missing"))?
+                    .push(json!(format!("{new_id}.data.props.{field}")));
+            }
+            let fields = content_fields(section_type)
+                .iter()
+                .map(|field| (field.to_string(), json!(format!("field-{new_id}-{field}"))))
+                .collect::<serde_json::Map<_, _>>();
+            state.current["lineage"].as_array_mut().ok_or_else(|| designer_bad("lineage missing"))?.push(
+                json!({"blockId": new_id, "nodeId": format!("node-{}", designer_block_id(&operation_id, operation_index, 0)), "fields": fields}),
+            );
+        }
+        "move-section" | "duplicate-section" | "remove-section" => {
+            let expected: &[&str] = if op == "remove-section" { &["op", "blockId"] } else { &["op", "blockId", "parentId", "columnIndex", "index"] };
+            if !only_keys(operation, expected) {
+                return Err(designer_bad("invalid structural operation"));
+            }
+            let block_id = block_id.filter(|id| valid_id(id)).ok_or_else(|| designer_bad("invalid blockId"))?;
+            if block_id == "root" {
+                return Err(designer_bad("root cannot be changed"));
+            }
+            assert_designer_mutable(&state.current, block_id)?;
+            if design_structure_locked(&state.current, block_id, true) {
+                return Err(designer_bad("locked ancestry prevents structural change"));
+            }
+            let ids = designer_descendants(&state.current, block_id)?;
+            if op == "remove-section" {
+                let location = locate_designer_block(&state.current, block_id)?;
+                let list = designer_child_list_mut(&mut state.current, &location.parent_id, location.column_index)?;
+                if list.get(location.index).and_then(Value::as_str) != Some(block_id) {
+                    return Err(designer_bad("source location changed"));
+                }
+                list.remove(location.index);
+                let blocks = state.current.get_mut("blocks").and_then(Value::as_object_mut).ok_or_else(|| designer_bad("blocks missing"))?;
+                for id in &ids {
+                    blocks.remove(id);
+                }
+                state.current["lineage"]
+                    .as_array_mut()
+                    .ok_or_else(|| designer_bad("lineage missing"))?
+                    .retain(|item| item.get("blockId").and_then(Value::as_str).is_some_and(|id| !ids.iter().any(|removed| removed == id)));
+                state.current["policy"]["editableFields"]
+                    .as_array_mut()
+                    .ok_or_else(|| designer_bad("editableFields missing"))?
+                    .retain(|path| path.as_str().and_then(|path| path.split('.').next()).is_some_and(|id| !ids.iter().any(|removed| removed == id)));
+            } else {
+                let parent_id =
+                    operation.get("parentId").and_then(Value::as_str).filter(|id| valid_id(id)).ok_or_else(|| designer_bad("invalid parentId"))?;
+                let column_index = designer_column_index(operation)?;
+                let index =
+                    operation.get("index").and_then(Value::as_u64).filter(|index| *index <= 300).ok_or_else(|| designer_bad("invalid index"))?
+                        as usize;
+                if ids.iter().any(|id| id == parent_id) {
+                    return Err(designer_bad("cannot insert into descendants"));
+                }
+                assert_designer_target(&state.current, parent_id, column_index)?;
+                if op == "move-section" {
+                    let location = locate_designer_block(&state.current, block_id)?;
+                    let list = designer_child_list_mut(&mut state.current, &location.parent_id, location.column_index)?;
+                    if list.get(location.index).and_then(Value::as_str) != Some(block_id) {
+                        return Err(designer_bad("source location changed"));
+                    }
+                    list.remove(location.index);
+                    let list = designer_child_list_mut(&mut state.current, parent_id, column_index)?;
+                    insert_designer_child(list, index, block_id.into())?;
+                } else {
+                    let id_map = ids
+                        .iter()
+                        .enumerate()
+                        .map(|(child_index, id)| (id.clone(), designer_block_id(&operation_id, operation_index, child_index)))
+                        .collect::<BTreeMap<_, _>>();
+                    if id_map.values().any(|id| state.current.get("blocks").and_then(|b| b.get(id)).is_some()) {
+                        return Err(designer_bad("generated duplicate ID already exists"));
+                    }
+                    let source_blocks = state.current.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+                    let mut copies = Vec::new();
+                    for old_id in &ids {
+                        let mut copy = source_blocks.get(old_id).cloned().ok_or_else(|| designer_bad("duplicate source missing"))?;
+                        if copy["data"].get("childrenIds").is_some_and(Value::is_array) {
+                            for child in copy["data"]["childrenIds"].as_array_mut().ok_or_else(|| designer_bad("children missing"))? {
+                                let old = child.as_str().ok_or_else(|| designer_bad("child id missing"))?;
+                                *child = json!(id_map.get(old).ok_or_else(|| designer_bad("child remap missing"))?);
+                            }
+                        }
+                        if copy.get("type").and_then(Value::as_str) == Some("ColumnsContainer") {
+                            for column in copy["data"]["props"]["columns"].as_array_mut().ok_or_else(|| designer_bad("columns missing"))? {
+                                if column.get("childrenIds").is_some_and(Value::is_array) {
+                                    for child in column["childrenIds"].as_array_mut().ok_or_else(|| designer_bad("column children missing"))? {
+                                        let old = child.as_str().ok_or_else(|| designer_bad("child id missing"))?;
+                                        *child = json!(id_map.get(old).ok_or_else(|| designer_bad("child remap missing"))?);
+                                    }
+                                }
+                            }
+                        }
+                        copies.push((old_id.clone(), copy));
+                    }
+                    for (old_id, copy) in copies {
+                        let new_id = id_map.get(&old_id).cloned().ok_or_else(|| designer_bad("duplicate remap missing"))?;
+                        state.current["blocks"][&new_id] = copy;
+                        if let Some(image) = state.images.get(&old_id).cloned() {
+                            state.images.insert(new_id, image);
+                        }
+                    }
+                    let lineage = state.current.get("lineage").and_then(Value::as_array).cloned().unwrap_or_default();
+                    let grants =
+                        state.current.get("policy").and_then(|p| p.get("editableFields")).and_then(Value::as_array).cloned().unwrap_or_default();
+                    let lock_fields = state
+                        .current
+                        .get("policy")
+                        .and_then(|p| p.get("designerLocks"))
+                        .and_then(|locks| locks.get("styleFields"))
+                        .and_then(Value::as_array)
+                        .cloned();
+                    for old_id in &ids {
+                        let new_id = id_map.get(old_id).cloned().ok_or_else(|| designer_bad("duplicate remap missing"))?;
+                        let old_grants = grants
+                            .iter()
+                            .filter(|path| path.as_str().is_some_and(|path| path.starts_with(&format!("{old_id}."))))
+                            .cloned()
+                            .collect::<Vec<_>>();
+                        for path in old_grants.iter() {
+                            let suffix = path.as_str().unwrap_or_default().strip_prefix(old_id).unwrap_or_default();
+                            state.current["policy"]["editableFields"]
+                                .as_array_mut()
+                                .ok_or_else(|| designer_bad("editableFields missing"))?
+                                .push(json!(format!("{new_id}{suffix}")));
+                        }
+                        let mut field_names = old_grants
+                            .iter()
+                            .filter_map(|path| path.as_str())
+                            .filter_map(|path| path.split('.').next_back())
+                            .map(str::to_owned)
+                            .collect::<BTreeSet<_>>();
+                        if let Some(item) = lineage.iter().find(|item| item.get("blockId").and_then(Value::as_str) == Some(old_id.as_str())) {
+                            if let Some(fields) = item.get("fields").and_then(Value::as_object) {
+                                field_names.extend(fields.keys().cloned());
+                            }
+                        }
+                        let fields = field_names
+                            .into_iter()
+                            .map(|field| (field.clone(), json!(format!("field-{new_id}-{field}"))))
+                            .collect::<serde_json::Map<_, _>>();
+                        state.current["lineage"]
+                            .as_array_mut()
+                            .ok_or_else(|| designer_bad("lineage missing"))?
+                            .push(json!({"blockId": new_id, "nodeId": format!("node-{new_id}"), "fields": fields}));
+                        if let Some(lock_fields) = &lock_fields {
+                            for path in lock_fields.iter().filter(|path| path.as_str().is_some_and(|path| path.starts_with(&format!("{old_id}.")))) {
+                                let suffix = path.as_str().unwrap_or_default().strip_prefix(old_id).unwrap_or_default();
+                                state.current["policy"]["designerLocks"]["styleFields"]
+                                    .as_array_mut()
+                                    .ok_or_else(|| designer_bad("styleFields missing"))?
+                                    .push(json!(format!("{new_id}{suffix}")));
+                            }
+                        }
+                    }
+                    let new_root = id_map.get(block_id).cloned().ok_or_else(|| designer_bad("duplicate root missing"))?;
+                    let list = designer_child_list_mut(&mut state.current, parent_id, column_index)?;
+                    insert_designer_child(list, index, new_root)?;
+                }
+            }
+        }
+        _ => return Err(designer_bad("unsupported designer operation")),
+    }
+    validate_designer_design(&state.current)
+}
+
+fn rebuild_designer_native(designer: &mut EdmDesigner) -> Result<Document> {
+    let blocks = designer.current.get("blocks").and_then(Value::as_object).ok_or_else(|| designer_bad("blocks missing"))?;
+    let (native, mapping) = build_native(blocks, &designer.images, &BTreeSet::new()).map_err(|error| designer_bad(error.to_string()))?;
+    designer.native = native.clone();
+    designer.blocks = mapping;
+    Ok(native)
+}
+
+fn replay_designer(designer: &mut EdmDesigner) -> Result<Document> {
+    let operations = std::mem::take(&mut designer.operations);
+    designer.current = designer.baseline.clone();
+    designer.images = designer.baseline_block_images.clone();
+    for operation in &operations {
+        apply_designer_operation(designer, operation)?;
+        designer.operations.push(operation.clone());
+    }
+    rebuild_designer_native(designer)
+}
+
+fn designer_apply(s: &mut Session, p: &Value) -> Result<Value> {
+    if !only_keys(p, &["operations"]) {
+        return Err(designer_bad("invalid apply parameters"));
+    }
+    let operations = p.get("operations").and_then(Value::as_array).ok_or_else(|| designer_bad("operations must be an array"))?;
+    let ds = s.ds_mut()?;
+    if ds.interaction.is_some() || ds.text_edit.is_some() {
+        return Err(designer_bad("editor busy"));
+    }
+    let mut designer = ds.edm_designer.clone().ok_or_else(|| designer_bad("designer handoff missing"))?;
+    if designer.operations.len() + operations.len() > 300 {
+        return Err(designer_bad("operation limit exceeded"));
+    }
+    if !designer_native_matches(&designer, ds.doc.as_ref()) {
+        return Err(designer_bad("unsupported native change"));
+    }
+    for operation in operations {
+        apply_designer_operation(&mut designer, operation)?;
+        designer.operations.push(operation.clone());
+    }
+    if !operations.is_empty() {
+        designer.redo_operations.clear();
+    }
+    let native = rebuild_designer_native(&mut designer)?;
+    ds.doc = std::sync::Arc::new(native);
+    ds.edm_designer = Some(designer);
+    Ok(json!({"operations": ds.edm_designer.as_ref().map_or(0, |designer| designer.operations.len())}))
+}
+
+fn designer_history(s: &mut Session, p: &Value, redo: bool) -> Result<Value> {
+    if !only_keys(p, &[]) {
+        return Err(designer_bad("invalid history parameters"));
+    }
+    let ds = s.ds_mut()?;
+    if ds.interaction.is_some() || ds.text_edit.is_some() {
+        return Err(designer_bad("editor busy"));
+    }
+    let mut designer = ds.edm_designer.clone().ok_or_else(|| designer_bad("designer handoff missing"))?;
+    if !designer_native_matches(&designer, ds.doc.as_ref()) {
+        return Err(designer_bad("unsupported native change"));
+    }
+    let operation = if redo {
+        designer.redo_operations.pop()
+    } else {
+        designer.operations.pop().map(|operation| {
+            designer.redo_operations.push(operation.clone());
+            operation
+        })
+    };
+    let Some(operation) = operation else {
+        return Ok(json!({"operations": designer.operations.len(), "redoOperations": designer.redo_operations.len()}));
+    };
+    if redo {
+        designer.operations.push(operation);
+    }
+    let native = replay_designer(&mut designer)?;
+    ds.doc = std::sync::Arc::new(native);
+    let operations = designer.operations.len();
+    let redo_operations = designer.redo_operations.len();
+    ds.edm_designer = Some(designer);
+    Ok(json!({"operations": operations, "redoOperations": redo_operations}))
+}
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        spec!("edm_import", "Import XeroFlow email", "{design, images?}", false, |s, p| import(s, p)),
+        spec!("edm_snapshot", "Snapshot XeroFlow email", "{images?}", true, |s, p| snapshot(s, p)),
+        spec!("edm_designer_import", "Import XeroFlow email designer", "{design, images, operationId, capabilities}", false, |s, p| designer_import(
+            s, p
+        )),
+        spec!("edm_designer_apply", "Apply bounded email designer operations", "{operations}", false, |s, p| designer_apply(s, p)),
+        spec!("edm_designer_context", "Read canonical email selection and operation context", "{}", false, |s, _| designer_context(s)),
+        spec!("edm_designer_snapshot", "Snapshot XeroFlow email designer operations", "{}", false, |s, _| designer_snapshot(s)),
+        spec!("edm_designer_undo", "Undo canonical email designer operation", "{}", false, |s, p| designer_history(s, p, false)),
+        spec!("edm_designer_redo", "Redo canonical email designer operation", "{}", false, |s, p| designer_history(s, p, true)),
+    ]
+}
