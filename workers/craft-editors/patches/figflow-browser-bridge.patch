+//! Browser-local Promise transport. It does not grant remote, tenant or project authority.
+use figcraft_engine::Session;
+use figcraft_ui_egui::browser_bridge::{Bridge, MAX_EDM_REQUEST_BYTES};
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use wasm_bindgen::{JsValue, closure::Closure};
+
+const MAX_QUEUE: usize = 8;
+const MAX_WAIT_MS: f64 = 2_000.;
+struct Pending {
+    input: String,
+    resolve: js_sys::Function,
+    deadline: f64,
+}
+struct State {
+    bridge: Bridge,
+    queue: VecDeque<Pending>,
+    ctx: egui::Context,
+}
+thread_local! { static STATE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+fn reply(code: &str) -> String {
+    format!(r#"{{"ok":false,"error":{{"code":"{code}"}}}}"#)
+}
+fn now() -> f64 {
+    web_sys::window().and_then(|w| w.performance()).map(|p| p.now()).unwrap_or(0.)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn xeroflow_fig_request(input: String) -> js_sys::Promise {
+    js_sys::Promise::new(&mut move |resolve, _reject| {
+        STATE.with(|slot| {
+            let mut state = slot.borrow_mut();
+            let refusal = if input.len() > MAX_EDM_REQUEST_BYTES {
+                Some("request_too_large")
+            } else if state.as_ref().is_none_or(|s| s.queue.len() >= MAX_QUEUE) {
+                Some("bridge_busy")
+            } else {
+                None
+            };
+            if let Some(code) = refusal {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&reply(code)));
+                return;
+            }
+            if let Some(state) = state.as_mut() {
+                state.queue.push_back(Pending { input: input.clone(), resolve, deadline: now() + MAX_WAIT_MS });
+                state.ctx.request_repaint();
+            }
+        });
+    })
+}
+/// Called once after the real editor exists. A random instance dies with this page generation.
+pub fn install(ctx: egui::Context) -> Result<(), JsValue> {
+    let window = web_sys::window().ok_or_else(|| JsValue::from_str("no window"))?;
+    if window.performance().is_none() {
+        return Err(JsValue::from_str("monotonic clock unavailable"));
+    }
+    let mut bytes = [0u8; 16];
+    window.crypto()?.get_random_values_with_u8_array(&mut bytes)?;
+    let instance: String = bytes.iter().map(|b| format!("{b:02x}")).collect();
+    STATE.with(|slot| {
+        *slot.borrow_mut() = Some(State { bridge: Bridge::new(instance), queue: VecDeque::new(), ctx });
+    });
+    let request = Closure::<dyn FnMut(String) -> js_sys::Promise>::new(xeroflow_fig_request);
+    let api = js_sys::Object::new();
+    js_sys::Reflect::set(&api, &JsValue::from_str("protocolVersion"), &JsValue::from_str("1"))?;
+    js_sys::Reflect::set(&api, &JsValue::from_str("request"), request.as_ref())?;
+    // The closure is owned by the page-global object for this browser generation.
+    request.forget();
+    js_sys::Object::freeze(&api);
+    js_sys::Reflect::set(window.as_ref(), &JsValue::from_str("__xfFigBridge"), &api)?;
+    Ok(())
+}
+/// Runs only at the frame boundary and never blocks the UI waiting for a socket or Promise.
+pub fn drain(session: &mut Session) {
+    for _ in 0..2 {
+        let pending = STATE.with(|slot| slot.borrow_mut().as_mut().and_then(|s| s.queue.pop_front()));
+        let Some(pending) = pending else {
+            break;
+        };
+        let response = if now() > pending.deadline {
+            reply("request_expired_not_applied")
+        } else {
+            STATE.with(|slot| {
+                slot.borrow_mut().as_mut().map(|s| s.bridge.execute(session, &pending.input)).unwrap_or_else(|| reply("bridge_unavailable"))
+            })
+        };
+        let _ = pending.resolve.call1(&JsValue::NULL, &JsValue::from_str(&response));
+    }
+    STATE.with(|slot| {
+        if let Some(state) = slot.borrow().as_ref() {
+            if !state.queue.is_empty() {
+                state.ctx.request_repaint();
+            }
+        }
+    });
+}
