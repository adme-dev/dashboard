+#[test]
+fn browser_export_bound_counts_all_files_and_accepts_the_exact_total() {
+    let mut s = Session::new();
+    let r = rect(&mut s, 0.0, 0.0, 32.0, 24.0, "#FF0000", None);
+    for suffix in ["-first", "-second"] {
+        ex(&mut s, "export.add", json!({"ids": [r], "setting": {"format": "svg", "suffix": suffix}}));
+    }
+    let unbounded = ex(&mut s, "file.exportLayers", json!({"ids": [r]}));
+    let files = unbounded["files"].as_array().unwrap();
+    assert_eq!(files.len(), 2);
+    let sizes: Vec<u64> = files.iter().map(|f| f["bytes"].as_u64().unwrap()).collect();
+    let total: u64 = sizes.iter().sum();
+    assert!(sizes.iter().all(|n| *n < total - 1), "each file fits by itself, but their total does not");
+    let exact = ex(&mut s, "file.exportLayers", json!({"ids": [r], "maxBytes": total}));
+    assert_eq!(exact, unbounded, "a bounded export preserves every output byte and name");
+    let error = s.execute("file.exportLayers", &json!({"ids": [r], "maxBytes": total - 1})).unwrap_err().to_string();
+    assert!(error.contains("export exceeds maxBytes"), "{error}");
+    // Refusal leaves the document and its export settings intact, so retrying with room succeeds.
+    assert_eq!(ex(&mut s, "file.exportLayers", json!({"ids": [r], "maxBytes": total})), unbounded);
+}
+
+#[test]
+fn browser_export_bound_rejects_invalid_limits_and_never_bounds_directory_writes() {
+    let mut s = Session::new();
+    let r = rect(&mut s, 0.0, 0.0, 16.0, 16.0, "#000000", None);
+    ex(&mut s, "export.add", json!({"ids": [r], "setting": {"format": "svg"}}));
+    for limit in [json!(0), json!(-1), json!(1.5), json!("1024"), Value::Null, json!(536_870_913u64)] {
+        let error = s.execute("file.exportLayers", &json!({"ids": [r], "maxBytes": limit})).unwrap_err().to_string();
+        assert!(error.contains("maxBytes must be a positive integer"), "{limit}: {error}");
+    }
+    let dir = std::env::temp_dir().join(format!("figcraft-export-bound-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let error = s.execute("file.exportLayers", &json!({"ids": [r], "dir": dir.to_string_lossy(), "maxBytes": 1})).unwrap_err().to_string();
+    assert!(error.contains("maxBytes applies only to in-memory output"), "{error}");
+    assert!(!dir.exists(), "invalid bounded directory requests do not write partial files");
+    let written = ex(&mut s, "file.exportLayers", json!({"ids": [r], "dir": dir.to_string_lossy()}));
+    let path = written["files"][0]["path"].as_str().unwrap();
+    assert!(std::path::Path::new(path).is_file(), "the existing unbounded desktop export still writes files");
+    let _ = std::fs::remove_dir_all(&dir);
+}
