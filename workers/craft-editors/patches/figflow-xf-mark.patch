+const XF_INK: Color32 = Color32::from_rgb(0x12, 0x13, 0x17);
+
+/// The XeroFlow mark, centred in `rect`: "XF" in near-black semibold letters on a white rounded
+/// square, in the XeroFlow site's proportions (a 36 px square has 8 px corners and 14 px letters);
+/// the letters stay at least 10 px, so the mark reads at the 24 px of the editor's corner button.
+/// A faint edge keeps the square visible on light themes.
+pub fn paint_xf_mark(painter: &egui::Painter, rect: egui::Rect) {
+    let side = rect.width().min(rect.height());
+    let square = egui::Rect::from_center_size(rect.center(), egui::vec2(side, side));
+    let corner = egui::CornerRadius::same((side * 8.0 / 36.0).round().clamp(2.0, 255.0) as u8);
+    painter.rect_filled(square, corner, Color32::WHITE);
+    painter.rect_stroke(square, corner, egui::Stroke::new(1.0, Color32::from_black_alpha(28)), egui::StrokeKind::Inside);
+    painter.text(square.center(), egui::Align2::CENTER_CENTER, "XF", semibold((side * 0.4).max(10.0)), XF_INK);
+}
