diff -ruN a/crates/ui-egui/src/xf_mark_tests.rs b/crates/ui-egui/src/xf_mark_tests.rs
--- a/crates/ui-egui/src/xf_mark_tests.rs	1970-01-01 10:00:00
+++ b/crates/ui-egui/src/xf_mark_tests.rs	2026-10-28 11:52:54
@@ -0,0 +1,60 @@
+//! The XeroFlow mark in the editor's top-left corner (the main menu button) and beside the
+//! "XeroFlow" wordmark in the home sidebar: "XF" in near-black letters on a white rounded square,
+//! drawn in code at a legible size.
+
+use egui::{Color32, Pos2, Rect, Shape};
+use figcraft_engine::Session;
+
+use crate::layers_drag_tests::Ui;
+use crate::live_tests::{flat, texts};
+
+/// Everything one settled frame paints.
+fn painted(u: &mut Ui) -> Vec<Shape> {
+    u.frame(vec![]);
+    flat(&u.frame_output(vec![]).shapes)
+}
+
+/// The "XF" letters painted within `area`: their colour and on-screen height.
+fn marks_in(shapes: &[Shape], area: Rect) -> Vec<(Color32, f32)> {
+    shapes
+        .iter()
+        .filter_map(|s| match s {
+            Shape::Text(t) if t.galley.text() == "XF" && area.contains(t.pos) => Some((t.fallback_color, t.galley.size().y)),
+            _ => None,
+        })
+        .collect()
+}
+
+/// A white rounded square painted within `area`.
+fn white_square_in(shapes: &[Shape], area: Rect) -> bool {
+    shapes.iter().any(|s| matches!(s, Shape::Rect(r) if r.fill == Color32::WHITE && area.contains_rect(r.rect) && r.corner_radius.nw > 0))
+}
+
+#[test]
+fn the_editor_corner_shows_the_xf_mark() {
+    let mut u = Ui::new(Session::new());
+    u.app.ui.home = false;
+    let s = painted(&mut u);
+    // The rail's first button, under the title bar where there is one.
+    let corner = Rect::from_min_max(Pos2::ZERO, Pos2::new(64.0, 140.0));
+    let marks = marks_in(&s, corner);
+    let [(ink, height)] = marks.as_slice() else { panic!("one XF mark in the corner, got {marks:?}") };
+    assert_eq!(*ink, Color32::from_rgb(0x12, 0x13, 0x17), "near-black letters");
+    assert!(*height >= 10.0, "legible at the corner button ({height} px)");
+    assert!(white_square_in(&s, corner), "on a white rounded square");
+}
+
+#[test]
+fn the_home_sidebar_shows_the_mark_and_the_xeroflow_wordmark() {
+    let mut s = Session::empty();
+    s.prefs.getting_started_dismissed = true;
+    let mut u = Ui::new(s);
+    u.app.ui.home = true;
+    let shapes = painted(&mut u);
+    let sidebar = Rect::from_min_max(Pos2::ZERO, Pos2::new(240.0, 120.0));
+    assert_eq!(marks_in(&shapes, sidebar).len(), 1, "the XF mark tops the sidebar");
+    assert!(white_square_in(&shapes, sidebar));
+    let words: Vec<String> = texts(&shapes).into_iter().filter(|(_, p, _)| sidebar.contains(*p)).map(|(t, _, _)| t).collect();
+    assert!(words.iter().any(|w| w == "XeroFlow"), "the wordmark reads XeroFlow: {words:?}");
+    assert!(!words.iter().any(|w| w == "Fig" || w == "Flow"), "no two-tone app wordmark: {words:?}");
+}
