+    #[test]
+    fn zip_files_keeps_each_file_under_its_name_and_refuses_repeats() {
+        use std::io::Read as _;
+        let svg = b"<svg xmlns=\"http://www.w3.org/2000/svg\"/>".repeat(40);
+        let png = png();
+        let zip = zip_files([("Icons/Star.svg", svg.as_slice()), ("Star@2x.png", png.as_slice())]).unwrap();
+        let mut z = zip::ZipArchive::new(std::io::Cursor::new(zip)).unwrap();
+        assert_eq!(z.len(), 2);
+        let mut read = |name: &str| {
+            let mut f = z.by_name(name).unwrap();
+            let method = f.compression();
+            let mut out = Vec::new();
+            f.read_to_end(&mut out).unwrap();
+            (out, method)
+        };
+        assert_eq!(read("Icons/Star.svg"), (svg.clone(), zip::CompressionMethod::Deflated));
+        assert_eq!(read("Star@2x.png"), (png.clone(), zip::CompressionMethod::Stored), "compressed images are stored as they are");
+        assert!(zip_files([("a.png", png.as_slice()), ("a.png", png.as_slice())]).is_err());
     }
 
