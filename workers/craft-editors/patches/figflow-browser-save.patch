diff -ruN a/crates/ui-egui/src/browser_save_tests.rs b/crates/ui-egui/src/browser_save_tests.rs
--- a/crates/ui-egui/src/browser_save_tests.rs	1970-01-01 10:00:00
+++ b/crates/ui-egui/src/browser_save_tests.rs	2026-10-28 11:47:05
@@ -0,0 +1,212 @@
+//! Save, Save as and export where the platform saves by downloads (the browser, which has no file
+//! system or save dialogs): each one arrives as a download of what the desktop app would write,
+//! instead of doing nothing.
+
+use std::sync::{Arc, Mutex};
+
+use figcraft_doc::{ExportFormat, ExportSetting, NodeId};
+use figcraft_engine::Session;
+use serde_json::json;
+
+use crate::export_panel::{export_layers, save_one};
+use crate::present_tests::id;
+use crate::{FigApp, Services, menus};
+
+type Downloads = Arc<Mutex<Vec<(String, Vec<u8>)>>>;
+
+/// Services that save by downloads and keep them (`deliver` false: the browser refused).
+struct Browser {
+    got: Downloads,
+    deliver: bool,
+}
+
+impl Services for Browser {
+    fn downloads(&self) -> bool {
+        true
+    }
+    fn download(&mut self, name: &str, bytes: &[u8]) -> bool {
+        self.got.lock().unwrap().push((name.to_string(), bytes.to_vec()));
+        self.deliver
+    }
+}
+
+/// Services with save dialogs that are cancelled, counting any download asked of them.
+struct Desktop(Downloads);
+
+impl Services for Desktop {
+    fn download(&mut self, name: &str, bytes: &[u8]) -> bool {
+        self.0.lock().unwrap().push((name.to_string(), bytes.to_vec()));
+        true
+    }
+}
+
+/// A file called "Prototype" with a frame holding a rectangle; the frame's id.
+fn session() -> (Session, NodeId) {
+    let mut s = Session::new();
+    s.doc_mut().unwrap().name = "Prototype".into();
+    let frame = id(&s.execute("frame.create", &json!({"x": 0, "y": 0, "width": 200, "height": 120})).unwrap());
+    s.execute("shape.rectangle", &json!({"x": 20, "y": 20, "width": 100, "height": 80, "parent": frame})).unwrap();
+    (s, frame)
+}
+
+fn browser(deliver: bool) -> (FigApp, NodeId, Downloads) {
+    let (s, frame) = session();
+    let got = Downloads::default();
+    (FigApp::new(s, Box::new(Browser { got: got.clone(), deliver })), frame, got)
+}
+
+fn toast(app: &FigApp) -> String {
+    app.ui.toast.as_ref().map(|t| t.0.clone()).unwrap_or_default()
+}
+
+fn one(got: &Downloads) -> (String, Vec<u8>) {
+    let got = got.lock().unwrap();
+    let [d] = got.as_slice() else { panic!("one download, got {}", got.len()) };
+    d.clone()
+}
+
+fn dirty(app: &FigApp) -> bool {
+    app.session.ds().unwrap().is_dirty()
+}
+
+#[test]
+fn save_downloads_the_native_file_and_counts_as_saved() {
+    let (mut app, _, got) = browser(true);
+    assert!(dirty(&app));
+    menus::invoke(&mut app, "file.save");
+    let (name, bytes) = one(&got);
+    assert_eq!(name, "Prototype.figcraft");
+    // The .figcraft file the desktop app writes: it opens again with the same layers.
+    let (doc, _) = figcraft_format::load_bytes(&bytes).unwrap();
+    let ours = app.session.doc().unwrap();
+    assert_eq!(doc.name, "Prototype");
+    assert_eq!(doc.nodes().count(), ours.nodes().count());
+    assert!(!dirty(&app), "a delivered download saves the file");
+    assert!(app.session.ds().unwrap().path.is_none(), "no path is made up for it");
+    assert_eq!(toast(&app), "Saved Prototype.figcraft");
+    assert!(app.pending_dialog.is_none());
+}
+
+#[test]
+fn save_as_and_a_second_save_download_again() {
+    let (mut app, _, got) = browser(true);
+    menus::invoke(&mut app, "file.saveAs");
+    app.session.execute("shape.ellipse", &json!({"x": 300, "y": 0, "width": 40, "height": 40})).unwrap();
+    assert!(dirty(&app), "edits after the download are unsaved");
+    menus::invoke(&mut app, "file.save");
+    let got = got.lock().unwrap();
+    assert_eq!(got.len(), 2);
+    assert!(got.iter().all(|(n, _)| n == "Prototype.figcraft"));
+    let (later, _) = figcraft_format::load_bytes(&got[1].1).unwrap();
+    let (first, _) = figcraft_format::load_bytes(&got[0].1).unwrap();
+    assert_eq!(later.nodes().count(), first.nodes().count() + 1, "the second download has the new layer");
+    drop(got);
+    assert!(!dirty(&app));
+}
+
+#[test]
+fn a_refused_download_leaves_the_file_unsaved_and_says_so() {
+    let (mut app, _, got) = browser(false);
+    menus::invoke(&mut app, "file.save");
+    assert_eq!(got.lock().unwrap().len(), 1);
+    assert!(dirty(&app), "nothing was delivered: the changes are still unsaved");
+    assert_eq!(toast(&app), "Couldn't download Prototype.figcraft");
+}
+
+#[test]
+fn a_version_preview_ends_before_saving_as_on_the_desktop() {
+    let (mut app, _, got) = browser(true);
+    app.session.execute("file.saveVersion", &json!({"name": "Before"})).unwrap();
+    app.session.execute("shape.ellipse", &json!({"x": 300, "y": 0, "width": 40, "height": 40})).unwrap();
+    let with_ellipse = app.session.doc().unwrap().nodes().count();
+    app.session.execute("version.preview", &json!({"index": 0})).unwrap();
+    assert!(app.session.ds().unwrap().preview.is_some());
+    menus::invoke(&mut app, "file.save");
+    let (_, bytes) = one(&got);
+    let (doc, _) = figcraft_format::load_bytes(&bytes).unwrap();
+    assert_eq!(doc.nodes().count(), with_ellipse, "the file itself is saved, not the version shown");
+    assert!(app.session.ds().unwrap().preview.is_none());
+}
+
+#[test]
+fn export_page_as_png_downloads_the_png() {
+    let (mut app, _, got) = browser(true);
+    let doc = app.session.doc().unwrap().clone();
+    let page = app.session.page().unwrap();
+    // What the page's "Export page as PNG" button does.
+    let all = doc.node(page).unwrap().children.clone();
+    let page_name = doc.node(page).unwrap().name.clone();
+    save_one(&mut app, &all, &ExportSetting::default(), &format!("{page_name}.png"));
+    let (name, bytes) = one(&got);
+    assert_eq!(name, format!("{page_name}.png"));
+    assert!(bytes.starts_with(b"\x89PNG\r\n\x1a\n"), "a PNG");
+    assert_eq!(toast(&app), format!("Exported {page_name}.png"));
+    assert!(dirty(&app), "an export doesn't save the file");
+}
+
+#[test]
+fn svg_and_pdf_exports_download_their_files() {
+    for format in [ExportFormat::Svg, ExportFormat::Pdf] {
+        let (mut app, frame, got) = browser(true);
+        let setting = ExportSetting { format, ..Default::default() };
+        save_one(&mut app, &[frame], &setting, &format!("Frame.{}", format.ext()));
+        let (name, bytes) = one(&got);
+        assert_eq!(name, format!("Frame.{}", format.ext()));
+        let text = String::from_utf8_lossy(&bytes);
+        let kind = if format == ExportFormat::Svg { text.trim_start().starts_with('<') && text.contains("<svg") } else { bytes.starts_with(b"%PDF") };
+        assert!(kind, "{format:?}: {}", text.chars().take(40).collect::<String>());
+        assert!(app.ui.last_error.is_none(), "{:?}", app.ui.last_error);
+    }
+}
+
+#[test]
+fn several_files_download_as_one_zip() {
+    let (mut app, frame, got) = browser(true);
+    let settings = [
+        ExportSetting::default(),
+        ExportSetting { format: ExportFormat::Svg, ..Default::default() },
+        ExportSetting { format: ExportFormat::Pdf, ..Default::default() },
+    ];
+    app.session.execute("node.set", &json!({"ids": [frame], "props": {"exports": settings}})).unwrap();
+    let jobs = figcraft_engine::cmd::file::export_jobs(app.session.doc().unwrap(), &[frame]);
+    assert_eq!(jobs.len(), 3);
+    export_layers(&mut app, &[frame], false);
+    let (name, bytes) = one(&got);
+    assert_eq!(name, "Prototype.zip");
+    assert!(bytes.starts_with(b"PK\x03\x04"), "a zip archive");
+    // Each member's name is in its local header.
+    for j in &jobs {
+        assert!(bytes.windows(j.file.len()).any(|w| w == j.file.as_bytes()), "{} is in the archive", j.file);
+    }
+    assert_eq!(toast(&app), "Exported Prototype.zip");
+}
+
+#[test]
+fn frames_pdf_and_fig_export_download() {
+    let (mut app, _, got) = browser(true);
+    menus::invoke(&mut app, "file.exportFramesPdf");
+    crate::dialogs::save_fig(&mut app, "Prototype");
+    let got = got.lock().unwrap();
+    let [(pdf_name, pdf), (fig_name, fig)] = got.as_slice() else { panic!("two downloads, got {}", got.len()) };
+    assert_eq!(pdf_name, "Prototype.pdf");
+    assert!(pdf.starts_with(b"%PDF"));
+    assert_eq!(fig_name, "Prototype.fig");
+    assert!(fig.starts_with(b"fig-kiwi") || fig.starts_with(b"PK"), "a .fig file");
+    drop(got);
+    assert!(toast(&app).starts_with("Exported Prototype.fig"), "{}", toast(&app));
+    assert!(dirty(&app), "a .fig copy is an export, not a save");
+}
