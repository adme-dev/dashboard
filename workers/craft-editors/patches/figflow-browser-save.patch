+/// Several exported files as one `.zip` archive, each member under its name (a `/` makes a folder),
+/// for platforms that hand files over one at a time (a browser download) instead of writing them
+/// into a folder. Raster images are stored as they are (they are compressed already); anything else
+/// is deflated. A repeated name is refused.
+pub fn zip_files<'a>(files: impl IntoIterator<Item = (&'a str, &'a [u8])>) -> Result<Vec<u8>, FormatError> {
+    let mut buf = std::io::Cursor::new(Vec::new());
+    {
+        let mut z = zip::ZipWriter::new(&mut buf);
+        let stored = zip::write::SimpleFileOptions::default().compression_method(zip::CompressionMethod::Stored);
+        let deflated = zip::write::SimpleFileOptions::default().compression_method(zip::CompressionMethod::Deflated);
+        let mut names = BTreeSet::new();
+        for (name, bytes) in files {
+            if !names.insert(name) {
+                return Err(FormatError::Io(format!("`{name}` is in the archive twice")));
+            }
+            let ext = name.rsplit_once('.').map(|(_, e)| e.to_ascii_lowercase()).unwrap_or_default();
+            let opts = if matches!(ext.as_str(), "png" | "jpg" | "jpeg" | "webp" | "gif") { stored } else { deflated };
+            put(&mut z, name, opts, bytes)?;
+        }
+        z.finish().map_err(io_err)?;
+    }
+    Ok(buf.into_inner())
+}
