+#[test]
+fn platforms_with_save_dialogs_keep_them() {
+    let (s, frame) = session();
+    let got = Downloads::default();
+    let mut app = FigApp::new(s, Box::new(Desktop(got.clone())));
+    menus::invoke(&mut app, "file.save");
+    assert!(app.pending_dialog.is_some(), "Save asks where with the platform's dialog");
+    app.pending_dialog = None;
+    save_one(&mut app, &[frame], &ExportSetting::default(), "Frame.png");
+    assert!(app.pending_dialog.is_some(), "Export asks where with the platform's dialog");
+    assert!(got.lock().unwrap().is_empty(), "nothing is downloaded");
+    assert!(dirty(&app));
+}
