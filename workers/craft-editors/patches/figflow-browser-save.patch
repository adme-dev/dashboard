+
+/// Save where there is no file system (the browser hands files over as downloads): the file of the
+/// active tab (the main file for a branch tab, with its branches), encoded in memory exactly as
+/// `file.save` writes it, and the file name to deliver it under. As before a native save, a live
+/// text or version preview ends first. Nothing is marked saved yet: once the bytes were handed
+/// over, [`FileSnapshot::delivered`] does that, so a download that never happened leaves the file
+/// unsaved.
+pub fn save_in_memory(s: &mut Session) -> Result<(FileSnapshot, String, Vec<u8>)> {
+    crate::branches::sync(s);
+    crate::textpreview::end(s);
+    s.ds_mut()?.end_preview();
+    let ds = s.docs.get(crate::branches::file_tab(s)).ok_or(EngineError::NoDocument)?;
+    let snapshot = FileSnapshot::of(ds);
+    let bytes = snapshot.encode()?;
+    let stem = safe_file_name(snapshot.doc.name.trim());
+    let name = format!("{}.figcraft", if stem.is_empty() { "Untitled" } else { stem.as_str() });
+    Ok((snapshot, name, bytes))
 }
 
