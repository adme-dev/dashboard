  "runtime": {
    "assets": {
      "headers": {
        "version": 2,
        "rules": {
          "/*": {
            "set": {
              "cache-control": "no-cache",
              "content-security-policy": "frame-ancestors 'self' https://app.xeroflow.io",
              "referrer-policy": "strict-origin-when-cross-origin",
              "x-content-type-options": "nosniff"
            },
            "unset": []
          }
        }
      },
      "raw_headers": "/*\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: strict-origin-when-cross-origin\n  Cache-Control: no-cache\n  Content-Security-Policy: frame-ancestors 'self' https://app.xeroflow.io\n",
      "serve_directly": false,
      "raw_run_worker_first": true,
      "base_path": "/"
    },
    "compatibility_date": "2026-10-27",
    "compatibility_flags": [
      "global_fetch_strictly_public"
    ],
    "usage_model": "standard"
  },
  "bindings": [
    {
      "name": "ASSETS",
      "type": "assets"
    },
    {
      "name": "CREATIVE_AUTH_KEY",
      "type": "secret_text"
    },
    {
      "environment": "production",
      "name": "FIGFLOW_EDM_ASSETS",
      "service": "xeroflow-figflow-edm-assets",
      "type": "service"
    },
    {
      "name": "MOTORSTACK_API_KEY",
      "type": "secret_text"
    }
  ]
