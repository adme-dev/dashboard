{
  "name": "nuxt-ui-template-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm zero:dev\"",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "zero:dev": "npx @rocicorp/zero-cache serve",
    "db:setup": "psql $DATABASE_URL -f server/database/schema.sql",
    "db:seed": "psql $DATABASE_URL -f server/database/seed-coa.sql",
    "db:zero": "psql $DATABASE_URL -f server/database/setup-zero-replication.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@iconify-json/lucide": "^1.2.68",
    "@iconify-json/simple-icons": "^1.2.52",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "@rocicorp/zero": "^0.18.0",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "@vueuse/nuxt": "^13.9.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "groq-sdk": "^0.32.0",
    "nuxt": "^4.2.2",
    "ofetch": "^1.4.1",
    "pg": "^8.13.0",
    "resend": "^6.6.0",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "xero-node": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.0.11",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.0.7"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
