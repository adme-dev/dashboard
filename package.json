{
  "name": "nuxt-ui-template-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=16384' nuxt build && node scripts/wrap-worker.mjs && node scripts/check-worker-size.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=16384' nuxt dev",
    "graphify:rebuild": "sh scripts/regenerate-graphify.sh",
    "graphify:upload": "node --env-file=.env scripts/upload-graphify.mjs graphify-out",
    "dev:wrangler": "npx wrangler pages dev -- npm run dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm zero:dev\"",
    "preview": "nuxt preview",
    "preview:pages": "wrangler --cwd dist pages dev --compatibility-date 2024-12-01 --compatibility-flag nodejs_compat --compatibility-flag no_handle_cross_request_promise_resolution",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' nuxt typecheck",
    "deploy": "node scripts/deploy-pages.mjs preview",
    "deploy:preview": "node scripts/deploy-pages.mjs preview",
    "deploy:production": "node scripts/deploy-pages.mjs main",
    "deploy:check": "node scripts/deploy-pages.mjs main --check-only",
    "crm-search:release:production": "node scripts/deploy-pages.mjs main --crm-search-release",
    "crm-search:bindings:check": "node scripts/crm-search/preview-binding-guard.mjs --dry-run",
    "crm-search:preview:isolate": "node scripts/crm-search/pages-preview-isolation-adapter.mjs --dry-run",
    "crm-search:preview:bind": "node scripts/crm-search/pages-preview-isolation-adapter.mjs --bind-crm --dry-run",
    "crm-search:artifact:build": "node scripts/crm-search/build-artifact.mjs --dry-run",
    "crm-search:artifact:produce": "node scripts/crm-search/build-artifact.mjs --build",
    "crm-search:artifact:verify": "node scripts/crm-search/verify-artifact.mjs --dry-run",
    "crm-search:consumer:upload": "node scripts/crm-search/deploy-consumer-artifact.mjs --execute",
    "crm-search:migrate:test": "node scripts/crm-search/neon-lifecycle.mjs --dry-run",
    "crm-search:e2e:preview": "node scripts/crm-search/e2e-preview.mjs --dry-run",
    "crm-search:e2e:cleanup": "node scripts/crm-search/e2e-cleanup.mjs --dry-run",
    "crm-search:evidence": "node scripts/crm-search/evidence-bundle.mjs --dry-run",
    "deploy:worker:staging": "node scripts/deploy-worker-staging.mjs",
    "deploy:worker:staging:check": "node scripts/deploy-worker-staging.mjs --check-only",
    "deploy:workflows": "pnpm --dir workers/agency-workflows run deploy",
    "deploy:workflows:dry-run": "pnpm --dir workers/agency-workflows run deploy:dry-run",
    "deploy:google-pmax-provider": "pnpm --dir workers/google-pmax-provider run deploy",
    "deploy:google-pmax-provider:dry-run": "pnpm --dir workers/google-pmax-provider run deploy:dry-run",
    "deploy:page-studio-control:dry-run": "pnpm --dir workers/page-studio-control run deploy:dry-run",
    "deploy:page-studio-control:production": "pnpm --dir workers/page-studio-control run deploy:production",
    "deploy:page-studio-control:production:dry-run": "pnpm --dir workers/page-studio-control run deploy:production:dry-run",
    "deploy:page-studio-control:staging": "pnpm --dir workers/page-studio-control run deploy:staging",
    "deploy:page-studio-control:staging:dry-run": "pnpm --dir workers/page-studio-control run deploy:staging:dry-run",
    "deploy:workers": "node scripts/deploy-workers.mjs",
    "deploy:search-authority-publisher": "node scripts/deploy-search-authority-publisher.mjs",
    "deploy:search-authority-publisher:dry-run": "node scripts/deploy-search-authority-publisher.mjs --dry-run",
    "test": "vitest",
    "test:measurement-db-smoke": "vitest run test/integration/measurementOnboarding.database.test.ts",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:deployment-guards": "vitest run test/config/pagesDeployGuard.test.ts test/config/prerenderIgnore.test.ts",
    "test:social-publishing": "vitest run test/social test/server/utils/socialPublishingNavCounts.test.ts test/server/api/publishingPlannerAgentEndpoint.test.ts test/app/publishingPlannerAgentPanel.test.ts test/ai/tools/scheduleSocialPost.test.ts test/ai/executors.test.ts test/config/agencyWorkflowsReadinessScript.test.ts test/config/agencyWorkflowsBindings.test.ts test/config/cloudflareHyperdriveBindings.test.ts",
    "pilot:lakebase:preflight": "tsx scripts/lakebase-pilot/preflight.ts --json",
    "pilot:lakebase:enable": "tsx scripts/lakebase-pilot/enable.ts --json",
    "pilot:lakebase:setup": "tsx scripts/lakebase-pilot/setup.ts --json",
    "pilot:lakebase:evaluate": "tsx scripts/lakebase-pilot/evaluate.ts",
    "pilot:lakebase:teardown": "tsx scripts/lakebase-pilot/teardown.ts --json",
    "readiness:agency-workflows": "node scripts/agency-workflows-readiness.mjs",
    "readiness:ai-assistants": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/ai-assistant-readiness.ts",
    "smoke:agency-workflows": "node scripts/agency-workflows-production-smoke.mjs",
    "smoke:agency-workflows:ci": "node scripts/agency-workflows-ci-smoke-gate.mjs",
    "smoke:social-publishing-theme": "node scripts/social-publishing-theme-smoke.mjs",
    "eval:ai:export": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/export-ai-tools.ts",
    "eval:ai": "promptfoo eval -c evals/ai-tools/promptfooconfig.yaml",
    "eval:ai:injection": "promptfoo eval -c evals/ai-tools/injection.yaml",
    "audit:inventory-feeds": "node --env-file=.env node_modules/tsx/dist/cli.mjs --tsconfig .nuxt/tsconfig.server.json scripts/audit-inventory-feeds.ts",
    "audit:google-ai-max": "node --env-file=.env node_modules/tsx/dist/cli.mjs --tsconfig .nuxt/tsconfig.server.json scripts/audit-google-ai-max-live.ts",
    "sync:monday-campaigns": "node --env-file=.env --import tsx scripts/reconcile-monday-campaign-jobs.ts",
    "reconcile:monday-campaign-performance": "node --env-file=.env node_modules/tsx/dist/cli.mjs --tsconfig .nuxt/tsconfig.server.json scripts/reconcile-monday-campaign-performance.ts",
    "zero:dev": "npx @rocicorp/zero-cache serve",
    "db:setup": "cd server/database && psql $DATABASE_URL -f schema.sql",
    "db:seed": "psql $DATABASE_URL -f server/database/seed-coa.sql",
    "db:zero": "psql $DATABASE_URL -f server/database/setup-zero-replication.sql",
    "env:setup": "./scripts/setup-env.sh",
    "env:setup:local": "./scripts/setup-local.sh",
    "env:secrets:list": "npx wrangler pages secret list",
    "env:secrets:list:prod": "npx wrangler pages secret list --env production",
    "env:secrets:put": "npx wrangler pages secret put",
    "env:dev": "npx wrangler pages dev -- npm run dev"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.96",
