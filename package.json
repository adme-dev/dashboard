{
  "name": "nuxt-ui-template-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=16384' nuxt build && node scripts/wrap-worker.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=16384' nuxt dev",
    "graphify:rebuild": "sh scripts/regenerate-graphify.sh",
    "graphify:upload": "node --env-file=.env scripts/upload-graphify.mjs graphify-out",
    "dev:wrangler": "npx wrangler pages dev -- npm run dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm zero:dev\"",
    "preview": "nuxt preview",
    "preview:pages": "wrangler --cwd dist pages dev --compatibility-date 2024-12-01 --compatibility-flag nodejs_compat --compatibility-flag no_handle_cross_request_promise_resolution",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' nuxt typecheck",
    "deploy": "pnpm build && wrangler --cwd dist pages deploy --project-name agency-dashboard --branch main --commit-dirty=true",
    "deploy:preview": "pnpm build && wrangler --cwd dist pages deploy --project-name agency-dashboard --branch preview --commit-dirty=true",
    "deploy:production": "pnpm build && wrangler --cwd dist pages deploy --project-name agency-dashboard --branch main --commit-dirty=true",
    "deploy:workflows": "pnpm --dir workers/agency-workflows run deploy",
    "deploy:workflows:dry-run": "pnpm --dir workers/agency-workflows run deploy:dry-run",
    "deploy:workers": "node scripts/deploy-workers.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:social-publishing": "vitest run test/social test/server/utils/socialPublishingNavCounts.test.ts test/server/api/publishingPlannerAgentEndpoint.test.ts test/app/publishingPlannerAgentPanel.test.ts test/ai/tools/scheduleSocialPost.test.ts test/ai/executors.test.ts",
    "readiness:agency-workflows": "node scripts/agency-workflows-readiness.mjs",
    "smoke:agency-workflows": "node scripts/agency-workflows-production-smoke.mjs",
    "smoke:social-publishing-theme": "node scripts/social-publishing-theme-smoke.mjs",
    "eval:ai:export": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/export-ai-tools.ts",
    "eval:ai": "promptfoo eval -c evals/ai-tools/promptfooconfig.yaml",
    "eval:ai:injection": "promptfoo eval -c evals/ai-tools/injection.yaml",
    "zero:dev": "npx @rocicorp/zero-cache serve",
    "db:setup": "cd server/database && psql $DATABASE_URL -f schema.sql",
    "db:seed": "psql $DATABASE_URL -f server/database/seed-coa.sql",
    "db:zero": "psql $DATABASE_URL -f server/database/setup-zero-replication.sql",
    "env:setup": "./scripts/setup-env.sh",
    "env:setup:local": "./scripts/setup-local.sh",
    "env:secrets:list": "npx wrangler pages secret list",
    "env:secrets:list:prod": "npx wrangler pages secret list --env production",
    "env:secrets:put": "npx wrangler pages secret put",
    "env:dev": "npx wrangler pages dev -- npm run dev"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/groq": "^3.0.39",
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@cloudflare/ai-chat": "^0.8.6",
    "@cloudflare/think": "^0.10.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@flyhub/email-block-avatar": "^0.0.6",
    "@flyhub/email-block-button": "^0.0.4",
    "@flyhub/email-block-columns-container": "^0.0.4",
    "@flyhub/email-block-container": "^0.0.3",
    "@flyhub/email-block-divider": "^0.0.3",
    "@flyhub/email-block-heading": "^0.0.2",
    "@flyhub/email-block-html": "^0.0.3",
    "@flyhub/email-block-image": "^0.0.4",
    "@flyhub/email-block-spacer": "^0.0.1",
    "@flyhub/email-block-text": "^0.0.3",
    "@flyhub/email-builder": "^0.0.6",
    "@flyhub/email-core": "^0.0.1",
    "@flyhub/email-document-core": "^0.0.2",
    "@iconify-json/lucide": "^1.2.92",
    "@iconify-json/simple-icons": "^1.2.71",
    "@internationalized/date": "^3.11.0",
    "@neondatabase/serverless": "^1.0.2",
    "@nuxt/ui": "^4.9.0",
    "@pushforge/builder": "^2.0.5",
    "@rocicorp/zero": "^0.18.0",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "@vueuse/nuxt": "^13.9.0",
    "agents": "^0.16.2",
    "ai": "^6.0.197",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "gifenc": "^1.0.3",
    "groq-sdk": "^0.32.0",
    "gsap": "^3.14.2",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "marked": "^17.0.3",
    "nuxt": "^4.3.1",
    "ofetch": "^1.4.1",
    "pg": "^8.20.0",
    "pngjs": "^7.0.0",
    "resend": "^6.6.0",
    "sortablejs": "^1.15.7",
    "standardized-audio-context": "^25.3.77",
    "wavesurfer.js": "^7.12.7",
    "workers-ai-provider": "^3.1.14",
    "xero-node": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@types/pg": "^8.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.0.11",
    "playwright": "1.60.0",
    "promptfoo": "^0.121.15",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.0.7",
    "wrangler": "^4.99.0"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
