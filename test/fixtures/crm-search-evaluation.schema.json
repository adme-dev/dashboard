{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeroflow.example/schemas/crm-search-evaluation-v1.json",
  "title": "Redacted CRM search evaluation bundle descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusSha256",
    "developmentSha256",
    "sealedJudgementSha256",
    "preregistrationSha256",
    "adjudicationSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "crm-search-evaluation-v1"
    },
    "corpusSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "developmentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sealedJudgementSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preregistrationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adjudicationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
