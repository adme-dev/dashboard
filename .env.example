# Xero OAuth Configuration
# Get these from https://developer.xero.com/myapps
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:3001/api/xero/callback

# Session Security
SESSION_SECRET=your_session_secret_here

# Database - Required for agency features
# Recommended: Neon (https://neon.tech) or Supabase
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Cache (optional for development, uses in-memory storage)
# CACHE_URL=redis://localhost:6379

# Zero Sync Server (for real-time data sync)
# Run `npx zero-cache` locally or deploy to your infrastructure
ZERO_SERVER_URL=http://localhost:4848

# Groq AI Configuration
# Get your free API key from https://groq.com
GROQ_API=your_groq_api_key_here

# Cloudflare AI Gateway (optional — provides caching, rate limiting, cost analytics for AI calls)
# Create at: Cloudflare Dashboard → AI → AI Gateway → Create Gateway
# Format: https://gateway.ai.cloudflare.com/v1/{account-id}/{gateway-name}
# The app normalizes Groq calls to /groq automatically.
# AI_GATEWAY_URL=
# Optional if the gateway has Cloudflare authenticated gateway enabled.
# AI_GATEWAY_AUTH_TOKEN=

# AI tool-calling (Slice 1) — gated agentic loop (OFF by default)
AI_TOOLS_ENABLED=false
AI_LOOP_MODEL=groq/openai/gpt-oss-120b
AI_LOOP_FALLBACK_MODEL=groq/openai/gpt-oss-20b
AI_LOOP_BUDGET_USD=0.25
# Prod escape hatch (optional): set AI_LOOP_MODEL=anthropic/claude-sonnet-4-6 (needs ANTHROPIC_API_KEY + AI_GATEWAY_URL)
# ANTHROPIC_API_KEY=
# Cloudflare Workers AI: the RUNTIME loop uses the `AI` binding (no key). These are ONLY for the
# external eval bake-off of @cf/ models (loop spec form: AI_LOOP_MODEL=workersai/@cf/meta/llama-3.3-70b-instruct-fp8-fast)
# CLOUDFLARE_ACCOUNT_ID=   # same value as R2_ACCOUNT_ID
# CLOUDFLARE_API_KEY=      # API token with Workers AI read access

# AI Model Ops / Orchestrator
# Required for `/admin/ai/model-ops` manual read checks and internal orchestrator endpoints.
# Use a high-entropy secret locally; in Cloudflare set the same secret on Pages and the
# ai-orchestrator-agent Worker (`wrangler secret put INTERNAL_API_KEY` in each project).
INTERNAL_API_KEY=your_internal_api_key_here

# Standalone Page Studio origin. The dashboard creates a fresh signed session
# and POSTs it to this origin whenever an editor is launched.
NUXT_PUBLIC_PAGE_STUDIO_EDITOR_URL=https://studio.xeroflow.io
# Optional until the standalone Worker is deployed. When set, Model Ops shows Worker readiness.
# AI_ORCHESTRATOR_WORKER_URL=https://ai-orchestrator-agent.your-subdomain.workers.dev

# Governed Cloudflare Think specialist turns (dormant by default).
# Enable only together with THINK_TURNS_ENABLED on the platform-agents Worker.
PLATFORM_AGENT_THINK_TURNS_ENABLED=false
# PLATFORM_AGENT_WORKER_URL=https://platform-agents.your-subdomain.workers.dev
# Separate 32+ character HMAC secret shared only by Pages and platform-agents.
# PLATFORM_AGENT_SCOPE_SIGNING_SECRET=replace_with_a_dedicated_high_entropy_secret

# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
APP_NAME=Agency Dashboard
APP_URL=http://localhost:3000

# Cloudflare R2 Storage (optional - for file uploads)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Without R2 configured, file uploads will use base64 encoding in database (not recommended for production)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=agency-files
# Optional: Custom domain for public file access (if bucket has public access enabled)
# R2_PUBLIC_URL=https://files.yourdomain.com

# Dashboard Send remains disabled until its staged rollout is approved.
SEND_ENABLED=false
NUXT_PUBLIC_SEND_ENABLED=false
SEND_WORKSPACE_UPLOAD_INTENT_TTL_SECONDS=900
SEND_WORKSPACE_MULTIPART_THRESHOLD_BYTES=104857600
SEND_WORKSPACE_MULTIPART_PART_SIZE_BYTES=16777216

# Restricted HR contract vault (required in production before contract uploads).
# Use a separate private bucket with no public/custom domain. In Cloudflare, a
# native HR_CONTRACTS_BUCKET binding may be used instead of these credentials.
HR_R2_ACCOUNT_ID=your_cloudflare_account_id
HR_R2_ACCESS_KEY_ID=your_private_hr_r2_access_key_id
HR_R2_SECRET_ACCESS_KEY=your_private_hr_r2_secret_access_key
HR_R2_BUCKET_NAME=agency-private-hr-contracts

# Monday.com API Configuration (for migration)
# Get your API token from Monday.com > Admin > API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_OAUTH_CLIENT_ID=your_monday_app_client_id
MONDAY_OAUTH_CLIENT_SECRET=your_monday_app_client_secret
MONDAY_OAUTH_APP_VERSION_ID=your_draft_app_version_id_optional
MONDAY_SIGNING_SECRET=your_monday_app_signing_secret

# Cron Job Security (for scheduled tasks like due date reminders)
CRON_SECRET=your_random_secret_here

# Cloudflare KV Cache (auto-configured via wrangler.toml binding)
# Create namespace: npx wrangler kv namespace create CACHE
# Local dev works without KV (falls back to DB-only)

# Cloudflare Queues (auto-configured via wrangler.toml binding)
# Create queue: npx wrangler queues create agency-jobs
# Create DLQ: npx wrangler queues create agency-jobs-dlq
# Local dev works without queues (falls back to inline execution)

# Web Push (VAPID) — generate with `npx @pushforge/builder vapid`.
# VAPID_PUBLIC_KEY is the base64url string the CLI prints under "Public Key".
# VAPID_PRIVATE_KEY is the JWK JSON object the CLI prints under "Private Key (JWK)" — paste as a single line.
# VAPID_SUBJECT must be a mailto: URL pointing to the operator/contact.
# Without these three, the push fan-out in createNotification is a no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Social Suite OAuth (Meta — D2) ---
# Meta app credentials (also used by ad-spend OAuth). Required to connect Facebook/Instagram pages.
META_APP_ID=
META_APP_SECRET=
# Public Facebook Login for Business configuration ID used by catalog OAuth.
META_LOGIN_CONFIG_ID=1740422843746070
# Webhook verification token (must match the value configured in the Meta app webhook). Used by the 2a inbox receiver.
META_WEBHOOK_VERIFY_TOKEN=
# Optional: dedicated secret for signing OAuth state (falls back to META_APP_SECRET).
SOCIAL_OAUTH_STATE_SECRET=
# Optional: override the OAuth redirect base (defaults to the request origin). e.g. https://app.example.com
SOCIAL_OAUTH_REDIRECT_BASE=

# ── Dealer Feeds Plugin ──
# Feature gate for the dealer inventory feed plugin (social-dashboard provider etc.).
DEALER_FEEDS_ENABLED=false
# Service-to-service HMAC secret for Social Dashboard REST client (set in CF Pages env + provider).
SOCIAL_DASHBOARD_SERVICE_SECRET=
# Optional Supabase JWT for current social-dashboard endpoints that still require user auth.
SOCIAL_DASHBOARD_ACCESS_TOKEN=
# Promote authenticated universal dealer-webhook leads into CRM people/opportunities.
# Keep false until the provider payload has been validated for the target dealer account.
CRM_LEAD_PROMOTION_ENABLED=false

# ── Ops Autopilot (Digital Advertising dept automation) — all DORMANT by default ──
# Activation is operator-gated; flip these per the activation runbook (recommended
# order C5 → C1 → C2). Each is read via process.env, so set them in the deploy env
# (Cloudflare Pages → Settings → Environment Variables) and redeploy.
#
# C5 brief gatekeeper — on submit, gate incomplete briefs (needs_info + comment +
# notify) and auto-assign complete ones. Lowest-risk slice; no email burst.
BRIEF_GATEKEEPER_ENABLED=false
# C2 monthly ad-report engine — render + email client paid-ads PDFs. No platform writes.
AD_REPORTS_ENABLED=false
# A.3 lifecycle guard kill switch — the guard is wired live into status changes but
# raises escalations ONLY when this is 'true'. MUST be off until the status-taxonomy
# migration introduces real gate transitions (otherwise it's inert on flat statuses).
LIFECYCLE_GUARD_ENABLED=false
# Escalation notification allowlist (gradual rollout, mirrors ANOMALY_NOTIFY_ALLOWLIST).
# When set, ONLY these comma-separated emails receive escalation notifications —
# essential before activating C1 pacing (its always-critical issues would otherwise
# email every AUTOMATION-role user on the first cron run). Unset/empty = full fan-out.
# e.g. OPS_AUTOPILOT_NOTIFY_ALLOWLIST=paul@adme.net.au
OPS_AUTOPILOT_NOTIFY_ALLOWLIST=
