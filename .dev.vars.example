# ============================================
# Local Development Environment Variables
# ============================================
# Copy this file to .dev.vars and fill in your actual values
# These are loaded by `wrangler pages dev` automatically
# DO NOT commit .dev.vars to git!

# ============================================
# Required Secrets
# ============================================

# Database (Neon PostgreSQL)
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/database?sslmode=require

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here

# ============================================
# Xero OAuth (Required for Xero integration)
# ============================================
# Get from: https://developer.xero.com/myapps
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret

# Google Tag Manager Management API OAuth
GTM_GOOGLE_CLIENT_ID=your-gtm-google-client-id
GTM_GOOGLE_CLIENT_SECRET=your-gtm-google-client-secret
GTM_GOOGLE_REDIRECT_URI=http://localhost:3000/api/agency/tracking/gtm/callback

# ============================================
# Email (Resend - Required for magic links)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# AI (Groq - Required for AI features)
# ============================================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
AI_GOVERNED_CATALOG_MODE=legacy

# XeroFlow Google Ads MCP control plane — keep dormant in local Wrangler unless testing deliberately.
GOOGLE_ADS_MCP_READ_ENABLED=false
GOOGLE_ADS_MCP_WRITE_ENABLED=false
GOOGLE_ADS_MCP_AUTOMATION_ENABLED=false
GOOGLE_ADS_MCP_DESTRUCTIVE_ENABLED=false

# ============================================
# Optional: Monday.com Integration
# ============================================
MONDAY_API_TOKEN=your_monday_api_token

# ============================================
# Optional: Cron Job Security
# ============================================
CRON_SECRET=your_random_cron_secret

# CRM search release/evaluation keys are deliberately distinct. Keep blank for
# ordinary local development; semantic/evaluation paths then fail closed.
CRM_SEARCH_RESOURCE_APPROVAL_VERIFICATION_KEYRING=
CRM_SEARCH_RESOURCE_MANIFEST_VERIFICATION_KEYRING=
CRM_SEARCH_RELEASE_APPROVAL_VERIFICATION_KEYRING=
CRM_SEARCH_ARTIFACT_VERIFICATION_KEYRING=
CRM_SEARCH_EVIDENCE_VERIFICATION_KEYRING=
CRM_SEARCH_RELEASE_APPROVAL_DATABASE_URL=
CRM_SEARCH_SEALED_HOLDOUT_KEYRING=

# Preview/local write-capable integrations stay disabled unless the signed
# environment manifest proves a distinct non-production target identity.
CRM_EMAIL_CONVERSATIONS_ENABLED=false
PERSONA_AUDIENCE_PROVIDER_WRITES_ENABLED=false
PERSONA_META_AUDIENCE_WRITES_ENABLED=false
PERSONA_GOOGLE_AUDIENCE_WRITES_ENABLED=false
MCP_GEN_TOOLS_ENABLED=false
MCP_BANNER_TOOLS_ENABLED=false

# ============================================
# Optional: Cloudflare R2 Storage
# ============================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Operator attestation only: uncomment after the matching Cloudflare AI Gateway
# spend rule exists. The Cloudflare rule, not these values, enforces the ceiling.
# AI_GATEWAY_SPEND_LIMIT_CONFIRMED="false"
# AI_GATEWAY_GENERATION_MONTHLY_LIMIT_USD="250"
